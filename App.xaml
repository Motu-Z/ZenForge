<Application x:Class="ZenForge.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 强调色（运行时由 ThemeService 动态改写其中的画刷） -->
                <ResourceDictionary Source="Themes/Accent.xaml"/>
                <!-- 调色板（ThemeService 在深/浅色之间整册替换） -->
                <ResourceDictionary Source="Themes/Palette.Dark.xaml"/>
                <!-- 控件样式 -->
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 系统画刷兜底：弹层 / 提示 / 右键菜单不再出现白底。
                 ThemeService.SwapPalette 会随主题改写这些键。 -->
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#252526"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#1E1E1E"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F0F0F0"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#00B4D8"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#101010"/>

            <!-- 全局默认字体 -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            </Style>

            <!-- ==================================================================
                 重要设计约定（勿破坏）
                 ==================================================================
                 WPF 的隐式样式（无 x:Key 的 Style）按 DefaultStyleKey 精确匹配后
                 直接替换，**不会**与 MergedDictionaries 中的同类型隐式样式合并。

                 因此本文件里**只允许出现完整样式**（含 Template 与配色）。
                 绝不能再写「只设一个 FocusVisualStyle 的空样式」——那会把
                 Themes/Controls.xaml 里完整的深色模板整个顶掉，导致控件回落到
                 系统默认的白底 + 浅蓝高亮 + 方框虚线。历史上三次「白块」事故
                 全部源于此。

                 禁用焦点虚线框的正确做法：
                   1) 在具名样式里加 <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                   2) 由 App.xaml.cs 的 DisableFocusVisuals() 在启动时遍历所有
                      资源字典，为每个 Control 派生类型的 Style 补上该 Setter。
                 ================================================================== -->

            <!-- ==================================================================
                 TextBox 深色样式（全局生效）
                 ==================================================================
                 背景 #1E1E1E / 文字 White / 边框 #3F3F46
                 悬停边框 #5A5A62，获得焦点边框青色 #00B4D8
                 文字垂直居中，光标与选区用强调色
                 ================================================================== -->
            <Style x:Key="AppTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource Input.Foreground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionOpacity" Value="0.35"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.BorderHover}"/>
                                </Trigger>
                                <!-- 获得焦点：青色边框 -->
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Disabled.Background}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                                </Trigger>
                                <Trigger Property="IsReadOnly" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Disabled.Background}"/>
                                </Trigger>

                                <!-- 内容超限提示。
                                     必须放在最后：模板里对 Bd 的 Setter 优先级高于控件自身的
                                     BorderBrush，而同一组 Trigger 中后声明的覆盖先声明的。
                                     值加 yf: 前缀，避免和将来任何 Tag 用途撞车。 -->
                                <Trigger Property="Tag" Value="yf:over">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource State.Danger}"/>
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}"/>

            <!-- ==================================================================
                 ComboBoxItem 深色样式（下拉列表项）
                 ==================================================================
                 默认白字；悬停 / 选中 = 青色底 + 黑字（屏蔽系统浅蓝）
                 ================================================================== -->
            <Style x:Key="AppComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource Input.Foreground}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Margin="2,1"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="#101010"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="#101010"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True"/>
                                        <Condition Property="IsHighlighted" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                    <Setter Property="Foreground" Value="#101010"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource AppComboBoxItemStyle}"/>

            <!-- ==================================================================
                 ComboBox 深色样式（主框 + 下拉 Popup）
                 ==================================================================
                 主框 #252526 / 白字 / 深灰边框；
                 Popup 背景 #252526、圆角 6px、带投影、最大高度 280
                 ================================================================== -->
            <Style x:Key="AppComboBoxStyle" TargetType="ComboBox">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="Background" Value="{DynamicResource List.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource Input.Foreground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource AppComboBoxItemStyle}"/>

                <!-- 显式声明条目面板：默认 VirtualizingStackPanel 在 Popup 里
                     会把条目拉伸/测高异常，导致 6 个选项占满整屏。
                     换成普通 StackPanel 后每项严格按内容高度堆叠。 -->
                <Setter Property="ItemsPanel">
                    <Setter.Value>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical"/>
                        </ItemsPanelTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="28"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 选中项内容（非编辑态显示） -->
                                        <ContentPresenter x:Name="ContentSite"
                                                          Grid.Column="0"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Left"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                          IsHitTestVisible="False"/>

                                        <!-- 可编辑态的输入框（PART_EditableTextBox）。
                                             这是 WPF ComboBox 的约定部件名，必须写进模板，
                                             否则 IsEditable="True" 时 WPF 会自己塞一个
                                             系统默认白底 TextBox 进视觉树——表现为
                                             输入框位置露出白斑，且 Text 双向绑定失效
                                             （手输掩码后无法回写，点应用无效）。
                                             这里显式给深色底 / 无边框 / 与主框同字号。 -->
                                        <TextBox x:Name="PART_EditableTextBox"
                                                 Grid.Column="0"
                                                 Margin="{TemplateBinding Padding}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Stretch"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource Input.Foreground}"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 FontSize="{TemplateBinding FontSize}"
                                                 FontFamily="{TemplateBinding FontFamily}"
                                                 CaretBrush="{DynamicResource AccentBrush}"
                                                 SelectionBrush="{DynamicResource AccentBrush}"
                                                 SelectionOpacity="0.35"
                                                 FocusVisualStyle="{x:Null}"
                                                 VerticalContentAlignment="Center"
                                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                                 Visibility="Collapsed"/>

                                        <!-- 右侧箭头 -->
                                        <Path x:Name="Arrow"
                                              Grid.Column="1"
                                              Data="M 0 0 L 4.5 4.5 L 9 0 Z"
                                              Width="9" Height="5"
                                              Fill="{DynamicResource Text.Secondary}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              IsHitTestVisible="False"/>

                                        <!-- 整个框可点击展开 -->
                                        <ToggleButton x:Name="ToggleBtn"
                                                      Grid.ColumnSpan="2"
                                                      Focusable="False"
                                                      ClickMode="Press"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>

                                <!-- 下拉列表 -->
                                <Popup x:Name="PART_Popup"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom"
                                       VerticalOffset="4"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource List.Background}"
                                            BorderBrush="{DynamicResource Input.Border}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Margin="0,0,8,8"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="280"
                                            SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
                                        </Border.Effect>
                                        <!-- CanContentScroll=False：关闭逻辑滚动，让 ScrollViewer
                                             按像素滚动，条目不会被拉伸到等分视口高度。
                                             ItemsPresenter 会沿用 ComboBox 的 ItemsPanel，
                                             这里在 Style 中已指定为 StackPanel（见下方 Setter），
                                             条目因此按自身 Padding（10,7 ≈ 30px）堆叠。 -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      CanContentScroll="False"
                                                      Focusable="False">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.BorderHover}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                                </Trigger>

                                <!-- 可编辑态：显示编辑框、隐藏只读展示层。
                                     两者同时可见会叠字，这是开启 IsEditable 后
                                     「输入框里出现乱码/重影」的直接原因。 -->
                                <Trigger Property="IsEditable" Value="True">
                                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}"/>

            <!-- ==================================================================
                 ScrollBar 深色样式（全局生效）
                 ==================================================================
                 这是日志页 / 所有列表右侧滚动条发白、发粗的直接原因：
                 之前这里只写了一个 FocusVisualStyle 的空样式，把
                 Themes/Controls.xaml 里的深色模板整个顶掉了。

                 视觉规范：轨道透明，滑块深灰 #4A4A50（圆角、6px 宽），
                 悬停 #6A6A72，按下强调色。上下端隐去箭头按钮（去掉系统浅色方块）。
                 ================================================================== -->
            <Style x:Key="AppScrollBarThumbStyle" TargetType="Thumb">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ThumbBd"
                                    Background="{DynamicResource Scrollbar.Thumb}"
                                    CornerRadius="3"
                                    Margin="2,0"/>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource Scrollbar.ThumbHover}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AppScrollBarPageButtonStyle" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AppScrollBarStyle" TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="10"/>
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid x:Name="Root" Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AppScrollBarPageButtonStyle}"
                                                      Command="ScrollBar.PageUpCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource AppScrollBarThumbStyle}"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource AppScrollBarPageButtonStyle}"
                                                      Command="ScrollBar.PageDownCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 横向滚动条：滑块改为右下边距，轨道高度收窄 -->
                                <Trigger Property="Orientation" Value="Horizontal">
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter Property="MinWidth" Value="0"/>
                                    <Setter Property="Height" Value="10"/>
                                    <Setter Property="MinHeight" Value="10"/>
                                    <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}"/>

            <!-- ==================================================================
                 ToolTip 全局样式（隐式，含完整 Template）
                 ==================================================================
                 用 DynamicResource 绑定深浅色版各自定义的
                 ToolTip.Background / ToolTip.Foreground / ToolTip.Border，
                 深色深底白字、浅色白底黑字。圆角 6、Padding 8,6、字号 12、轻微投影。
                 必须含完整 ControlTemplate（见文件顶部「重要设计约定」：
                 只写 FocusVisualStyle 的空样式会把完整模板顶掉）。 -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource ToolTip.Background}"/>
                <Setter Property="Foreground" Value="{DynamicResource ToolTip.Foreground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ToolTip.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
