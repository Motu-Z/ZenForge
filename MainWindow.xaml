<Window x:Class="ZenForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ZenForge"
        Height="780" Width="1120"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Window.Background}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <!-- 自定义标题栏：CaptionHeight 与第 0 行高度(48)一致 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

     <!-- Background 显式铺一层不透明底板：根 Grid 过去没有画刷，只靠 Window 自身，
          一旦某层渲染出问题，客户区就会露出底色。 -->
     <Grid Background="{DynamicResource Window.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>   <!-- 标题栏 -->
            <RowDefinition Height="Auto"/> <!-- 导航栏 -->
            <RowDefinition Height="*"/>    <!-- 内容区 -->
        </Grid.RowDefinitions>

        <!-- ======= 标题栏 ======= -->
        <Grid Grid.Row="0" Background="{DynamicResource TitleBar.Background}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="ZenForge"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Text.Primary}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        Margin="0,0,8,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource WindowButtonStyle}"
                        ToolTip="最小化"
                        Click="MinimizeButton_Click">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource WindowButtonStyle}"
                        ToolTip="最大化 / 还原"
                        Click="MaximizeButton_Click">
                    <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource WindowCloseButtonStyle}"
                        ToolTip="关闭"
                        Click="CloseButton_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ======= 导航栏 ======= -->
        <!-- ======= 导航栏 =======
             加 1px 底部分隔线：Nav.Background(#212122) 与内容区 Window.Background(#1E1E1E)
             只差 3/255，肉眼分不出边界，导航条与页面内容糊成一片。 -->
        <Border Grid.Row="1"
                Background="{DynamicResource Nav.Background}"
                BorderBrush="{DynamicResource Separator}"
                BorderThickness="0,0,0,1"
                SnapsToDevicePixels="True"
                Padding="16,8,16,8">
            <StackPanel x:Name="NavPanel" Orientation="Horizontal">
                <ToggleButton Style="{StaticResource NavButtonStyle}"
                              Content="调校"
                              Tag="Views/TuningPage.xaml"
                              IsChecked="True"
                              Click="NavButton_Click"/>
                <ToggleButton Style="{StaticResource NavButtonStyle}"
                              Content="调度"
                              Tag="Views/ProcessBindingPage.xaml"
                              Click="NavButton_Click"/>
                <ToggleButton Style="{StaticResource NavButtonStyle}"
                              Content="日志"
                              Tag="Views/LogPage.xaml"
                              Click="NavButton_Click"/>
                <ToggleButton Style="{StaticResource NavButtonStyle}"
                              Content="设置"
                              Tag="Views/SettingsPage.xaml"
                              Click="NavButton_Click"/>
            </StackPanel>
        </Border>

        <!-- ===== 内容区 ===== -->
        <!--
            FocusVisualStyle / IsTabStop 全部清空的原因：
            Frame 与 Page 都是可聚焦控件，默认 FocusVisualStyle 是系统那套
            「1px 黑色圆角虚线框」。鼠标点过导航按钮后按 Tab、或程序内部
            把焦点交给 Frame 时，这条虚线会横贯整个内容区；同时 Page 本身
            也会在内容四周画出虚线 —— 就是截图里那两条"丑陋虚线"的真正来源。
            这里彻底断掉：Frame 不参与 Tab、不显示焦点框，Page 也不显示。
        -->
        <Frame Grid.Row="2"
               x:Name="ContentFrame"
               NavigationUIVisibility="Hidden"
               Focusable="False"
               IsTabStop="False"
               FocusVisualStyle="{x:Null}"
               Background="{DynamicResource Window.Background}"
               Margin="0,2,0,0"/>
    </Grid>
</Window>
