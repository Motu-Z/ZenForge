<?xml version="1.0" encoding="utf-8"?>
<root>
  <!--
    Zentwik 中性（neutral / 源语言）UI 资源。

    【为什么必须有这个文件】
    x:Uid 引用的每个属性都必须有「默认语言或中性」资源，否则 PRI 生成阶段报
    PRI263（No default or neutral resource given），构建警告直接踩 0 警告红线。
    csproj 未设 DefaultLanguage，所以中性资源是唯一能兜住这些 key 的位置。

    键名 = x:Uid.属性（附加属性用 [using:命名空间]类型.属性 语法）。
    与 Strings/zh-CN/Resources.resw 逐条对应：zh-CN 是翻译，本文件是兜底，
    两边 key 必须同步增删。
  -->
  <resheader name="resmimetype"><value>text/microsoft-resx</value></resheader>
  <resheader name="version"><value>2.0</value></resheader>
  <resheader name="reader"><value>System.Resources.ResXResourceReader, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>
  <resheader name="writer"><value>System.Resources.ResXResourceWriter, System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</value></resheader>

  <!-- 页面标题 -->
  <data name="Tuning_Title.Text" xml:space="preserve"><value>调校</value></data>

  <!-- CPU 卡片 -->
  <data name="Tuning_Refresh.[using:Microsoft.UI.Xaml.Controls]ToolTipService.ToolTip" xml:space="preserve"><value>同步当前硬件状态（覆盖未保存的修改）</value></data>
  <data name="Tuning_Refresh.[using:Microsoft.UI.Xaml.Automation]AutomationProperties.Name" xml:space="preserve"><value>同步</value></data>
  <data name="Tuning_Apply.Content" xml:space="preserve"><value>应用</value></data>

  <!-- CO 卡片 -->
  <data name="Tuning_CoTitle.Text" xml:space="preserve"><value>核心电压偏移</value></data>
  <data name="Tuning_CoEmpty.Text" xml:space="preserve"><value>SMU 未连通，未取到核心列表</value></data>

  <!-- FMax 卡片 -->
  <data name="Tuning_FMaxTitle.Text" xml:space="preserve"><value>最高加速频率</value></data>
  <data name="Tuning_MhzUnit.Text" xml:space="preserve"><value>MHz</value></data>

  <!-- 电源策略卡片 -->
  <data name="Tuning_PowerTitle.Text" xml:space="preserve"><value>电源策略控制</value></data>
  <data name="Tuning_PlanLabel.Text" xml:space="preserve"><value>电源计划</value></data>
  <data name="Tuning_BoostLabel.Text" xml:space="preserve"><value>升频模式</value></data>
  <data name="Tuning_ParkingLabel.Text" xml:space="preserve"><value>核心停放</value></data>
  <data name="Tuning_PercentUnit.Text" xml:space="preserve"><value>%</value></data>

  <!-- 脏数据浮动保存条 -->
  <data name="Tuning_DirtyText.Text" xml:space="preserve"><value>参数已修改</value></data>
  <data name="Tuning_Discard.Content" xml:space="preserve"><value>放弃</value></data>
  <data name="Tuning_SaveOverwrite.Content" xml:space="preserve"><value>保存覆盖</value></data>
  <data name="Tuning_SaveAs.Content" xml:space="preserve"><value>另存为</value></data>

  <!-- 写入期遮罩 -->
  <data name="Tuning_RollbackHint.Text" xml:space="preserve"><value>若失败将自动回滚至原状态</value></data>
</root>
