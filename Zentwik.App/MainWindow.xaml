<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zentwik.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 根 Grid 不加 Background：Mica 是画在窗口内容之下的，
         一旦这里填了不透明色，材质就彻底看不见了。 -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏。高度 48 与 Fluent 标题栏标准一致，
             交给 SetTitleBar 之后，系统只保留右上角三个按钮 ——
             Snap Layouts、双击最大化、拖动全部仍是原生行为。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="14" Height="14" CornerRadius="4"
                    Margin="18,0,0,0" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"/>

            <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="Zentwik"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="28,8,28,28">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="16">

                <StackPanel Spacing="6">
                    <TextBlock Text="S4 骨架自检" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="此页只验证三件事：容器建得起来、调度器挂得上、材质与标题栏生效。"/>
                </StackPanel>

                <InfoBar x:Name="BackdropBar"
                         IsOpen="True"
                         IsClosable="False"
                         Severity="{x:Bind BackdropSeverity, Mode=OneTime}"
                         Title="窗口材质"
                         Message="{x:Bind BackdropMessage, Mode=OneTime}"/>

                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="运行环境"/>
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ConfigRoot, Mode=OneTime}"/>
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind LogRoot, Mode=OneTime}"/>
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind DispatcherNote, Mode=OneTime}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
