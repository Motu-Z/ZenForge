<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Zentwik.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ============================================================================
    外壳（与 HTML 原型 1:1）
    ============================================================================

    208px 侧栏 + 48px 标题栏 + 内容区，三层「面」全带透明度让 Mica 透上来：
      基底层 #121214（材质不可用时才不透明）
      侧栏   #18181A / 90%
      内容   #202020 / 80%

    导航用 ListBox + 定制 ListBoxItem，不用 NavigationView：
    NavigationViewItemPresenter 把项高、圆角、指示条尺寸全写死在内部，
    改不出原型里那条 3x16 的圆角高亮条 —— 差 1px 就会显得"不像"。

    标题栏只做拖拽区，不画按钮：系统在 ExtendsContentIntoTitleBar 下仍会画
    min/max/close，再画一套就是两组图标重叠（已实测）。Snap Layouts 也因此保留。
    -->

    <Grid x:Name="RootGrid" Background="Transparent" Loaded="OnRootLoaded">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 基底层：材质可用时透明；纯色档由 ThemeController 改成不透明，防桌面透出 -->
        <Border Grid.RowSpan="2" Grid.ColumnSpan="2"
                Background="{ThemeResource AppWindowBaseBrush}"
                IsHitTestVisible="False" />

        <!-- 侧栏面 -->
        <Border Grid.RowSpan="2" Grid.Column="0"
                Background="{ThemeResource AppSidebarBackgroundBrush}" />

        <!-- 内容面（贯穿标题栏那一行，避免顶上一条色差带） -->
        <Border Grid.RowSpan="2" Grid.Column="1"
                Background="{ThemeResource AppContentBackgroundBrush}" />

        <!-- ==================== 侧栏 ==================== -->
        <Grid Grid.Column="0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 品牌：Consolas 拼字 Zen_TwiK，与主内容区「调校」标题垂直对齐。
                 Run 必须写在同一行：Run 之间的换行缩进会变成可见空格。 -->
            <TextBlock Grid.Row="0"
                       Style="{StaticResource AppBrand}"
                       Margin="20,88,0,18"
                       VerticalAlignment="Top"><Run Text="Zen" FontWeight="Light" /><Run Text="_" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColorBrush}" /><Run Text="Twi" FontWeight="Black" /><Run Text="K" FontWeight="Black" Foreground="{ThemeResource SystemAccentColorBrush}" /></TextBlock>

            <!-- 导航：7 项，三组，组间 1px 分割线 -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          HorizontalScrollMode="Disabled">
                <ListBox x:Name="Nav"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="12,4,12,12"
                         ItemContainerStyle="{StaticResource AppNavItem}"
                         SelectionChanged="OnNavSelectionChanged">

                    <ListBoxItem Tag="tuning">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{ThemeResource AppTextPrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M4,21 V14 M4,10 V3 M12,21 V12 M12,8 V3 M20,21 V16 M20,12 V3 M1,14 H7 M9,8 H15 M17,16 H23" />
                            <TextBlock Text="调校" FontSize="14" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="process">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{ThemeResource AppTextPrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z M12,2 V5 M12,19 V22 M2,12 H5 M19,12 H22 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1" />
                            <TextBlock Text="进程" FontSize="14" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="config">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{ThemeResource AppTextPrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M12,2 L2,7 L12,12 L22,7 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12" />
                            <TextBlock Text="配置" FontSize="14" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource AppNavDivider}" />

                    <ListBoxItem Tag="general">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{ThemeResource AppTextPrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M3,3 H21 A2,2 0 0 1 23,5 V19 A2,2 0 0 1 21,21 H3 A2,2 0 0 1 1,19 V5 A2,2 0 0 1 3,3 Z M1,9 H23 M9,9 V21" />
                            <TextBlock Text="通用" FontSize="14" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="behavior">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{ThemeResource AppTextPrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M22,12 H18 L15,21 L9,3 L6,12 H2" />
                            <TextBlock Text="行为" FontSize="14" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Tag="advanced">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{ThemeResource AppTextPrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M12,2 L2,7 L12,12 L22,7 Z M2,17 L12,22 L22,17 M2,12 L12,17 L22,12" />
                            <TextBlock Text="高级" FontSize="14" />
                        </StackPanel>
                    </ListBoxItem>

                    <ListBoxItem Style="{StaticResource AppNavDivider}" />

                    <ListBoxItem Tag="log">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Path Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{ThemeResource AppTextPrimaryBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Data="M14,2 H6 A2,2 0 0 0 4,4 V20 A2,2 0 0 0 6,22 H18 A2,2 0 0 0 20,20 V8 Z M14,2 V8 H20 M16,13 H8 M16,17 H8" />
                            <TextBlock Text="日志" FontSize="14" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </ScrollViewer>

            <!-- 底部：中/EN 切换（左）与版本号（右），字号 12 三级色 -->
            <Border Grid.Row="2"
                    BorderBrush="{ThemeResource AppCardBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="中 / EN"
                            FontSize="12"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            HorizontalAlignment="Left" />
                    <TextBlock x:Name="VersionText" Grid.Column="1"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 内容区 ==================== -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Frame x:Name="ContentFrame" Background="Transparent" />
        </Grid>

        <!-- ==================== 标题栏拖拽区 ====================
             整行 48px 交给 SetTitleBar：拖动、双击最大化、贴边分屏全由系统处理。
             透明且不拦截命中测试之外的东西，品牌文字在它下层照样可见。 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent" />

        <!-- ==================== 悬浮窗口控制按钮 ====================
            规范红线：三键绝对禁止贴边。距顶/右各 12px 悬浮，圆角 6px。
            系统非客户区按钮区域已在 code-behind 里置空，由这三个按钮接管；
            最大化图标随窗口状态在 □ / ❐ 之间切换。 -->
        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Spacing="4">
            <Button x:Name="MinimizeButton"
                    Style="{StaticResource AppCaptionButton}"
                    Click="OnMinimizeClick"
                    AutomationProperties.Name="最小化">
                <Path Width="16" Height="16" Stretch="None"
                      Stroke="{ThemeResource AppTextPrimaryBrush}"
                      StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M3.5,8 H12.5" />
            </Button>
            <Button x:Name="MaximizeButton"
                    Style="{StaticResource AppCaptionButton}"
                    Click="OnMaximizeClick"
                    AutomationProperties.Name="最大化">
                <Grid>
                    <!-- 最大化 □：圆角方框 Path -->
                    <Path x:Name="MaximizeIcon"
                          Width="16" Height="16" Stretch="None"
                          Stroke="{ThemeResource AppTextPrimaryBrush}"
                          StrokeThickness="1"
                          Data="M5,3 H11 A2,2 0 0 1 13,5 V11 A2,2 0 0 1 11,13 H5 A2,2 0 0 1 3,11 V5 A2,2 0 0 1 5,3 Z" />
                    <!-- 还原 ❐：前框 + 后框右上残段 -->
                    <Path x:Name="RestoreIcon"
                          Width="16" Height="16" Stretch="None"
                          Stroke="{ThemeResource AppTextPrimaryBrush}"
                          StrokeThickness="1"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Visibility="Collapsed"
                          Data="M6,3 H12 A1.5,1.5 0 0 1 13.5,4.5 V10 H12 V4.5 H6 Z M4.5,6 H10 A1.5,1.5 0 0 1 11.5,7.5 V12 A1.5,1.5 0 0 1 10,13.5 H4.5 A1.5,1.5 0 0 1 3,12 V7.5 A1.5,1.5 0 0 1 4.5,6 Z" />
                </Grid>
            </Button>
            <Button x:Name="CloseButton"
                    Style="{StaticResource AppCaptionCloseButton}"
                    Click="OnCloseClick"
                    AutomationProperties.Name="关闭">
                <Path Width="16" Height="16" Stretch="None"
                      Stroke="{ThemeResource AppTextPrimaryBrush}"
                      StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M4,4 L12,12 M12,4 L4,12" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
