<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ============================================================================
    Typography —— 字号阶梯（与 HTML 原型一致）
    ============================================================================

    28 Bold   页面大标题        16 SemiBold  卡片标题
    14 Normal 控件标签          13 Normal    按钮 / 表头
    12 Normal 辅助说明 / 版本号

    数字与时间戳统一走 Consolas：等宽让「-30」「-8」这类逐核数值在网格里竖排对齐。

    字体族名字面量写在这里而不是从别处引用：资源字典的 StaticResource 在字典
    加载期解析，此时它还没有父字典。字体不是「色彩」，写字面量不违反禁止写死颜色的约束。
    -->

    <FontFamily x:Key="AppTextFontFamily">Segoe UI Variable Text, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Consolas</FontFamily>

    <!-- 页面大标题 -->
    <Style x:Key="AppPageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppTextFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="CharacterSpacing" Value="-12" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 品牌：Consolas 等宽，Run 级拼字重（Zen_TwiK），颜色由 Run 自带 -->
    <Style x:Key="AppBrand" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 卡片标题 -->
    <Style x:Key="AppCardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppTextFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- CPU 型号：首屏唯一的视觉锚点 -->
    <Style x:Key="AppCpuName" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppTextFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- 核心数值（等宽） -->
    <Style x:Key="AppNumeric" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 控件标签（规范：14 SemiBold） -->
    <Style x:Key="AppLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppTextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 侧栏导航项 -->
    <Style x:Key="AppNavLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppTextFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 正文 -->
    <Style x:Key="AppBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppTextFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 辅助说明 -->
    <Style x:Key="AppDesc" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppTextFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 路径 / 时间戳 / 版本号 -->
    <Style x:Key="AppMeta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextMetaBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 表头：12px，字距略开，弱化到只作为列名存在 -->
    <Style x:Key="AppTableHeader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppTextFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{ThemeResource AppTextMetaBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

</ResourceDictionary>
