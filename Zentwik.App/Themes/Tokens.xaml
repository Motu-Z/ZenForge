<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    ============================================================================
    Tokens —— 色彩与结构令牌（与 HTML 原型逐值对应）
    ============================================================================

    【层次】
      Base   #121214        窗口基色，材质不可用时铺满，防止桌面透出
      Pane   #202020 / 80%  内容区面，压在 Mica 上
      Side   #18181A / 90%  侧栏面，比内容区暗一档 —— 这是原型里唯一的暗部
      Card   #FFFFFF / 3%   卡片，只提亮一点，靠 1px #14FFFFFF 描边定形
      Ctrl   #FFFFFF / 6%   控件底，比卡片再亮一档

    所有「面」都带透明度：不透明就看不见 Mica，材质等于白设。

    【强调色在根级】
    强调色是产品色，不随明暗变化，且需要被 ThemeController 按用户配置覆盖。
    根级键优先于主题字典被查到，所以放在 ThemeDictionaries 之外。

    【语义色进主题字典】
    用户换强调色后「错误」不能变成紫色。Info / Warn / Error 两套主题各一份常量。
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- ==================== 深色（原型基准） ==================== -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#121214" />
            <SolidColorBrush x:Key="AppWindowBaseBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#E618181A" />
            <SolidColorBrush x:Key="AppContentBackgroundBrush" Color="#CC202020" />

            <!-- 卡片：半透明白 + 8% 白描边 -->
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#14FFFFFF" />

            <!-- 文字：100% / 60% / 40% -->
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="AppTextMetaBrush" Color="#66FFFFFF" />

            <!-- 控件底：6% / 悬停 12% -->
            <SolidColorBrush x:Key="AppControlBackgroundBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="AppControlBackgroundHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AppControlBackgroundPressedBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="AppControlBackgroundDisabledBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="AppControlBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="AppControlBorderHoverBrush" Color="#33FFFFFF" />

            <!-- 导航：悬停 12%，选中 6%（原型 nav-item.active） -->
            <SolidColorBrush x:Key="AppNavItemHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AppNavItemSelectedBrush" Color="#0FFFFFFF" />

            <!-- 标题栏按钮 -->
            <SolidColorBrush x:Key="AppCaptionHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="AppCaptionPressedBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="AppCloseHoverBrush" Color="#FFFF453A" />
            <SolidColorBrush x:Key="AppClosePressedBrush" Color="#FFD93A30" />

            <!-- 语义色（铁律：不随强调色变化） -->
            <SolidColorBrush x:Key="AppInfoBrush" Color="#FFA3B8CC" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="#FFF5D90A" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#FFFF453A" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="AppInfoSoftBrush" Color="#26A3B8CC" />
            <SolidColorBrush x:Key="AppWarnSoftBrush" Color="#26F5D90A" />
            <SolidColorBrush x:Key="AppErrorSoftBrush" Color="#26FF453A" />

            <!-- 遮罩：原型 rgba(0,0,0,0.6) -->
            <SolidColorBrush x:Key="AppScrimBrush" Color="#99000000" />

            <!-- 规范要求的系统语义键（在本主题内覆盖，保证色板一致） -->
            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#66FFFFFF" />

            <!-- 下拉 Popup：不透明深底 #252526，防透底 -->
            <SolidColorBrush x:Key="AppComboPopupBackgroundBrush" Color="#FF252526" />

            <!-- 浮层：唯一不透明层，防穿透 -->
            <SolidColorBrush x:Key="AppPopupBackgroundBrush" Color="#F21F1F23" />
            <SolidColorBrush x:Key="AppPopupBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="AppRowHoverBrush" Color="#14FFFFFF" />

            <!-- InfoBar：半透明语义底 + 8px 圆角，不用原生亮黄 -->
            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#26F5D90A" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#30FF453A" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#2660CDFF" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="#33F5D90A" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="#33FF453A" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#3360CDFF" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#33A3B8CC" />
            <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#4DFF453A" />
            <SolidColorBrush x:Key="InfoBarTitleForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="InfoBarMessageForeground" Color="#CCFFFFFF" />

            <!-- 输入类控件的原生主题键 -->
            <SolidColorBrush x:Key="TextControlBackground" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#9960CDFF" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#66FFFFFF" />

            <!-- 滑块 -->
            <SolidColorBrush x:Key="SliderTrackFill" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF7FD8FF" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF4FB8E8" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF7FD8FF" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF4FB8E8" />
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />

            <!-- 开关 -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF7FD8FF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF4FB8E8" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF7FD8FF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF4FB8E8" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FF000000" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FF000000" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FF000000" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
        </ResourceDictionary>

        <!-- ==================== 浅色 ==================== -->
        <ResourceDictionary x:Key="Light">

            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="AppWindowBaseBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#F2E8E9ED" />
            <SolidColorBrush x:Key="AppContentBackgroundBrush" Color="#D9F7F8FA" />

            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#14000000" />

            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FF14161A" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#995F646D" />
            <SolidColorBrush x:Key="AppTextMetaBrush" Color="#66868C96" />

            <SolidColorBrush x:Key="AppControlBackgroundBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="AppControlBackgroundHoverBrush" Color="#17000000" />
            <SolidColorBrush x:Key="AppControlBackgroundPressedBrush" Color="#22000000" />
            <SolidColorBrush x:Key="AppControlBackgroundDisabledBrush" Color="#06000000" />
            <SolidColorBrush x:Key="AppControlBorderBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="AppControlBorderHoverBrush" Color="#33000000" />

            <SolidColorBrush x:Key="AppNavItemHoverBrush" Color="#17000000" />
            <SolidColorBrush x:Key="AppNavItemSelectedBrush" Color="#0D000000" />

            <SolidColorBrush x:Key="AppCaptionHoverBrush" Color="#17000000" />
            <SolidColorBrush x:Key="AppCaptionPressedBrush" Color="#22000000" />
            <SolidColorBrush x:Key="AppCloseHoverBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="AppClosePressedBrush" Color="#FFA9261A" />

            <SolidColorBrush x:Key="AppInfoBrush" Color="#FF4A6076" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="#FF9D7B00" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF0A7EBB" />
            <SolidColorBrush x:Key="AppInfoSoftBrush" Color="#1F4A6076" />
            <SolidColorBrush x:Key="AppWarnSoftBrush" Color="#269D7B00" />
            <SolidColorBrush x:Key="AppErrorSoftBrush" Color="#26C42B1C" />

            <SolidColorBrush x:Key="AppScrimBrush" Color="#99000000" />

            <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#17000000" />
            <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#995F646D" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#66868C96" />

            <SolidColorBrush x:Key="AppComboPopupBackgroundBrush" Color="#FFFAFAFA" />

            <SolidColorBrush x:Key="AppPopupBackgroundBrush" Color="#FFFCFCFD" />
            <SolidColorBrush x:Key="AppPopupBorderBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="AppRowHoverBrush" Color="#0F000000" />

            <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="#26F5D90A" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="#30C42B1C" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="#260A7EBB" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="InfoBarWarningSeverityIconBackground" Color="#339D7B00" />
            <SolidColorBrush x:Key="InfoBarErrorSeverityIconBackground" Color="#33C42B1C" />
            <SolidColorBrush x:Key="InfoBarSuccessSeverityIconBackground" Color="#330A7EBB" />
            <SolidColorBrush x:Key="InfoBarInformationalSeverityIconBackground" Color="#334A6076" />
            <SolidColorBrush x:Key="InfoBarBorderBrush" Color="#4DC42B1C" />
            <SolidColorBrush x:Key="InfoBarTitleForeground" Color="#FF14161A" />
            <SolidColorBrush x:Key="InfoBarMessageForeground" Color="#FF3A3E46" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#0D000000" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#17000000" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#0D000000" />
            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#06000000" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#33000000" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#990A7EBB" />
            <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#12000000" />
            <SolidColorBrush x:Key="TextControlForeground" Color="#FF14161A" />
            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FF868C96" />

            <SolidColorBrush x:Key="SliderTrackFill" Color="#22000000" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#33000000" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#33000000" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#FF0A7EBB" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FF0F93D6" />
            <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#FF086A9E" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#FF0A7EBB" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#FF0F93D6" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#FF086A9E" />
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />

            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF0A7EBB" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF0F93D6" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF086A9E" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF0A7EBB" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF0F93D6" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPressed" Color="#FF086A9E" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#14000000" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF5F646D" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOffPressed" Color="Transparent" />
        </ResourceDictionary>

        <!-- ==================== 高对比度 ==================== -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="#121214" />
            <SolidColorBrush x:Key="AppWindowBaseBrush" Color="#121214" />
            <SolidColorBrush x:Key="AppSidebarBackgroundBrush" Color="#18181A" />
            <SolidColorBrush x:Key="AppContentBackgroundBrush" Color="#202020" />
            <SolidColorBrush x:Key="AppCardBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="AppDividerBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AppTextPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AppTextSecondaryBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="AppTextMetaBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="AppControlBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="AppControlBackgroundHoverBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AppControlBackgroundPressedBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="AppControlBackgroundDisabledBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="AppControlBorderBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="AppControlBorderHoverBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="AppNavItemHoverBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AppNavItemSelectedBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="AppCaptionHoverBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AppCaptionPressedBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="AppCloseHoverBrush" Color="#FFFF453A" />
            <SolidColorBrush x:Key="AppClosePressedBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="AppInfoBrush" Color="#FFA3B8CC" />
            <SolidColorBrush x:Key="AppWarnBrush" Color="#FFF5D90A" />
            <SolidColorBrush x:Key="AppErrorBrush" Color="#FFFF453A" />
            <SolidColorBrush x:Key="AppSuccessBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="AppInfoSoftBrush" Color="#26A3B8CC" />
            <SolidColorBrush x:Key="AppWarnSoftBrush" Color="#26F5D90A" />
            <SolidColorBrush x:Key="AppErrorSoftBrush" Color="#26FF453A" />
            <SolidColorBrush x:Key="AppScrimBrush" Color="#CC000000" />
            <SolidColorBrush x:Key="AppPopupBackgroundBrush" Color="#FF1C1C1F" />
            <SolidColorBrush x:Key="AppComboPopupBackgroundBrush" Color="#FF1C1C1F" />
            <SolidColorBrush x:Key="AppPopupBorderBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="AppRowHoverBrush" Color="#24FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ==================== 强调色 #60CDFF ==================== -->
    <!-- 规范要求品牌色走 SystemAccentColor 语义键：颜色 + 画刷成对提供，
         XAML 里 Foreground 一律绑画刷（WinUI 不接受 Color 直接赋 Brush）。 -->
    <Color x:Key="SystemAccentColor">#FF60CDFF</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource SystemAccentColor}" />

    <SolidColorBrush x:Key="AppAccentBrush" Color="#FF60CDFF" />
    <SolidColorBrush x:Key="AppAccentHoverBrush" Color="#FF7FD8FF" />
    <SolidColorBrush x:Key="AppAccentPressedBrush" Color="#FF4FB8E8" />
    <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#2660CDFF" />
    <SolidColorBrush x:Key="AppAccentSoftHoverBrush" Color="#4060CDFF" />
    <SolidColorBrush x:Key="AppAccentBorderBrush" Color="#4D60CDFF" />
    <SolidColorBrush x:Key="AppOnAccentBrush" Color="#FF04222F" />

    <!-- ==================== 尺寸 ==================== -->
    <CornerRadius x:Key="AppCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="AppControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="AppComboCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="AppCaptionCornerRadius">6</CornerRadius>

    <Thickness x:Key="AppCardPadding">20,24</Thickness>
    <Thickness x:Key="AppContentPadding">40,32,40,32</Thickness>

    <x:Double x:Key="AppControlHeight">32</x:Double>
    <x:Double x:Key="AppSmallControlHeight">26</x:Double>
    <x:Double x:Key="AppComboHeight">34</x:Double>
    <x:Double x:Key="AppInputHeight">34</x:Double>
    <x:Double x:Key="AppIconButtonSize">36</x:Double>
    <x:Double x:Key="AppSidebarWidth">220</x:Double>
    <x:Double x:Key="AppTitleBarHeight">48</x:Double>
    <x:Double x:Key="AppCardSpacing">16</x:Double>
    <x:Double x:Key="AppCaptionButtonSize">32</x:Double>
    <x:Double x:Key="AppNavItemHeight">40</x:Double>

    <!-- ==================== Slider 尺寸 ====================
        WinUI 原生 Slider 模板按这些主题资源取尺寸（见 WindowsAppSDK generic.xaml）：
        覆盖它们即可得到 2px 细轨道 + 14px 圆点，不动模板、不破坏拖动逻辑。 -->
    <x:Double x:Key="SliderTrackThemeHeight">2</x:Double>
    <x:Double x:Key="SliderHorizontalThumbWidth">14</x:Double>
    <x:Double x:Key="SliderHorizontalThumbHeight">14</x:Double>
    <x:Double x:Key="SliderPreContentMargin">12</x:Double>
    <x:Double x:Key="SliderPostContentMargin">12</x:Double>

</ResourceDictionary>
