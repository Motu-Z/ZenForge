<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zentwik.App.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Zentwik.App.ViewModels"
    Background="Transparent">

    <Grid Padding="28,12,28,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="日志" Style="{StaticResource AppPageTitle}" Margin="0,10,0,2" />

        <!-- ==================== 第一行：等级徽章 + 详细日志 ==================== -->
        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton Style="{StaticResource AppPillToggle}"
                              IsChecked="{x:Bind ViewModel.ShowInfo, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{ThemeResource AppInfoBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="信息" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.InfoCountText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Style="{StaticResource AppPillToggle}"
                              IsChecked="{x:Bind ViewModel.ShowWarn, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{ThemeResource AppWarnBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="警告" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.WarnCountText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Style="{StaticResource AppPillToggle}"
                              IsChecked="{x:Bind ViewModel.ShowError, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{ThemeResource AppErrorBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="错误" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.ErrorCountText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="详细日志" Style="{StaticResource AppLabel}" />
                <ToggleSwitch IsOn="{x:Bind ViewModel.Verbose, Mode=TwoWay}"
                              OnContent=""
                              OffContent=""
                              MinWidth="0" />
            </StackPanel>
        </Grid>

        <!-- ==================== 第二行：搜索 + 操作 ==================== -->
        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Width="280"
                     Style="{StaticResource AppTextBox}"
                     PlaceholderText="搜索日志"
                     Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}"
                        Style="{StaticResource AppButtonSmall}"
                        Command="{x:Bind ViewModel.TogglePauseCommand}" />
                <Button Content="清空"
                        Style="{StaticResource AppButtonSmallDanger}"
                        Command="{x:Bind ViewModel.ClearCommand}" />
                <Button Content="目录"
                        Style="{StaticResource AppButtonSmall}"
                        Click="OnOpenLogFolder" />
            </StackPanel>
        </Grid>

        <!-- ==================== 列表 ==================== -->
        <Border Grid.Row="3"
                Background="{ThemeResource AppCardBackgroundBrush}"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource AppCardCornerRadius}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                    <!-- ItemsRepeater + ScrollViewer：自带回收与虚拟化，
                         200 条全量呈现也不会一次创建 200 个元素。 -->
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="0" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogRowViewModel">
                                <Grid ColumnSpacing="10" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 语义色竖条：三个 Border 叠在同一格，按等级切显隐。
                                         这样颜色来自 ThemeResource，主题切换无需重建行。 -->
                                    <Grid>
                                        <Border CornerRadius="1.5" Background="{ThemeResource AppInfoBrush}"
                                                Visibility="{x:Bind IsInfo, Mode=OneWay}" />
                                        <Border CornerRadius="1.5" Background="{ThemeResource AppWarnBrush}"
                                                Visibility="{x:Bind IsWarn, Mode=OneWay}" />
                                        <Border CornerRadius="1.5" Background="{ThemeResource AppErrorBrush}"
                                                Visibility="{x:Bind IsError, Mode=OneWay}" />
                                    </Grid>

                                    <TextBlock Grid.Column="1" Text="{x:Bind TimeText, Mode=OneWay}"
                                               Style="{StaticResource AppMeta}"
                                               VerticalAlignment="Top"
                                               Margin="0,2,0,0" />

                                    <Grid Grid.Column="2" VerticalAlignment="Top" Margin="0,2,0,0" MinWidth="42">
                                        <TextBlock Text="{x:Bind LevelText, Mode=OneWay}"
                                                   Style="{StaticResource AppMeta}"
                                                   Foreground="{ThemeResource AppInfoBrush}"
                                                   Visibility="{x:Bind IsInfo, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind LevelText, Mode=OneWay}"
                                                   Style="{StaticResource AppMeta}"
                                                   Foreground="{ThemeResource AppWarnBrush}"
                                                   Visibility="{x:Bind IsWarn, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind LevelText, Mode=OneWay}"
                                                   Style="{StaticResource AppMeta}"
                                                   Foreground="{ThemeResource AppErrorBrush}"
                                                   Visibility="{x:Bind IsError, Mode=OneWay}" />
                                    </Grid>

                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind Message, Mode=OneWay}"
                                               Style="{StaticResource AppBody}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               IsTextSelectionEnabled="True" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                           Style="{StaticResource AppDesc}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ==================== 页脚：上限说明 ==================== -->
        <Grid Grid.Row="4">
            <TextBlock Text="{x:Bind ViewModel.FooterText, Mode=OneWay}"
                       Style="{StaticResource AppMeta}" />
            <TextBlock Text="内存上限 200 条，超出淘汰最旧记录；完整日志见日志目录。"
                       Style="{StaticResource AppMeta}"
                       HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</Page>
