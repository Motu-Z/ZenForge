<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zentwik.App.Views.ConfigPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Zentwik.Core.Services"
    xmlns:local="using:Zentwik.App"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,12,28,24" Spacing="16">

            <TextBlock Text="配置" Style="{StaticResource AppPageTitle}" Margin="0,10,0,2" />

            <!-- ==================== 场景自动切换 ==================== -->
            <Border Style="{StaticResource AppCard}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="场景自动切换" Style="{StaticResource AppCardTitle}"
                               VerticalAlignment="Center" />
                    <ToggleSwitch Grid.Column="1"
                                  OnContent="" OffContent=""
                                  IsOn="{x:Bind ViewModel.ScenarioEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- ==================== 总体配置方案 ==================== -->
            <Border Style="{StaticResource AppCard}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="总体配置方案" Style="{StaticResource AppCardTitle}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource AppPill}" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.ActiveProfileName, Mode=OneWay}"
                                       Style="{StaticResource AppDesc}" />
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource AppInnerPanel}"
                            Visibility="{x:Bind local:UiConverters.ToVisibleWhenFalse(ViewModel.HasProfiles), Mode=OneWay}">
                        <TextBlock Text="尚无配置方案"
                                   Style="{StaticResource AppDesc}"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="core:ProfileSnapshot">
                                <Grid ColumnSpacing="12" Padding="14,10"
                                      Background="{ThemeResource AppControlBackgroundBrush}"
                                      CornerRadius="{StaticResource AppControlCornerRadius}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource AppBody}" />
                                        <TextBlock Text="{x:Bind Note}"
                                                   Style="{StaticResource AppMeta}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Border Grid.Column="1" Style="{StaticResource AppPill}"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind IsActive, Mode=OneWay}">
                                        <TextBlock Text="生效中" Style="{StaticResource AppMeta}" />
                                    </Border>

                                    <Button Grid.Column="2"
                                            Content="应用"
                                            Style="{StaticResource AppButtonSmall}"
                                            VerticalAlignment="Center"
                                            Click="OnApplyProfileClick" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- ==================== 规则库双列 ====================
                 两列都用 VerticalAlignment="Stretch"，高度由内容较多的一侧决定，
                 避免出现「左边一张短卡、右边一张长卡」的错位。 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppCard}" VerticalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock Text="调校规则" Style="{StaticResource AppCardTitle}" />
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.TuningRules, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               Style="{StaticResource AppDesc}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AppCard}" VerticalAlignment="Stretch">
                    <StackPanel Spacing="12">
                        <TextBlock Text="调度规则" Style="{StaticResource AppCardTitle}" />

                        <TextBlock Text="尚未设置进程绑核"
                                   Style="{StaticResource AppDesc}"
                                   Visibility="{x:Bind local:UiConverters.ToVisibleWhenFalse(ViewModel.HasScheduleRules), Mode=OneWay}" />

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.ScheduleRules, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               Style="{StaticResource AppDesc}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
