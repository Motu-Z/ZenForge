<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zentwik.App.Views.TuningPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Zentwik.App.ViewModels"
    xmlns:ctl="using:Zentwik.App.Controls"
    xmlns:local="using:Zentwik.App"
    Background="Transparent">

    <!--
    ============================================================================
    调校页 —— 按 UI_Contract v1.1 / v1.2 全量 x:Bind 重写
    ============================================================================
    数值输入纯 TextBox（契约入口 EditText / FMaxText / ParkingText，34px / Consolas /
    居中），隐式步进：加减号平时隐藏，悬浮（PointerOver）/ 聚焦（Focused）时淡入。

    【为什么加减号命令走 Tag / Header 穿透】
    {x:Bind} 不允许出现在 ControlTemplate 内（编译期绑定需要页面级绑定根），
    而加减号必须活在 TextBox 模板里才能跟随它的 PointerOver / Focused 状态机。
    所以命令在模板外经 x:Bind 注入 TextBox.Tag（减）/ TextBox.Header（加），
    模板内 Button 用 {TemplateBinding} 取出。Tag / Header 均为 object 依赖属性，
    本页不另作他用，无反射、AOT 安全。

    步进命令为契约 v1.2 待后端补全的成员：
      CoreSlotViewModel.IncrementCommand / DecrementCommand（±1，钳制 -50~+50）；
      TuningViewModel.IncrementCommand / DecrementCommand（IRelayCommand<string>，
      参数 "FMax" / "Parking"，内部须调 MarkDirty() 走脏数据链）。
    ============================================================================
    -->

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource AppContentPadding}">
            <StackPanel Spacing="16">

                <TextBlock x:Uid="Tuning_Title"
                           Style="{StaticResource AppPageTitle}"
                           Margin="0,0,0,8" />

                <!-- 提示条：只承载 Error / Warning（后端置 IsStatusVisible）；成功不占首屏 -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=TwoWay}"
                         IsClosable="True"
                         Severity="{x:Bind local:UiConverters.ToInfoBarSeverity(ViewModel.StatusLevel), Mode=OneWay}"
                         Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}">
                    <InfoBar.Resources>
                        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                    </InfoBar.Resources>
                </InfoBar>

                <!-- ==================== CPU 卡片 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 同步：SMU 不可用时后端不硬读、直接告警，按钮保持可点以便恢复后重试 -->
                        <Button Grid.Column="0"
                                x:Uid="Tuning_Refresh"
                                Style="{StaticResource AppIconButton}"
                                Command="{x:Bind ViewModel.RefreshCommand}"
                                VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.CpuName, Mode=OneWay}"
                                       Style="{StaticResource AppCpuName}" />
                            <TextBlock Text="{x:Bind ViewModel.CpuSubText, Mode=OneWay}"
                                       Style="{StaticResource AppDesc}"
                                       Margin="0,4,0,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- 方案下拉 + 应用：一组操作，间距 8，统一 34px 高 -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <Grid MinWidth="150">
                                <ctl:AppComboBox ItemsSource="{x:Bind ViewModel.ProfileOptions, Mode=OneWay}"
                                                 SelectedIndex="{x:Bind ViewModel.ProfileIndex, Mode=TwoWay}" />
                                <!-- 脏数据星号：契约 2.1 —— IsDraftDirty 唯一用途即此角标 -->
                                <TextBlock Text="*"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{ThemeResource AppAccentBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"
                                           Margin="0,-8,2,0"
                                           IsHitTestVisible="False"
                                           Visibility="{x:Bind local:UiConverters.ToVisibleWhenTrue(ViewModel.IsDraftDirty)}" />
                            </Grid>
                            <Button x:Uid="Tuning_Apply"
                                    Height="34"
                                    Style="{StaticResource AppButtonPrimary}"
                                    Command="{x:Bind ViewModel.ApplyCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== CO 卡片 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Tuning_CoTitle"
                                   Style="{StaticResource AppCardTitle}" />

                        <!-- 空态：HasCores == false 时网格整块收起 -->
                        <Border Style="{StaticResource AppInnerPanel}"
                                Visibility="{x:Bind local:UiConverters.ToVisibleWhenTrue(ViewModel.IsCoreGridEmpty)}">
                            <TextBlock x:Uid="Tuning_CoEmpty"
                                       Style="{StaticResource AppDesc}"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <!-- 8 列等分流式布局；格数 = Cores.Count，严禁写死 -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cores, Mode=OneWay}"
                                       Visibility="{x:Bind local:UiConverters.ToVisibleWhenTrue(ViewModel.HasCores)}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout Orientation="Horizontal"
                                                   MaximumRowsOrColumns="8"
                                                   ItemsStretch="Fill"
                                                   MinItemWidth="64"
                                                   MinItemHeight="34"
                                                   MinColumnSpacing="8"
                                                   MinRowSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:CoreSlotViewModel">
                                    <TextBox Style="{StaticResource AppTextBoxMono}"
                                             MaxLength="4"
                                             Text="{x:Bind EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnCoTextChanged"
                                             Tag="{x:Bind DecrementCommand}"
                                             Header="{x:Bind IncrementCommand}">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid x:Name="RootGrid">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundPointerOver}" />
                                                                    <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushPointerOver}" />
                                                                    <Setter Target="DecButton.Opacity" Value="1" />
                                                                    <Setter Target="DecButton.IsHitTestVisible" Value="True" />
                                                                    <Setter Target="IncButton.Opacity" Value="1" />
                                                                    <Setter Target="IncButton.IsHitTestVisible" Value="True" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                    <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundPointerOver}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled">
                                                                <VisualState.Setters>
                                                                    <Setter Target="RootGrid.Opacity" Value="0.4" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="FocusStates">
                                                            <VisualState x:Name="Unfocused" />
                                                            <VisualState x:Name="Focused">
                                                                <VisualState.Setters>
                                                                    <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                                    <Setter Target="DecButton.Opacity" Value="1" />
                                                                    <Setter Target="DecButton.IsHitTestVisible" Value="True" />
                                                                    <Setter Target="IncButton.Opacity" Value="1" />
                                                                    <Setter Target="IncButton.IsHitTestVisible" Value="True" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="PointerFocused">
                                                                <VisualState.Setters>
                                                                    <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                                    <Setter Target="DecButton.Opacity" Value="1" />
                                                                    <Setter Target="DecButton.IsHitTestVisible" Value="True" />
                                                                    <Setter Target="IncButton.Opacity" Value="1" />
                                                                    <Setter Target="IncButton.IsHitTestVisible" Value="True" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                    <Border x:Name="BorderElement"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="{TemplateBinding CornerRadius}" />

                                                    <!-- ContentElement 是 TextBox code-behind 的必要命名部件 -->
                                                    <ScrollViewer x:Name="ContentElement"
                                                                  Padding="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  IsTabStop="False"
                                                                  HorizontalScrollMode="Disabled"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollMode="Disabled"
                                                                  VerticalScrollBarVisibility="Hidden"
                                                                  ZoomMode="Disabled"
                                                                  AutomationProperties.AccessibilityView="Raw" />

                                                    <TextBlock x:Name="PlaceholderTextContentPresenter"
                                                               Text="{TemplateBinding PlaceholderText}"
                                                               Foreground="{ThemeResource TextControlPlaceholderForeground}"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed" />

                                                    <!-- 命令经 Tag / Header 穿透（见页头注释）；IsTabStop=False
                                                         保证点按不抢 TextBox 焦点 -->
                                                    <Button x:Name="DecButton"
                                                            Style="{StaticResource AppStepperButton}"
                                                            Width="18" Height="30"
                                                            Margin="2,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource TextControlBackground}"
                                                            FontSize="13"
                                                            Content="&#x2013;"
                                                            IsTabStop="False"
                                                            Opacity="0"
                                                            IsHitTestVisible="False"
                                                            Command="{TemplateBinding Tag}" />
                                                    <Button x:Name="IncButton"
                                                            Style="{StaticResource AppStepperButton}"
                                                            Width="18" Height="30"
                                                            Margin="0,0,2,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource TextControlBackground}"
                                                            FontSize="13"
                                                            Content="+"
                                                            IsTabStop="False"
                                                            Opacity="0"
                                                            IsHitTestVisible="False"
                                                            Command="{TemplateBinding Header}" />
                                                </Grid>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- ==================== FMax 卡片 ====================
                     契约 v1.2：IsEnabled 硬闸门绑 IsFMaxSupported -->
                <Border Style="{StaticResource AppCard}">
                    <Grid ColumnSpacing="16">
                        <TextBlock x:Uid="Tuning_FMaxTitle"
                                   Style="{StaticResource AppCardTitle}"
                                   VerticalAlignment="Center" />
                        <!-- IsEnabled 只能设在 Control 上：ContentControl 仅作闸门容器 -->
                        <ContentControl Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsTabStop="False"
                                        IsEnabled="{x:Bind ViewModel.IsFMaxSupported, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource AppTextBoxMono}"
                                         Width="80"
                                         MaxLength="4"
                                         Text="{x:Bind ViewModel.FMaxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextChanged="OnFMaxTextChanged"
                                         Tag="{x:Bind ViewModel.DecrementCommand}"
                                         Header="{x:Bind ViewModel.IncrementCommand}">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid x:Name="RootGrid">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal" />
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundPointerOver}" />
                                                                <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushPointerOver}" />
                                                                <Setter Target="DecButton.Opacity" Value="1" />
                                                                <Setter Target="DecButton.IsHitTestVisible" Value="True" />
                                                                <Setter Target="IncButton.Opacity" Value="1" />
                                                                <Setter Target="IncButton.IsHitTestVisible" Value="True" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <VisualState.Setters>
                                                                <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundPointerOver}" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <VisualState.Setters>
                                                                <Setter Target="RootGrid.Opacity" Value="0.4" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                    <VisualStateGroup x:Name="FocusStates">
                                                        <VisualState x:Name="Unfocused" />
                                                        <VisualState x:Name="Focused">
                                                            <VisualState.Setters>
                                                                <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                                <Setter Target="DecButton.Opacity" Value="1" />
                                                                <Setter Target="DecButton.IsHitTestVisible" Value="True" />
                                                                <Setter Target="IncButton.Opacity" Value="1" />
                                                                <Setter Target="IncButton.IsHitTestVisible" Value="True" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="PointerFocused">
                                                            <VisualState.Setters>
                                                                <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                                <Setter Target="DecButton.Opacity" Value="1" />
                                                                <Setter Target="DecButton.IsHitTestVisible" Value="True" />
                                                                <Setter Target="IncButton.Opacity" Value="1" />
                                                                <Setter Target="IncButton.IsHitTestVisible" Value="True" />
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>

                                                <Border x:Name="BorderElement"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="{TemplateBinding CornerRadius}" />

                                                <ScrollViewer x:Name="ContentElement"
                                                              Padding="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"
                                                              IsTabStop="False"
                                                              HorizontalScrollMode="Disabled"
                                                              HorizontalScrollBarVisibility="Hidden"
                                                              VerticalScrollMode="Disabled"
                                                              VerticalScrollBarVisibility="Hidden"
                                                              ZoomMode="Disabled"
                                                              AutomationProperties.AccessibilityView="Raw" />

                                                <TextBlock x:Name="PlaceholderTextContentPresenter"
                                                           Text="{TemplateBinding PlaceholderText}"
                                                           Foreground="{ThemeResource TextControlPlaceholderForeground}"
                                                           IsHitTestVisible="False"
                                                           Visibility="Collapsed" />

                                                <!-- 页面级步进命令（契约 v1.2 待后端补全）：
                                                     参数 "FMax" 区分入口，±步进钳制 400~5400，
                                                     内部须调 MarkDirty() 走脏数据链 -->
                                                <Button x:Name="DecButton"
                                                        Style="{StaticResource AppStepperButton}"
                                                        Width="18" Height="30"
                                                        Margin="2,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource TextControlBackground}"
                                                        FontSize="13"
                                                        Content="&#x2013;"
                                                        IsTabStop="False"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"
                                                        Command="{TemplateBinding Tag}"
                                                        CommandParameter="FMax" />
                                                <Button x:Name="IncButton"
                                                        Style="{StaticResource AppStepperButton}"
                                                        Width="18" Height="30"
                                                        Margin="0,0,2,0"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Background="{ThemeResource TextControlBackground}"
                                                        FontSize="13"
                                                        Content="+"
                                                        IsTabStop="False"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"
                                                        Command="{TemplateBinding Header}"
                                                        CommandParameter="FMax" />
                                            </Grid>
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock x:Uid="Tuning_MhzUnit"
                                           Style="{StaticResource AppDesc}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </ContentControl>
                    </Grid>
                </Border>

                <!-- ==================== 电源策略卡片 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Tuning_PowerTitle" Style="{StaticResource AppCardTitle}" />

                        <Grid ColumnSpacing="16" RowSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       x:Uid="Tuning_PlanLabel"
                                       Style="{StaticResource AppLabel}" />
                            <ctl:AppComboBox Grid.Row="0" Grid.Column="1"
                                             MinWidth="140"
                                             HorizontalAlignment="Right"
                                             ItemsSource="{x:Bind ViewModel.PowerPlanOptions}"
                                             SelectedIndex="{x:Bind ViewModel.PowerPlanIndex, Mode=TwoWay}"
                                             SelectionChanged="OnPowerSelectionChanged" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       x:Uid="Tuning_BoostLabel"
                                       Style="{StaticResource AppLabel}" />
                            <ctl:AppComboBox Grid.Row="1" Grid.Column="1"
                                             MinWidth="140"
                                             HorizontalAlignment="Right"
                                             ItemsSource="{x:Bind ViewModel.BoostOptions}"
                                             SelectedIndex="{x:Bind ViewModel.BoostIndex, Mode=TwoWay}"
                                             IsEnabled="{x:Bind ViewModel.PowerAvailable, Mode=OneWay}"
                                             SelectionChanged="OnPowerSelectionChanged" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       x:Uid="Tuning_ParkingLabel"
                                       Style="{StaticResource AppLabel}" />
                            <!-- 契约 v1.2：核心停放整组 IsEnabled 硬闸门绑 IsCoreParkingSupported
                                 （PowerAvailable=false 时后端保证该闸门同为 false）。
                                 IsEnabled 只能设在 Control 上：ContentControl 仅作闸门容器 -->
                            <ContentControl Grid.Row="2" Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            IsTabStop="False"
                                            IsEnabled="{x:Bind ViewModel.IsCoreParkingSupported, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Slider Width="140"
                                            Minimum="0"
                                            Maximum="100"
                                            StepFrequency="5"
                                            Value="{x:Bind ViewModel.ParkingValue, Mode=TwoWay}"
                                            ValueChanged="OnParkingValueChanged"
                                            VerticalAlignment="Center" />
                                    <TextBox Style="{StaticResource AppTextBoxMono}"
                                             Width="64"
                                             MaxLength="3"
                                             Text="{x:Bind ViewModel.ParkingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="OnParkingTextChanged"
                                             Tag="{x:Bind ViewModel.DecrementCommand}"
                                             Header="{x:Bind ViewModel.IncrementCommand}">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Grid x:Name="RootGrid">
                                                    <VisualStateManager.VisualStateGroups>
                                                        <VisualStateGroup x:Name="CommonStates">
                                                            <VisualState x:Name="Normal" />
                                                            <VisualState x:Name="PointerOver">
                                                                <VisualState.Setters>
                                                                    <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundPointerOver}" />
                                                                    <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushPointerOver}" />
                                                                    <Setter Target="DecButton.Opacity" Value="1" />
                                                                    <Setter Target="DecButton.IsHitTestVisible" Value="True" />
                                                                    <Setter Target="IncButton.Opacity" Value="1" />
                                                                    <Setter Target="IncButton.IsHitTestVisible" Value="True" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Pressed">
                                                                <VisualState.Setters>
                                                                    <Setter Target="BorderElement.Background" Value="{ThemeResource TextControlBackgroundPointerOver}" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="Disabled">
                                                                <VisualState.Setters>
                                                                    <Setter Target="RootGrid.Opacity" Value="0.4" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                        <VisualStateGroup x:Name="FocusStates">
                                                            <VisualState x:Name="Unfocused" />
                                                            <VisualState x:Name="Focused">
                                                                <VisualState.Setters>
                                                                    <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                                    <Setter Target="DecButton.Opacity" Value="1" />
                                                                    <Setter Target="DecButton.IsHitTestVisible" Value="True" />
                                                                    <Setter Target="IncButton.Opacity" Value="1" />
                                                                    <Setter Target="IncButton.IsHitTestVisible" Value="True" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                            <VisualState x:Name="PointerFocused">
                                                                <VisualState.Setters>
                                                                    <Setter Target="BorderElement.BorderBrush" Value="{ThemeResource TextControlBorderBrushFocused}" />
                                                                    <Setter Target="DecButton.Opacity" Value="1" />
                                                                    <Setter Target="DecButton.IsHitTestVisible" Value="True" />
                                                                    <Setter Target="IncButton.Opacity" Value="1" />
                                                                    <Setter Target="IncButton.IsHitTestVisible" Value="True" />
                                                                </VisualState.Setters>
                                                            </VisualState>
                                                        </VisualStateGroup>
                                                    </VisualStateManager.VisualStateGroups>

                                                    <Border x:Name="BorderElement"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="{TemplateBinding CornerRadius}" />

                                                    <ScrollViewer x:Name="ContentElement"
                                                                  Padding="{TemplateBinding Padding}"
                                                                  VerticalAlignment="Center"
                                                                  IsTabStop="False"
                                                                  HorizontalScrollMode="Disabled"
                                                                  HorizontalScrollBarVisibility="Hidden"
                                                                  VerticalScrollMode="Disabled"
                                                                  VerticalScrollBarVisibility="Hidden"
                                                                  ZoomMode="Disabled"
                                                                  AutomationProperties.AccessibilityView="Raw" />

                                                    <TextBlock x:Name="PlaceholderTextContentPresenter"
                                                               Text="{TemplateBinding PlaceholderText}"
                                                               Foreground="{ThemeResource TextControlPlaceholderForeground}"
                                                               IsHitTestVisible="False"
                                                               Visibility="Collapsed" />

                                                    <!-- 参数 "Parking"，步进 5、钳制 0~100 -->
                                                    <Button x:Name="DecButton"
                                                            Style="{StaticResource AppStepperButton}"
                                                            Width="18" Height="30"
                                                            Margin="2,0,0,0"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource TextControlBackground}"
                                                            FontSize="13"
                                                            Content="&#x2013;"
                                                            IsTabStop="False"
                                                            Opacity="0"
                                                            IsHitTestVisible="False"
                                                            Command="{TemplateBinding Tag}"
                                                            CommandParameter="Parking" />
                                                    <Button x:Name="IncButton"
                                                            Style="{StaticResource AppStepperButton}"
                                                            Width="18" Height="30"
                                                            Margin="0,0,2,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Background="{ThemeResource TextControlBackground}"
                                                            FontSize="13"
                                                            Content="+"
                                                            IsTabStop="False"
                                                            Opacity="0"
                                                            IsHitTestVisible="False"
                                                            Command="{TemplateBinding Header}"
                                                            CommandParameter="Parking" />
                                                </Grid>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                    <TextBlock x:Uid="Tuning_PercentUnit"
                                               Style="{StaticResource AppDesc}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </ContentControl>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ==================== 脏数据浮动保存条 ====================
             初始收起；显隐由 View 层 ShowDirtyBar / HideDirtyBar 驱动（x:Name 被 code-behind 引用）。 -->
        <Border x:Name="DirtyBar"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Background="{ThemeResource AppPopupBackgroundBrush}"
                BorderBrush="{ThemeResource AppAccentBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="18,10"
                Visibility="Collapsed">
            <Border.RenderTransform>
                <CompositeTransform x:Name="DirtyBarTransform" TranslateY="20" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Uid="Tuning_DirtyText"
                           FontSize="13"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0" />
                <Button x:Uid="Tuning_Discard"
                        Style="{StaticResource AppButton}"
                        Click="OnDiscardClick" />
                <Button x:Uid="Tuning_SaveOverwrite"
                        Style="{StaticResource AppButtonPrimary}"
                        Click="OnSaveClick" />
                <Button x:Uid="Tuning_SaveAs"
                        Style="{StaticResource AppButton}"
                        Click="OnSaveAsClick" />
            </StackPanel>
        </Border>

        <!-- ==================== 写入期遮罩 ====================
             吞指针事件：SMU 写入期间任何输入都会被下一次写入带上 -->
        <Grid Background="{ThemeResource AppScrimBrush}"
              Visibility="{x:Bind local:UiConverters.ToVisibleWhenTrue(ViewModel.IsBusy)}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                              Width="32" Height="32"
                              HorizontalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.BusyText, Mode=OneWay}"
                           FontSize="14" FontWeight="Medium"
                           Foreground="{ThemeResource AppTextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Uid="Tuning_RollbackHint"
                           Style="{StaticResource AppDesc}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
