<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zentwik.App.Views.AdvancedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,12,28,24" Spacing="16">

                <TextBlock Text="高级" Style="{StaticResource AppPageTitle}" Margin="0,10,0,2" />

                <!-- 圆角与卡片对齐，理由同调校页的 InfoBar -->
                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=TwoWay}"
                         IsClosable="True"
                         Severity="Informational"
                         Message="{x:Bind ViewModel.StatusText, Mode=OneWay}">
                    <InfoBar.Resources>
                        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                    </InfoBar.Resources>
                </InfoBar>

                <!-- ==================== 安全 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="安全" Style="{StaticResource AppCardTitle}" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="恢复出厂调校" Style="{StaticResource AppLabel}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="恢复"
                                    Style="{StaticResource AppButton}"
                                    Command="{x:Bind ViewModel.RestoreFactoryTuningCommand}" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="停用全部功能" Style="{StaticResource AppLabel}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="停用"
                                    Style="{StaticResource AppButton}"
                                    Command="{x:Bind ViewModel.DisableEverythingCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== 数据 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="数据" Style="{StaticResource AppCardTitle}" />

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="数据目录" Style="{StaticResource AppLabel}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="打开"
                                    Style="{StaticResource AppButton}"
                                    Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
                        </Grid>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="清除全部数据" Style="{StaticResource AppLabel}"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Content="清除"
                                    Style="{StaticResource AppButtonDanger}"
                                    Click="OnClearAllClick" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Grid Background="{ThemeResource AppScrimBrush}"
              Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                          Width="36" Height="36"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Page>
