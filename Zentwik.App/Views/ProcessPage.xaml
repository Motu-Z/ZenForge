<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Zentwik.App.Views.ProcessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Zentwik.App.ViewModels"
    xmlns:ctl="using:Zentwik.App.Controls"
    xmlns:local="using:Zentwik.App"
    Background="Transparent">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource AppContentPadding}">
            <StackPanel Spacing="16">

                <TextBlock Text="进程调度" Style="{StaticResource AppPageTitle}" Margin="0,0,0,8" />

                <InfoBar IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=TwoWay}"
                         IsClosable="True"
                         Severity="{x:Bind local:UiConverters.ToInfoBarSeverity(ViewModel.StatusLevel), Mode=OneWay}"
                         Title="{x:Bind ViewModel.StatusTitle, Mode=OneWay}"
                         Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}">
                    <InfoBar.Resources>
                        <CornerRadius x:Key="ControlCornerRadius">8</CornerRadius>
                    </InfoBar.Resources>
                </InfoBar>

                <!-- ==================== 运行中进程 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <StackPanel Spacing="12">

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="运行中进程"
                                       Style="{StaticResource AppCardTitle}" />
                            <Border Grid.Column="1" Style="{StaticResource AppPill}">
                                <TextBlock Text="{x:Bind ViewModel.ProcessCountText, Mode=OneWay}"
                                           Style="{StaticResource AppMeta}" />
                            </Border>

                            <Button Grid.Column="3"
                                    Content="{x:Bind ViewModel.WatcherButtonText, Mode=OneWay}"
                                    Style="{StaticResource AppButtonSmall}"
                                    Command="{x:Bind ViewModel.ToggleWatcherCommand}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.WatcherText, Mode=OneWay}" />

                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                                <TextBox Width="200"
                                         Style="{StaticResource AppTextBox}"
                                         PlaceholderText="搜索进程..."
                                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Content="应用规则"
                                        Style="{StaticResource AppButtonPrimary}"
                                        Command="{x:Bind ViewModel.ReapplyCommand}" />
                            </StackPanel>
                        </Grid>

                        <!-- 表头 5 列：进程 2 / 路径 4 / 占用 1 / 掩码 1.5 / 优先级 1.5 -->
                        <Grid ColumnSpacing="16" Padding="12,0,12,4"
                              Visibility="{x:Bind local:UiConverters.ToCollapsedWhenTrue(ViewModel.HasNoProcesses), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="1.5*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="进程名" Style="{StaticResource AppTableHeader}" />
                            <TextBlock Grid.Column="1" Text="路径" Style="{StaticResource AppTableHeader}" />
                            <TextBlock Grid.Column="2" Text="占用" Style="{StaticResource AppTableHeader}" />
                            <TextBlock Grid.Column="3" Text="核心掩码" Style="{StaticResource AppTableHeader}" />
                            <TextBlock Grid.Column="4" Text="优先级" Style="{StaticResource AppTableHeader}" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource AppCardBorderBrush}"
                                Visibility="{x:Bind local:UiConverters.ToCollapsedWhenTrue(ViewModel.HasNoProcesses), Mode=OneWay}" />

                        <Border Style="{StaticResource AppInnerPanel}"
                                Visibility="{x:Bind ViewModel.HasNoProcesses, Mode=OneWay}">
                            <TextBlock Text="未取到运行中的进程（后台监听未启动时列表为空）"
                                       Style="{StaticResource AppDesc}"
                                       HorizontalAlignment="Center" />
                        </Border>

                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="0" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessRowViewModel">
                                    <Border BorderThickness="0,0,0,1"
                                            BorderBrush="{ThemeResource AppCardBorderBrush}">
                                        <Grid ColumnSpacing="16" Padding="12,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="4*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.5*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxLines="1" />
                                                <TextBlock Text="{x:Bind PidText, Mode=OneWay}"
                                                           Style="{StaticResource AppMeta}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind PathText, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxLines="1" />

                                            <TextBlock Grid.Column="2"
                                                       Text="{x:Bind CpuText, Mode=OneWay}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource AppTextSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <ctl:AppComboBox Grid.Column="3"
                                                             Height="26"
                                                             Padding="8,0"
                                                             VerticalAlignment="Center"
                                                             ItemsSource="{x:Bind TargetOptions, Mode=OneWay}"
                                                             SelectedIndex="{x:Bind TargetIndex, Mode=TwoWay}" />

                                            <ctl:AppComboBox Grid.Column="4"
                                                             Height="26"
                                                             Padding="8,0"
                                                             VerticalAlignment="Center"
                                                             ItemsSource="{x:Bind PriorityOptions, Mode=OneWay}"
                                                             SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

                <!-- ==================== 已保存规则 ==================== -->
                <Border Style="{StaticResource AppCard}">
                    <StackPanel Spacing="12">

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="已保存规则" Style="{StaticResource AppCardTitle}" />
                            <Border Grid.Column="1" Style="{StaticResource AppPill}">
                                <TextBlock Text="{x:Bind ViewModel.RulesCountText, Mode=OneWay}"
                                           Style="{StaticResource AppMeta}" />
                            </Border>
                        </Grid>

                        <TextBlock Text="暂无已保存规则。在上方为进程选择绑定目标即可自动建立规则。"
                                   Style="{StaticResource AppDesc}"
                                   Visibility="{x:Bind ViewModel.IsRulesEmpty, Mode=OneWay}" />

                        <StackPanel Spacing="0" Visibility="{x:Bind ViewModel.HasRules, Mode=OneWay}">
                            <!-- 操作列固定 190：三个动作按钮不换行，且与表头严格同列 -->
                            <Grid ColumnSpacing="16" Padding="12,0,12,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="190" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="进程" Style="{StaticResource AppTableHeader}" />
                                <TextBlock Grid.Column="1" Text="目标" Style="{StaticResource AppTableHeader}" />
                                <TextBlock Grid.Column="2" Text="优先级" Style="{StaticResource AppTableHeader}" />
                                <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource AppTableHeader}"
                                           HorizontalAlignment="Center" />
                            </Grid>

                            <Border Height="1" Background="{ThemeResource AppCardBorderBrush}" />

                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Rules, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Spacing="0" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RuleRowViewModel">
                                        <Border BorderThickness="0,0,0,1"
                                                BorderBrush="{ThemeResource AppCardBorderBrush}">
                                            <Grid ColumnSpacing="16" Padding="12,9">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="190" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxLines="1" />
                                                    <TextBlock Text="{x:Bind MatchingText, Mode=OneWay}"
                                                               Style="{StaticResource AppMeta}" />
                                                </StackPanel>

                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind TargetLabel, Mode=OneWay}"
                                                           Style="{StaticResource AppLabel}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind PriorityLabel, Mode=OneWay}"
                                                           Style="{StaticResource AppDesc}"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis" />

                                                <!-- TextWrapping=NoWrap 是硬要求：窄窗口下换行会让整行高度跳变 -->
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            Spacing="6"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    <Button Content="禁用"
                                                            Style="{StaticResource AppButtonSmall}"
                                                            Command="{x:Bind ToggleCommand}"
                                                            Visibility="{x:Bind IsEnabled, Mode=OneWay}" />
                                                    <Button Content="启用"
                                                            Style="{StaticResource AppButtonSmallPrimary}"
                                                            Command="{x:Bind ToggleCommand}"
                                                            Visibility="{x:Bind IsDisabled, Mode=OneWay}" />
                                                    <Button Content="应用"
                                                            Style="{StaticResource AppButtonSmallPrimary}"
                                                            Command="{x:Bind ApplyCommand}" />
                                                    <Button Content="删除"
                                                            Style="{StaticResource AppButtonSmallDanger}"
                                                            Command="{x:Bind DeleteCommand}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
