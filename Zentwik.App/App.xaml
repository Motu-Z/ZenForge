<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Zentwik.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WinUI 3 不自带控件样式，不合并这一份则所有控件都是裸的默认模板。 -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

                <!-- 顺序有意义：Tokens 定义全部令牌，Typography / Controls 只引用它。
                     Controls 必须最后合并，它的隐式样式要覆盖系统控件默认样式。 -->
                <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Typography.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
