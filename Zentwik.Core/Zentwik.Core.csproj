<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================
    Zentwik.Core —— 纯业务逻辑，零 WPF 依赖
    ============================================================

    【这条红线怎么保证】
    1. 不写 UseWPF / UseWindowsForms。没有这两个属性，SDK 不会引入
       PresentationFramework / WindowsBase / System.Drawing，代码里只要出现
       System.Windows.* 就直接编译失败 —— 红线是编译器守的，不是靠自觉。
    2. TargetFramework 用 net10.0-windows 而不是 net10.0：P/Invoke 与注册表
       在哪个 TFM 都能跑，但 System.Management（WMI）与 registry API 的可用性
       标注在 windows TFM 上，换成跨平台 TFM 会引入一堆 CA1416 平台警告。
       注意：net10.0-windows **不含** WPF，只有 UseWPF=true 才会把 WPF 装进来。
    3. 想验证这条红线，敲一行就够：
           dotnet build Zentwik.Core -c Release
       只要有人往这里塞了一个 System.Windows 类型，这一步会当场红。

    【为什么 DI 容器不在这里（也不在 App 里）】
    v1.2.0 起 WPF 线进入封版状态，后续迁 WinUI 3。此时引入容器或 EventBus，
    等于让即将被重写的 UI 层多一层需要拆的抽象 —— 这一轮刻意保持静态类 +
    显式传参，迁移时逐类搬过去即可。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zentwik.Core</RootNamespace>
    <AssemblyName>Zentwik.Core</AssemblyName>
    <LangVersion>latest</LangVersion>

    <!-- 与主程序共用同一套版本号口径（见 Zentwik.csproj 的注释） -->
    <Version>2.0.0-can3</Version>
    <FileVersion>2.0.0.0</FileVersion>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>

    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>

    <!--
      ============================================================
      Native AOT / 裁剪
      ============================================================

      【IsAotCompatible 而不是 PublishAot】
      PublishAot 只对可执行项目生效；项目类型是库时设了也只会被忽略，
      但它会静默改变下游行为，看起来像配置生效了。库的正确开关是
      IsAotCompatible —— 它会启用裁剪、AOT、单文件三个分析器，
      并在构建期把「会在 AOT 下抛异常」的写法直接报成警告。

      【AllowUnsafeBlocks 为什么必须开】
      LibraryImport 的源生成器不接受 ByValTStr 字符串字段，也不接受
      StringBuilder 参数。这两处在进程快照里都是高频路径，只能改成定长
      char 缓冲区与 char* —— 两者都在 unsafe 上下文里。这不是「为了性能
      放开指针」，是源生成封送的能力边界。
    -->
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!--
      让主程序能访问 internal 成员（MaskNamePolicy / MemoryTrimmer 这类）。
      不给它们加 public：这些是「只给本产品用」的实现细节，一旦公开就成了
      WinUI 3 迁移时不敢动的对外契约。InternalsVisibleTo 的代价是 Core 知道
      调用方程序集名，收益是公开面保持最小。
    -->
    <InternalsVisibleTo Include="Zentwik" />

    <!-- AOT 探针需要访问 AppJsonContext（internal）与 MemoryTrimmer（internal）
         才能把这两条路径也纳入原生编译验证。只在构建期存在，不随产品发布。 -->
    <InternalsVisibleTo Include="Zentwik.AotProbe" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ============================================================
      SMU 读写：ZenStates-Core 1.93.1（本地 DLL 引用，不走 NuGet）
      ============================================================

      【为什么不走包】
      1.93.1 是上游最新源码手工编译出来的，NuGet 上还没有对应版本；
      而这条通道直接决定 CO / FMax 能不能写进 SMU，版本必须锁死在
      一个我们验证过的具体二进制上，不能让还原时被浮动的包版本带走。

      【HintPath 的由来】
      解压包里有两份资产：netstandard2.1 / net8.0-windows（1.93.1-AOT 起
      已按约定移除 net20）。这里取 net8.0-windows —— 它是唯一一份带 Windows
      专属 API（注册表、ServiceController、Security.AccessControl）的构建，
      netstandard2.1 那份会在运行时抛 PlatformNotSupported。
      本工程是 net10.0-windows，向下兼容 net8.0 资产。

      【1.92.4 → 1.93.1 的破坏性变化（已在 SmuReader 适配）】
      · Cpu 不再有无参构造，必须传 CoreOptions：new Cpu(CoreOptions.Current)
      · SendTestMessage(uint arg = 0, Mailbox mbox = null) 两个参数都可选，
        cpu.SendTestMessage() 的老写法仍然有效
      · 拓扑字段、smu.Rsmu.SMU_MSG_* 消息号、SetPsmMarginSingleCore /
        GetPsmMarginSingleCore / MakeCoreMask / GetFMax / SetFMax 全部未变

      【WinIo32.dll 为什么要一起带】
      1.93.1 的 IODriver 在 PawnIO 缺位时会回退到 WinIo/inpOut 端口访问，
      它是按文件名 LoadLibrary 的。驱动就绪时用不到它，但缺了会在
      「没装 PawnIO 的机器」上把错误信息变成一句含糊的 FileNotFound。
      45KB 换一条可读的降级路径，值。 -->
    <Reference Include="ZenStates-Core">
      <HintPath>..\libs\ZenStates-Core\ZenStates-Core.dll</HintPath>
      <Private>true</Private>
    </Reference>

    <!--
      防止裁剪器把 SMU 通信库整体去掉。

      【为什么这一条不能省】
      ZenStates-Core 是裸 DLL 引用，没有裁剪标注，编译器无法从调用点推断
      它的内部结构是否被用到。一旦 SDK 判定某个类型「未被引用」，
      裁剪后运行时就只能在 new Cpu() 处拿到 TypeLoadException，
      而发布过程本身不会报任何错 —— 这是最难排查的一类故障。

      【它做不到什么】
      这一条只保证程序集不被整份裁掉，管不了程序集内部的动态行为。
      真正的验证只有一条：AOT 产物里跑通一次 SendMessageTest。
    -->
    <TrimmerRootAssembly Include="ZenStates-Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- 原生依赖与主程序同目录落地（ProjectReference 的 content 会传递到 App 输出）。

         ExcludeFromSingleFile 是必需的：不写这一条，单文件发布会把这个原生 DLL
         一并塞进 exe，运行时解到 %TEMP%\.net\... 里，而 ZenStates-Core 是按
         「文件名」自己 LoadLibrary("WinIo32.dll") 的 —— 它只认 exe 所在目录与
         PATH，找不到解包目录，等于白带。
         代价是发布产物从「一个 exe」变成「exe + 45KB 的 DLL」，但这比留一个
         永远加载不上的降级路径要好。

         CopyToPublishDirectory 与 CopyToOutputDirectory 两条都要写：
         前者管 dotnet publish，后者管 dotnet build 后的就地调试，
         只写一条会让其中一种场景缺文件。 -->
    <None Include="..\libs\ZenStates-Core\WinIo32.dll" Link="WinIo32.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />

    <!--
      驱动与固件类资源（.sys / .bin）的通配规则。

      【当前基线里没有这两类文件，别以为漏了】
      扫描过 libs\ZenStates-Core 与整个仓库：只有 WinIo32.dll 与
      ZenStates-Core.dll 两个二进制。ZenStates-Core 内部硬编码的驱动路径是
      C:\Windows\System32\drivers\inpoutx64.sys 与 PawnIO 的服务注册表项，
      两者都由各自安装程序落到系统目录，不是随包发布的资源。
      也就是说 .sys 从来不该出现在发布目录里 —— 把驱动塞进应用目录，
      Windows 也不会从那里加载未签名的内核模块。

      这条规则留着的用途是「将来替换 ZenStates-Core.dll 时，如果上游改成
      自带驱动包，把文件丢进 libs\ZenStates-Core 就会自动随包输出」，
      而不是现在有什么文件需要它。 -->
    <None Include="..\libs\ZenStates-Core\**\*.sys;..\libs\ZenStates-Core\**\*.bin"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- WMI：只剩 ProcessWatcher 自己的进程快照与事件订阅在用。
         ZenStates-Core 1.93.1-AOT 起已剥离 System.Management，
         这条引用不再为它存在。 -->
    <PackageReference Include="System.Management" Version="9.0.0" />

    <!--
      WmiLight：ZenStates-Core 1.93.1-AOT 的新依赖。

      【为什么必须显式引】
      ZenStates-Core.dll 是裸 DLL 引用，没有 nuspec，它的依赖链不会传递过来。
      运行到 SMU 初始化时，WmiLight.dll 找不到就是一条裸 FileNotFoundException，
      而且只会在真正调 SMU 的机器上才炸 —— 开发机跑探针根本触发不到。

      【为什么连原生库一起要】
      7.3.0 起 WmiLight 把自己拆成托管壳 + WmiLight.Native.dll（按 RID 分发），
      包内 runtimes/win-*/native 下各一份。PackageReference 会按 RuntimeIdentifier
      自动铺到输出根目录，不要手写 None 拷贝，否则会和 SDK 的 RID 资产解析打架。

      【版本对齐】
      程序集引用是 WmiLight, Version=7.3.0.0，包版本必须是 7.3.0。
      低一个次版本在绑定检查上不会立刻报错（.NET Core 会向上兼容），
      但 7.2 的托管壳配 7.3 的原生库是错配，只会在调用期崩。
    -->
    <PackageReference Include="WmiLight" Version="7.3.0" />

    <!-- Microsoft.Win32.SystemEvents：PowerStatusWatcher 的电源模式通知。
         这个包在 windows 桌面 TFM 下由 WindowsDesktop 框架自带，Core 不引用
         WindowsDesktop，所以要显式声明。 -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="9.0.0" />

    <!-- System.ServiceProcess.ServiceController：SmuReader 里唤醒 PawnIO 服务用。
         以前是 LLT.ZenStates-Core 包传递带进来的，改成 DLL 引用后传递链断了，
         必须显式声明，否则 using System.ServiceProcess 直接编译失败。 -->
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="9.0.0" />

    <!-- 只引 Abstractions，不引完整 DI 容器：Core 负责「按什么生命周期登记」，
         容器本身由宿主创建。引完整包会把 ServiceProvider 实现拖进 Core，
         等于让业务层拥有一个可以随手解析任意服务的入口。 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.0" />
  </ItemGroup>

</Project>
