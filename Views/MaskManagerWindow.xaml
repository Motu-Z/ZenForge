<Window x:Class="Zentwik.Views.MaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="管理自定义掩码"
        Width="780"
        Height="540"
        MinWidth="660"
        MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Window.Background}"
        FontFamily="{StaticResource AppFontFamily}"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        FocusVisualStyle="{x:Null}">

    <!-- 无边框 + 自绘标题栏。
         CaptionHeight 必须为 0：只要非零，系统就把这一条当 HTCAPTION 吃掉
         WM_NCLBUTTONDOWN，自绘标题栏上的 DragMove 永远不会触发。
         ResizeBorderThickness=6 留出边缘拉伸热区，窗口仍可自由缩放。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 行内改名输入框。
             必须把 AppTextBoxStyle 自带的 Height=36 顶掉：列表行固定 40px 高，
             36px 的框塞进去会把整行撑高，表现为「编辑某一行时上下几行集体跳一下」。
             Padding 也要改：文字必须与只读态 TextBlock 的起点对齐，
             否则一进编辑态文字就向右蹿。 -->
        <Style x:Key="RowNameBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ==================================================================
             【核心勾选框：自绘深色方块】

             不用系统 CheckBox 的两个原因：
               1. 系统模板的方块是浅底 + 蓝色勾，在 #121214 的深色卡片上像贴了
                  一块白补丁，而且那个蓝不跟随主题强调色。
               2. 系统模板的命中区域只有方块本身（约 13×13），文字部分点不中。
                  这类要连点几十次的批量选择，命中区小是纯粹的折磨。

             这里保留 CheckBox 类型（只换 ControlTemplate）：
             MaskManagerWindow.xaml.cs 里有 6 处 foreach (CheckBox box in _allBoxes)，
             换成 ToggleButton 子类会让这些循环的隐式转换失败。保留类型 = 零侵入。

             视觉规格：
               方块 16×16 / 圆角 4 / 未选 1px 灰边透明底 / 选中 强调色实底 + 深色勾
               勾用 Path 画（矢量），不用字体符号 —— 字体回退会出豆腐块。
               整行可点：Border 包住 [方块 + 文字]，Padding 撑出命中区。
             ================================================================== -->
        <Style x:Key="CoreCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="2,3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 方块本体 -->
                                <Border x:Name="Box"
                                        Width="16" Height="16"
                                        CornerRadius="4"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource Input.BorderHover}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="Tick"
                                          Data="M 3,8.5 L 6.5,12 L 13,4"
                                          Width="10" Height="8"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource AccentTextBrush}"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Visibility="Collapsed"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                                </Border>

                                <ContentPresenter x:Name="Label"
                                                  Margin="8,0,0,0"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="False"/>
                            </StackPanel>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 悬停：只提边框，不填底色。
                                 预先填成浅强调色会让用户误以为「已经选中了」。 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>

                            <!-- 选中：强调色实底 + 深色勾 + 强调色边。
                                 描边与填充同色，方块看起来是一个实心圆角块，
                                 没有「双层边」的脏感。 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>

                            <!-- 禁用：整体降透明度，不换色（换色会让人以为是另一种状态） -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 根 Border 出圆角：WindowChrome 下窗口本体是直角，圆角只能由内容层给。
         不用 AllowsTransparency（那会让整个窗口走软件渲染，缩放时发糊）。 -->
    <Border Background="{DynamicResource Window.Background}"
            BorderBrush="{DynamicResource Card.Border}"
            BorderThickness="1"
            CornerRadius="10"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===================== 标题栏（可拖动） =====================
                 【1.0.3 精简】
                 原来这里是「圆形齿轮图标 + 标题 + 副标题」三件套，占了整整两行，
                 而副标题那句「勾选要绑定的核心 / 线程，保存后可在调度页直接选用」
                 是在替用户读第二遍 —— 界面里已经写着「选择核心 / 线程」了。
                 现在只剩标题 + 关闭按钮，标题放大到 20 当作这一窗的主标题。 -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    Padding="20,16,20,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="管理自定义掩码"
                               FontSize="20"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Primary}"/>

                    <!-- 关闭按钮 26×26（原 30×28）：窗口右上角的辅助动作，
                         不该和主标题抢视觉重量。 -->
                    <Button Grid.Column="1"
                            Width="26" Height="26"
                            Style="{StaticResource WindowButtonStyle}"
                            ToolTip="关闭"
                            Click="Close_Click">
                        <Path Data="M 5,5 L 13,13 M 13,5 L 5,13"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===================== 主体：左栏 220 / 右区自适应 ===================== -->
            <Grid Grid.Row="1" Margin="20,16,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 左栏：已保存掩码列表 ===== -->
                <Border Grid.Column="0"
                        Background="{DynamicResource List.Background}"
                        BorderBrush="{DynamicResource Input.Border}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 标题 + 计数（「3 / 10」比纯文字更能表达还剩几个名额） -->
                        <Grid Grid.Row="0" Margin="14,12,12,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="已保存的掩码"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="MaskCountText"
                                       Grid.Column="1"
                                       FontSize="11"
                                       Margin="8,0,0,0"
                                       Foreground="{DynamicResource Text.MetaBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 列表行：固定 40 高。
                             不用 Stretch 平分高度 —— ListBoxItem 在
                             VirtualizingStackPanel 里不会纵向拉伸，写了也无效。
                             固定行高反而让「悬停/选中/改名」三种状态的行高完全一致。 -->
                        <ListBox x:Name="MaskList"
                                 Grid.Row="1"
                                 ScrollViewer.CanContentScroll="True"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource Text.Primary}"
                                 VerticalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FocusVisualStyle="{x:Null}"
                                 SelectionChanged="MaskList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="MaskList_PreviewMouseLeftButtonDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="6,0,6,1"/>
                                    <Setter Property="Height" Value="40"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        CornerRadius="6"
                                                        Padding="10,0">
                                                    <ContentPresenter VerticalAlignment="Center"
                                                                      HorizontalAlignment="Stretch"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource List.Hover}"/>
                                                    </Trigger>
                                                    <!-- 选中：降到底色，不刷强调色。
                                                         左栏是导航性质，整行刷强调色会和右侧
                                                         勾选框的强调色打架，看不出哪边才是「当前操作区」。 -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background"
                                                                Value="{DynamicResource Nav.Button.Active}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <!-- 名称就地编辑：平时是 TextBlock，点一下换成 TextBox，
                                         回车 / 失焦即确认。所以右侧没有独立的「名称」输入框。 -->
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock x:Name="RowNameText"
                                                   Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Binding Name}"
                                                   Cursor="IBeam"
                                                   Foreground="{DynamicResource Text.Primary}"
                                                   MouseLeftButtonUp="RowName_Click"/>

                                        <TextBox x:Name="RowNameBox"
                                                 Style="{StaticResource RowNameBoxStyle}"
                                                 Visibility="Collapsed"
                                                 KeyDown="RowNameBox_KeyDown"
                                                 TextChanged="RowNameBox_TextChanged"
                                                 LostKeyboardFocus="RowNameBox_LostKeyboardFocus"/>

                                        <!-- 删除按钮：叠在右侧，不占列宽。
                                             行底色是 Transparent，直接叠会透出文字，
                                             所以配一段左透明的渐变衬底（Row.FadeBrush）
                                             把底下的字盖住，长名称被截断时也不会出现硬边。 -->
                                        <Border x:Name="RowDeleteHost"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Padding="12,0,0,0"
                                                Background="{DynamicResource Row.FadeBrush}"
                                                Visibility="Collapsed">
                                            <Button x:Name="RowDeleteBtn"
                                                    Style="{StaticResource IconDeleteButtonStyle}"
                                                    ToolTip="删除"
                                                    Click="RowDelete_Click">
                                                <Path Data="M3,4 L13,4 M6,4 L6,2.5 A1,1 0 0 1 7,1.5 L9,1.5 A1,1 0 0 1 10,2.5 L10,4
                                                           M4.5,4 L5.2,13.2 A1,1 0 0 0 6.2,14.2 L9.8,14.2 A1,1 0 0 0 10.8,13.2 L11.5,4
                                                           M7,6.5 L7,11.8 M9,6.5 L9,11.8"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Width="16" Height="16"
                                                      Stretch="None"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                            </Button>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsMouseOver,
                                                      RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                            Value="True">
                                            <Setter TargetName="RowDeleteHost" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 新建：贴在列表底部，与列表同宽，视觉上就是「最后一行」 -->
                        <Button x:Name="NewButton" Grid.Row="2"
                                Content="新建"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch"
                                MinWidth="0"
                                Margin="6,8,6,8"
                                Padding="6,0"
                                FontSize="12"
                                ToolTip="新建一条自定义掩码（最多 10 套）"
                                Click="New_Click"/>
                    </Grid>
                </Border>

                <!-- ===== 右区：选择核心 ===== -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="选择核心 / 线程"
                               Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,10"/>

                    <!-- 三个快捷按钮：等分铺满。
                         用 Stretch + MinWidth=0 而不是固定宽 —— 窗口窄时一起等比缩，
                         不会出现「三枚按钮互相压住、文字叠在一起」。 -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="全部核心" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch" MinWidth="0" Padding="10,0" Margin="0"
                                Click="SelectAll_Click"/>
                        <Button Grid.Column="2" Content="物理核心" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch" MinWidth="0" Padding="10,0" Margin="0"
                                Click="SelectPhysCore_Click"/>
                        <Button Grid.Column="4" Content="反向选择" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Stretch" MinWidth="0" Padding="10,0" Margin="0"
                                Click="Invert_Click"/>
                    </Grid>

                    <!-- 勾选区：整块纵向滚动，横向不滚（内容自己折行）。
                         右侧留 12 给竖向滚动条，避免它压在最后一列勾选框上。 -->
                    <ScrollViewer x:Name="CoreScroll" Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,12,0"
                                  SizeChanged="CoreScroll_SizeChanged">
                        <StackPanel x:Name="CorePanel"/>
                    </ScrollViewer>

                    <!-- 取消 / 保存。
                         保存用主按钮（v2 淡底 + 强调色边），因为它是这个窗口
                         唯一的完成动作；取消保持次要按钮，两者重量差异明确。 -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Content="取消"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="96"
                                Margin="0,0,8,0"
                                Click="Close_Click"/>
                        <Button Content="保存"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="96"
                                Margin="0"
                                Click="Save_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
