<UserControl x:Class="Zentwik.Views.ProcessBindingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Zentwik.Views"
      xmlns:ctl="clr-namespace:Zentwik.Controls"
      xmlns:helpers="clr-namespace:Zentwik.Helpers"
      FontFamily="{StaticResource AppFontFamily}"
      FontSize="13"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <!--
        ============================================================
        进程页版式规格（v14）
        ============================================================
        模块一「运行中进程」
          卡头：左 16px 标题 / 右 [搜索框 180×32] [管理掩码] [应用规则]
          自绘表头：5 列 —— 进程名 / 路径 / 占用 / 核心掩码 / 优先级
                 进程名:路径 = 3:7
          数据行：同一套列宽，hover 铺 6% 白

        模块二「已保存规则」
          卡头：左「标题 + 徽章」/ 右「清空所有规则」
          自绘四列 —— 进程名（吃满）/ 核心掩码 / 优先级 / 操作

        【为什么不用 ListView + GridView】
          v12 的表头是「10px 微标签、无底无边、与数据行同列宽配比」，
          GridView 的列头模板做不到 1* / 4* 这类弹性配比，
          还得额外写列宽同步代码（上一版 ApplyColumnWidths 就是干这个的）。
          ItemsControl + 两套独立 Grid 列定义之后，配比一致即可对齐，
          宽度自适应交给布局引擎，那段去抖代码整体删掉。

        【对齐约定（这次统一的三条）】
          1. 表头与数据行 Padding 都是 12：第一列左缘永远对齐。
             列间只靠列定义宽度自带的间隔，不再给单元格加左右 Margin
             —— 加了必然与表头错开。
          2. 行内控件高度唯一口径：搜索框 32、表格内下拉 28、行内按钮 28。
             以前搜索框 32、下拉 28 是随意的，现在 28 的依据是「行高 48 - 上下各 10」，
             下拉与行内按钮同高，一行里不会有三种高度。
          3. 卡内标题一律 CardTitleStyle（15/SemiBold），
             不再单独写 FontSize=16 绕开层级 —— 那样标题会比别的页大一号。
    -->

    <UserControl.Resources>
        <!-- 优先级档位：数据是英文常量（落盘值），显示是中文。见 PriorityLabelConverter。 -->
        <helpers:PriorityLabelConverter x:Key="PriorityLabel"/>

        <!-- 行间距：2px 让相邻两行的圆角 hover 底之间留一条缝，读起来不粘成一块 -->
        <Style x:Key="ProcRowGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <!-- 表格内下拉：28 高、字号 12、内边距 8。
             以前每个 ComboBox 手抄一遍 Height/FontSize/Padding，
             五处写五遍，改一处漏四处。

             【必须 BasedOn 全局 AppComboBoxStyle】
             一旦写了 TargetType="ComboBox" 但不 BasedOn，
             这个显式样式就完全接管了该控件，隐式样式（深色模板）不再生效，
             控件会退回系统默认的浅灰 ComboBox —— 深色界面上直接白成一片。
             这里只覆盖尺寸，模板与配色一律继承。 -->
        <Style x:Key="TableCellComboStyle" TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- 下拉项文本一律单行省略：自定义掩码名可能是「CCD0 物理核 0-7」这种长串，
                 以前没有 TextTrimming，长名字会被下拉框右缘直接切掉半个字，
                 看起来像「这行选了个残缺的值」。 -->
            <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- 规则行末尾的操作按钮：定宽 72、高 28，三个并排等距。
             去掉 Padding：八个字符的按钮文字由内容居中即可，
             留 16px 内边距会把 72 宽的按钮挤成两行。 -->
        <Style x:Key="RuleActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,6,28,24">

            <!-- ======= 页头 ======= -->
            <TextBlock Text="进程" Style="{StaticResource PageTitleStyle}"/>

            <!-- ======= CPU Sets 拓扑不可用提示（默认隐藏，读取失败时显示） =======
                 不用 ⚠️ emoji：Windows 上 emoji 走彩色字形，
                 在同一行里与正文的字号/基线都对不齐，还会把整行撑高。
                 改成一个三角图标 + 文字，颜色已经是危险色，图标只是加强辨识。 -->
            <Border x:Name="TopologyWarningBanner"
                    Visibility="Collapsed"
                    Background="{DynamicResource DangerSoft}"
                    BorderBrush="{DynamicResource Danger}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0"
                          Width="14" Height="14"
                          VerticalAlignment="Top"
                          Margin="0,2,10,0"
                          Stretch="Uniform"
                          Stroke="{DynamicResource Danger}"
                          StrokeThickness="1.4"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 8,1.5 L 15,14 L 1,14 Z M 8,6.2 L 8,10 M 8,11.8 L 8,12"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="无法读取系统 CPU Sets 拓扑，无损调度不可用"
                                   Foreground="{DynamicResource Danger}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TopologyWarningDetail"
                                   Foreground="{DynamicResource Danger}"
                                   Opacity="0.75"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== 模块一：运行中进程 ===== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>

                    <!-- 卡头 -->
                    <Border Style="{StaticResource CardHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="运行中进程"
                                       Style="{StaticResource CardTitleStyle}"
                                       VerticalAlignment="Center"
                                       Margin="0"/>

                            <!-- 搜索框 + 两个按钮：间距统一 8，与设置页的按钮间距一致 -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">

                                <!-- 搜索框统一用 zenforge:SearchBox（见 Themes/SearchBox.xaml）。
                                     它自己负责图标 / 文本 / 占位符的列布局与内缩，
                                     页面里只给宽度和事件 —— 不再出现「哪个 Margin 管哪一段」。 -->
                                <ctl:SearchBox x:Name="SearchBox"
                                               Width="200"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Placeholder="搜索进程..."
                                               InputKeyDown="SearchBox_KeyDown"/>

                                <Button Content="管理掩码"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,8,0"
                                        Click="ManageMasks_Click"/>

                                <Button x:Name="ApplySavedButton" Content="应用规则"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0"
                                        Click="ApplySaved_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 自绘表头。Padding 12 与数据行一致，第一列左缘对齐。 -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="128"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="5" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="7*"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="128"/>
                                </Grid.ColumnDefinitions>
                                <!-- 可排序列头。统一点击行为：
                                     点同一列 = 切换升降；点别的列 = 切到该列默认方向。
                                     箭头由 UpdateSortHeaders 写入，非排序列不带箭头，
                                     点击后立刻重排一帧（不受「正在操作」让位逻辑推迟）。 -->
                                <TextBlock x:Name="NameHeaderText"
                                           Grid.Column="0"
                                           Text="进程名"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Cursor="Hand"
                                           Tag="Name"
                                           ToolTip="点击按进程名排序"
                                           MouseLeftButtonUp="SortHeader_MouseLeftButtonUp"/>
                                <TextBlock x:Name="PathHeaderText"
                                           Grid.Column="1"
                                           Text="路径"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Margin="0,0,16,0"
                                           Cursor="Hand"
                                           Tag="Path"
                                           ToolTip="点击按路径排序"
                                           MouseLeftButtonUp="SortHeader_MouseLeftButtonUp"/>
                                <TextBlock x:Name="CpuHeaderText"
                                           Grid.Column="2"
                                           Text="占用 ▼"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Cursor="Hand"
                                           Tag="Cpu"
                                           ToolTip="点击切换排序方向（当前：从高到低）"
                                           MouseLeftButtonUp="SortHeader_MouseLeftButtonUp"/>
                                <!-- 核心掩码按「下拉里显示的顺序」排：不绑定 → CCD0 → CCD1 →
                                     自定义掩码（按用户定义的先后）。不是按字母序，也不是按
                                     位掩码数值 —— 位掩码是多值位串，本身没有大小关系；
                                     而用户认的是自己排的那份列表。 -->
                                <TextBlock x:Name="MaskHeaderText"
                                           Grid.Column="3"
                                           Text="核心掩码"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Margin="0,0,10,0"
                                           Cursor="Hand"
                                           Tag="Mask"
                                           ToolTip="点击按掩码排序（顺序同下拉列表）"
                                           MouseLeftButtonUp="SortHeader_MouseLeftButtonUp"/>
                                <TextBlock x:Name="PriorityHeaderText"
                                           Grid.Column="4"
                                           Text="优先级"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Margin="0,0,10,0"
                                           Cursor="Hand"
                                           Tag="Priority"
                                           ToolTip="点击按优先级排序"
                                           MouseLeftButtonUp="SortHeader_MouseLeftButtonUp"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 数据区。固定高 320，超出内滚。
                         外层 ScrollViewer 已经是页面级滚动，这里必须再套一个内层：
                         进程可能上百，不内滚会把整页撑成几千像素。 -->
                    <Grid Height="320">
                        <!-- 【虚拟化三件套】
                             ScrollViewer.CanContentScroll=True + VirtualizingStackPanel.IsVirtualizing
                             + VirtualizationMode=Recycling，缺一不可：
                             CanContentScroll 为 False（默认物理滚动）时，
                             ItemsControl 会把每一项都实测高度，虚拟化直接失效。
                             Recycling 而非 Standard：Standard 每次滚动都新建容器
                             （下拉框 + 3 个 TextBlock），复用能降一个数量级的分配。 -->
                        <ItemsControl x:Name="ProcessListView" Focusable="False"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <!-- 【虚拟化必须自己写 Template + ItemsPanel，缺一即失效】

                                 原来这里是「手写 ScrollViewer 包住 ItemsControl」。
                                 那种写法在视觉上看不出问题，但虚拟化是**完全不生效**的：
                                 VirtualizingStackPanel 靠 IScrollInfo 找滚动宿主，
                                 而手写 ScrollViewer 的 Content 是 ItemsControl 而不是
                                 ItemsPresenter，面板和滚动宿主之间断了一环。结果是
                                 「所有行一次性实例化」——每行含一个 ComboBox（内部还有
                                 Popup、ScrollViewer、Border 一整套模板），三百行就是
                                 十几 MB 常驻内存 + 一次几百毫秒的布局。

                                 正确结构：Template 里放 ScrollViewer + ItemsPresenter，
                                 ItemsPanel 显式换成 VirtualizingStackPanel。
                                 CanContentScroll=True 仍然必填：为 False 时是物理滚动，
                                 面板会被测成全部高度，虚拟化再次失效。 -->
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <!-- 【ItemsPanel 换成 SmoothSortPanel】
                                 它继承 VirtualizingStackPanel，虚拟化与 Recycling 一律照旧，
                                 只是多做了「重排时把渲染位置拉回旧位置再动画归零」这一件事。
                                 占用列的值每抖一下行就换一次位，没有过渡时那一下是硬切：
                                 用户盯着的行会在两次刷新之间瞬移。 -->
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ctl:SmoothSortPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 行底色走 Style + DataTrigger，不靠代码改 Background：
                                             虚拟化 Recycling 会复用容器，命令式设过的颜色不会自动复原，
                                             选中色就会跟着滚动条跑到别的行上。 -->
                                        <!-- TextHintingMode=Animated：重排过渡期间行会带 RenderTransform 位移，
                                             默认 Fixed 的 hinting 每帧按像素网格重算字形，文字会在位移中
                                             「抖一下」；Animated 让动画期间的字形保持稳定，代价只是略柔一点。
                                             只对会位移的行开，静止的页面文本仍是 Fixed。 -->
                                        <Border x:Name="Row"
                                                TextOptions.TextHintingMode="Animated"
                                                MouseLeftButtonDown="ProcessRow_MouseLeftButtonDown">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource ProcessRowStyle}">
                                                    <Style.Triggers>
                                                        <!-- 放在最后：选中行的底色要压过 ProcessRowStyle 里的
                                                             悬停色，否则鼠标扫过去就看不出哪行是选中的。

                                                             【用中性档，不用强调色】
                                                             原先这里是 AccentSoftBrush（强调色 15% 透明度），
                                                             选中一行就是一块亮蓝，在低饱和的深色界面里非常刺眼，
                                                             而且强调色本来只该给「边框 / 开关开启态 / 滑块」。
                                                             现在改成与日志页同一档中性选中底（8% 白），
                                                             文字与描边保持各自的语义色。 -->
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource Nav.Button.Active}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3*"/>
                                                    <ColumnDefinition Width="7*"/>
                                                    <ColumnDefinition Width="72"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="128"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayName}"
                                                           Style="{StaticResource TableCellMainStyle}"
                                                           ToolTip="{Binding DisplayName}"/>

                                                <!-- 路径以 Margin 让出右侧 16：它与「占用」列之间没有别的间隔，
                                                     不留给文字会紧贴数字。 -->
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Path}"
                                                           Style="{StaticResource TableCellSubStyle}"
                                                           Margin="0,0,16,0"
                                                           ToolTip="{Binding Path}"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CpuText}"
                                                           Style="{StaticResource TableCellSubStyle}"/>

                                                <!-- 掩码下拉：选择即热绑定该名称下所有 PID 并落盘 -->
                                                <ComboBox Grid.Column="3"
                                                          ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.TargetOptions}}"
                                                          SelectedItem="{Binding Selection, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanBind}"
                                                          Style="{StaticResource TableCellComboStyle}"
                                                          ToolTip="{Binding Selection}"
                                                          DropDownOpened="TargetCombo_DropDownOpened"
                                                          DropDownClosed="TargetCombo_DropDownClosed"/>

                                                <!-- 优先级：与掩码同款下拉。
                                                     【为什么以前只读、现在能改】
                                                     早期担心「把忙等型进程提到 High 会把桌面饿死」——
                                                     那是 RealTime 才有的问题。下拉最高只到 High，
                                                     且 Windows 自带任务管理器本来就能改，
                                                     拦着只是让用户绕一圈去任务管理器。
                                                     选项里刻意不给 RealTime：它高于系统输入线程，
                                                     一旦给了就会有人试，然后鼠标卡住。

                                                     选中即生效（不需要按「应用」）：
                                                     优先级只作用于当前实例，不落盘、不进规则，
                                                     进程退出自然回默认，没有「半套状态」风险。 -->
                                                <ComboBox Grid.Column="4"
                                                          ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.PriorityOptions}}"
                                                          SelectedItem="{Binding PrioritySelection, Mode=TwoWay}"
                                                          Style="{StaticResource TableCellComboStyle}"
                                                          ToolTip="{Binding PriorityHint}"
                                                          DropDownOpened="PriorityCombo_DropDownOpened"
                                                          DropDownClosed="PriorityCombo_DropDownClosed">
                                                          <ComboBox.ItemTemplate>
                                                              <DataTemplate>
                                                                  <TextBlock Text="{Binding Converter={StaticResource PriorityLabel}}"/>
                                                              </DataTemplate>
                                                          </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- 指令下发后的瞬时反馈：整行短暂闪青 -->
                                            <DataTrigger Binding="{Binding Flash}" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource AccentSoftBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyHint"
                                   Text="暂无进程"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Style="{StaticResource HintTextStyle}"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ===== 模块二：已保存规则 ===== -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>

                    <!-- 卡头：左「标题 + 徽章」，右「清空所有规则」 -->
                    <Border Style="{StaticResource CardHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 标题与徽章同为 28 高、垂直居中：
                                 以前标题 16px 文字与 28 高的徽章靠 VerticalAlignment=Center
                                 勉强对齐，但文字基线仍偏低 1px。现在两者放进 28 高的行里居中。 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="已保存规则"
                                           Style="{StaticResource CardTitleStyle}"
                                           VerticalAlignment="Center"
                                           Margin="0"/>
                                <Border Style="{StaticResource StatusBadgeStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="RuleCountText"
                                               Text="0 条"
                                               Style="{StaticResource StatusBadgeTextStyle}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" Content="清空所有规则"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="ClearRules_Click"/>
                        </Grid>
                    </Border>

                    <!-- 表头：四列。Padding 12 与数据行一致。 -->
                    <Grid Margin="0,0,0,8">
                        <Border Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="176"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="248"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="进程名" Style="{StaticResource TableHeaderTextStyle}" Margin="0,0,16,0"/>
                                <TextBlock Grid.Column="1" Text="核心掩码" Style="{StaticResource TableHeaderTextStyle}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="2" Text="优先级" Style="{StaticResource TableHeaderTextStyle}" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource TableHeaderTextStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Height="300">
                        <ItemsControl x:Name="SavedRulesList" Focusable="False"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <!-- 与进程列表同一套结构，原因见上方那段长注释：
                                 手写 ScrollViewer 包 ItemsControl 时虚拟化不生效。 -->
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Focusable="False">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ProcessRowStyle}" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="176"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="248"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 进程名 + 次要信息两行。外层必须 VerticalAlignment=Center：
                                                     两行文字合计 26px，行高 48，居中才不会贴顶。 -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource TableCellMainStyle}"
                                                               ToolTip="{Binding ToolTipText}"/>
                                                    <!-- 次要信息用 Text.Meta 而不是 Text.Disabled：
                                                         Disabled（30% 白）是「不可用」的语义，
                                                         拿来写路径对比度只有 2.6:1，读不出来。 -->
                                                    <TextBlock Text="{Binding SubText}"
                                                               Style="{StaticResource TableCellSubStyle}"
                                                               Margin="0,3,0,0"
                                                               Visibility="{Binding SubTextVisibility}"/>
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.TargetOptions}}"
                                                          SelectedItem="{Binding Selection, Mode=TwoWay}"
                                                          Style="{StaticResource TableCellComboStyle}"
                                                          ToolTip="切换后点右侧「应用」才会生效"/>

                                                <!-- 优先级：这里是「保存的下次值」，
                                                     改完要点右侧「应用」才落盘并下发 —— 与掩码行为一致。 -->
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.PriorityOptions}}"
                                                          SelectedItem="{Binding PrioritySelection, Mode=TwoWay}"
                                                          Style="{StaticResource TableCellComboStyle}"
                                                          ToolTip="切换后点右侧「应用」才会生效">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource PriorityLabel}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- 三个按钮等宽等高、间距 8。最后一个 Margin 归零，行右缘与表头右缘对齐。 -->
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left">
                                                    <Button Content="{Binding EnableLabel}"
                                                            Style="{StaticResource RuleActionButtonStyle}"
                                                            Tag="{Binding}"
                                                            ToolTip="{Binding EnableHint}"
                                                            Click="ToggleRuleEnabled_Click"/>
                                                    <Button Content="应用"
                                                            Style="{StaticResource RuleActionButtonStyle}"
                                                            Tag="{Binding}"
                                                            ToolTip="把这条规则立即下发到正在运行的实例"
                                                            Click="ApplySingleRule_Click"/>
                                                    <Button Content="删除"
                                                            Style="{StaticResource RuleActionButtonStyle}"
                                                            Margin="0"
                                                            Tag="{Binding}"
                                                            ToolTip="只删除这一条规则"
                                                            Click="DeleteSingleRule_Click"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock x:Name="EmptyRulesHint"
                                   Text="暂无已保存规则"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Style="{StaticResource HintTextStyle}"/>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
