<Page x:Class="ZenForge.Views.ProcessBindingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ZenForge.Views"
      Title="调度"
      Focusable="False"
      FocusVisualStyle="{x:Null}">
    <!--
        ============================================================
        调度页版式规格（以用户草图为唯一依据，勿随手改）
        ============================================================
        模块一「运行中进程」
          表头行：左右两列
            · 左：大标题
            · 右：横向容器 = [搜索框(内嵌放大镜)] [管理自定义掩码] [应用已保存规则]
                   三个部件垂直居中、彼此间距一致（统一 10px）
          列表行：严格四列（名称 / 路径 / 占用 / 核心掩码）
            · 表头文字与单元格内容左边缘必须逐列对齐 —— 靠统一 Padding 实现，
              规则写在下方 GridViewColumnHeader 模板与各单元格里。

        模块二「已保存规则」
          表头行：左「大标题 + 紧邻的弱化徽章」，右「清空所有规则」
          列表行：严格三列（进程名自适应撑满 / 掩码下拉框固定宽 / 按钮组固定宽）
            · 按钮组三按钮等宽等高、间距均匀

        公共约定
          · 行水平 Padding = 0，表头水平 Padding = 0，留白全部交给单元格自身
            的左右 Margin（12 起）。两边起点相同，列宽一致 → 逐列对齐。
          · 行内容必须由 GridViewRowPresenter 渲染（ContentPresenter 会丢列信息）。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,24,32,24">

            <!-- ======= 页头 ======= -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="进程" Style="{StaticResource PageTitleStyle}"/>
            </StackPanel>

            <!-- ======= CPU Sets 拓扑不可用警告（默认隐藏，读取失败时显示） ======= -->
            <Border x:Name="TopologyWarningBanner"
                    Visibility="Collapsed"
                    Background="#33E5534B"
                    BorderBrush="#E5534B"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="⚠️ 无法读取系统 CPU Sets 拓扑，无损调度不可用。该接口需要管理员权限。"
                               Foreground="#E5534B"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TopologyWarningDetail"
                               Foreground="#E5534B"
                               FontSize="11"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.85"/>
                </StackPanel>
            </Border>

            <!-- ===== 模块一：运行中进程 ===== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                <StackPanel>

                    <!-- 表头行：左标题 / 右操作区（垂直居中，间距一致） -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="运行中进程"
                                   Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- 搜索框 + 两个按钮：统一 Height=34、统一 Margin="0,0,10,0"，
                             最后一个 Margin=0 —— 间距处处相等，且三者共用同一条垂直中线。 -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">

                            <!-- 搜索框：框内左侧内嵌放大镜图标。
                                 光标定位靠 Padding.Left=30 给图标让位；
                                 TextAlignment / HorizontalContentAlignment 显式写 Left，
                                 防止被样式改成居中。占位提示只由 SearchPlaceholder 一个
                                 TextBlock 负责，避免与 Tag 内联提示叠出"重影"。 -->
                            <Grid Width="210" Margin="0,0,10,0">
                                <TextBox x:Name="SearchBox"
                                         Padding="26,0,10,0"
                                         TextAlignment="Left"
                                         HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center"
                                         Style="{StaticResource AppTextBoxStyle}"
                                         TextChanged="SearchBox_TextChanged"
                                         GotFocus="SearchBox_GotFocus"
                                         LostFocus="SearchBox_LostFocus"
                                         KeyDown="SearchBox_KeyDown"/>
                                <!-- 放大镜图标（不参与命中测试） -->
                                <Path x:Name="SearchIcon"
                                      HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Margin="8,0,0,0" IsHitTestVisible="False"
                                      Width="15" Height="15"
                                      Stroke="{DynamicResource Text.Secondary}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 6.5,1.5 A 5,5 0 1 1 6.49,1.5 M 10.3,10.3 L 14,14"/>
                                <!-- 占位提示（仅在未输入且未聚焦时显示） -->
                                <TextBlock x:Name="SearchPlaceholder" Text="搜索进程名…"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Margin="26,0,0,0" IsHitTestVisible="False"
                                           Foreground="{DynamicResource Text.Secondary}"
                                           FontSize="13" Visibility="Collapsed"/>
                            </Grid>

                            <Button Content="管理自定义掩码"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="18,0" Margin="0,0,10,0"
                                    Click="ManageMasks_Click"/>

                            <Button x:Name="ApplySavedButton" Content="应用已保存规则"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="18,0" Margin="0"
                                    Click="ApplySaved_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- 列表（按进程名合并，一行 = 一个程序） -->
                    <Border Background="{DynamicResource List.Background}"
                            BorderBrush="{DynamicResource Input.Border}"
                            BorderThickness="1"
                            CornerRadius="6" Margin="0,12,0,0" Height="300">
                        <Grid>
                            <ListView x:Name="ProcessListView"
                                      BorderThickness="0"
                                      Background="{DynamicResource List.Background}"
                                      Foreground="{DynamicResource Text.Primary}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionMode="Extended">
                                <ListView.Template>
                                    <ControlTemplate TargetType="ListView">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                          VerticalScrollBarVisibility="Auto"
                                                          CanContentScroll="True"
                                                          Focusable="False">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </ListView.Template>
                                <ListView.ItemContainerStyle>
                                    <!--
                                        列对齐三要素（缺一就会逐列偏移）：
                                        1) 行容器必须是 GridViewRowPresenter，不能用 ContentPresenter；
                                        2) 行的水平 Padding 必须为 0（表头也是 0）；
                                        3) 单元格内容的左起点由各自的 Margin 决定，且表头模板内部
                                           也留同样的 12px —— 两边起点一致才算真正对齐。
                                    -->
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                              Columns="{Binding Path=(GridView.ColumnCollection), RelativeSource={RelativeSource TemplatedParent}}"
                                                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource List.Hover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <!-- 选中行不用实心强调色铺满：单元格里的下拉框
                                                                 压在实心色上会糊成一片。改为浅强调底 + 左侧 4px 竖条。 -->
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="4,0,0,0"/>
                                                        </Trigger>
                                                        <!-- 绑定指令下发的瞬时反馈：整行短暂闪青 -->
                                                        <DataTrigger Binding="{Binding Flash}" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="#00B4D8"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridView.ColumnHeaderContainerStyle>
                                            <!--
                                                表头模板：左边固定 12px 空白 + 文字。
                                                这 12px 与每个单元格的 Margin="12,0,..." 左值严格相等，
                                                所以表头文字与单元格内容一定在同一条竖直线上。
                                                水平 Padding 必须为 0，否则 12 会叠加成 24。
                                            -->
                                            <Style TargetType="GridViewColumnHeader">
                                                <!-- 点击列头排序（仅「占用」列响应，见代码 Header_Click） -->
                                                <EventSetter Event="Click" Handler="Header_Click"/>
                                                <Setter Property="Background" Value="{DynamicResource List.Header}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="0,8"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GridViewColumnHeader">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="12"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GridView.ColumnHeaderContainerStyle>

                                        <!-- 列 1：进程名（自适应） -->
                                        <GridViewColumn x:Name="ProcNameColumn" Header="名称" Width="220">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Margin="12,0,8,0"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- 列 2：路径（自适应，宽度由代码按窗口宽度分配增量） -->
                                        <GridViewColumn x:Name="ProcPathColumn" Header="路径" Width="300">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- 不写死灰色：选中行换底色后该灰不可读。
                                                         继承行前景色 + 降透明度，两种状态都清晰。 -->
                                                    <TextBlock Text="{Binding Path}"
                                                               Margin="12,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.78"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Path}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- 列 3：CPU 占用（固定宽，右对齐） -->
                                        <GridViewColumn x:Name="ProcCpuColumn" Header="占用 ▼" Width="86">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding CpuText}"
                                                               Margin="0,0,12,0"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               Opacity="0.78"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- 列 4：核心掩码（固定宽下拉框）。选择即保存规则并热绑定该名称下所有 PID。 -->
                                        <GridViewColumn x:Name="ProcMaskColumn" Header="核心掩码" Width="196">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- 不能给 MinWidth：单元格可用宽度 = 列宽 - 外边距，
                                                         固定下限会让下拉框超出列宽、右半边被裁掉。
                                                         用 Stretch，宽度完全由列宽决定。 -->
                                                    <ComboBox ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.TargetOptions}}"
                                                              SelectedItem="{Binding Selection, Mode=TwoWay}"
                                                              IsEnabled="{Binding CanBind}"
                                                              Height="28"
                                                              FontSize="12"
                                                              Padding="8,0"
                                                              MinWidth="0"
                                                              Margin="0,0,12,0"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              ToolTip="{Binding Selection}"
                                                              DropDownOpened="TargetCombo_DropDownOpened"
                                                              DropDownClosed="TargetCombo_DropDownClosed"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="EmptyHint"
                                       Text="暂无进程"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Style="{StaticResource HintTextStyle}"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

            <!-- ===== 模块二：已保存规则 ===== -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>

                    <!-- 表头行：左「标题 + 徽章」，右「清空所有规则」 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="已保存规则"
                                       Style="{StaticResource CardTitleStyle}"
                                       VerticalAlignment="Center"/>
                            <!-- 弱化徽章紧贴标题：Margin 左 10，垂直居中，字号/前景走 StatusBadgeTextStyle -->
                            <Border Style="{StaticResource StatusBadgeStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="RuleCountText"
                                           Text="0 条规则"
                                           Style="{StaticResource StatusBadgeTextStyle}"/>
                            </Border>
                        </StackPanel>

                        <Button Grid.Column="1" Content="清空所有规则"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="18,0" Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Click="ClearRules_Click"/>
                    </Grid>

                    <!-- 列表：三列 -->
                    <Border Background="{DynamicResource List.Background}"
                            BorderBrush="{DynamicResource Input.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,12,0,0"
                            Height="300">
                        <Grid>
                            <ListView x:Name="SavedRulesList"
                                      BorderThickness="0"
                                      Background="{DynamicResource List.Background}"
                                      Foreground="{DynamicResource Text.Primary}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SelectionMode="Single">
                                <ListView.Template>
                                    <ControlTemplate TargetType="ListView">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                          VerticalScrollBarVisibility="Auto"
                                                          CanContentScroll="True"
                                                          Focusable="False">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </ControlTemplate>
                                </ListView.Template>
                                <ListView.ItemContainerStyle>
                                    <!-- 与模块一同一套对齐规则。必须显式用 GridViewRowPresenter，
                                         否则行内容会渲染成 "ZenForge.Views.SavedRuleRow" 一个整块。 -->
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0,6"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="Bd"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True">
                                                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                              Columns="{Binding Path=(GridView.ColumnCollection), RelativeSource={RelativeSource TemplatedParent}}"
                                                                              VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource List.Hover}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="4,0,0,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridView.ColumnHeaderContainerStyle>
                                            <Style TargetType="GridViewColumnHeader">
                                                <Setter Property="Background" Value="{DynamicResource List.Header}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Padding" Value="0,8"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="GridViewColumnHeader">
                                                            <Border Background="{TemplateBinding Background}"
                                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="12"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                                                </Grid>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </GridView.ColumnHeaderContainerStyle>

                                        <!-- 列 1：进程名 —— 宽度 * 表示吃满剩余空间 -->
                                        <GridViewColumn x:Name="RuleNameColumn" Header="进程名" Width="Auto">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="12,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding ToolTipText}"/>
                                                        <!-- 次要信息（路径 / 停用提示）压在进程名下方一行，
                                                             这样三列结构不被第四列挤占。 -->
                                                        <TextBlock Text="{Binding SubText}"
                                                                   FontSize="11"
                                                                   Opacity="0.62"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="0,2,0,0"
                                                                   Visibility="{Binding SubTextVisibility}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- 列 2：核心掩码（固定宽，可切换）。
                                             改选掩码只更新选择状态，落到 bindings.json 仍需按「应用」，
                                             与「不自动应用」的约定一致。 -->
                                        <GridViewColumn x:Name="RuleMaskColumn" Header="核心掩码" Width="176">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.TargetOptions}}"
                                                              SelectedItem="{Binding Selection, Mode=TwoWay}"
                                                              Height="28"
                                                              FontSize="12"
                                                              Padding="8,0"
                                                              MinWidth="0"
                                                              Margin="0,0,12,0"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              ToolTip="切换后点右侧「应用」才会生效"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- 列 3：操作按钮组（固定宽 = 3×72 + 2×8 间距 + 左右留白） -->
                                        <GridViewColumn x:Name="RuleActionColumn" Header="操作" Width="264">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <!-- 三个按钮等宽等高、间距均匀：
                                                         Width 统一 72 / Height 统一 28 / Margin 统一 "0,0,8,0"（最后一个 0）。
                                                         之前用 MinWidth，中文文案长度不同就撑出不同宽度，
                                                         看上去参差不齐 —— 这正是上一版被打回的原因。 -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Margin="0,0,12,0"
                                                                VerticalAlignment="Center"
                                                                HorizontalAlignment="Left">
                                                        <Button Content="{Binding EnableLabel}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Width="72" Height="28" MinWidth="0"
                                                                Padding="0" Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Click="ToggleRuleEnabled_Click"
                                                                Tag="{Binding}"
                                                                ToolTip="{Binding EnableHint}"/>
                                                        <Button Content="应用"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Width="72" Height="28" MinWidth="0"
                                                                Padding="0" Margin="0,0,8,0"
                                                                VerticalAlignment="Center"
                                                                Click="ApplySingleRule_Click"
                                                                Tag="{Binding}"
                                                                ToolTip="把这条规则立即下发到正在运行的实例"/>
                                                        <Button Content="删除"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Width="72" Height="28" MinWidth="0"
                                                                Padding="0" Margin="0"
                                                                VerticalAlignment="Center"
                                                                Click="DeleteSingleRule_Click"
                                                                Tag="{Binding}"
                                                                ToolTip="只删除这一条规则"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <TextBlock x:Name="EmptyRulesHint"
                                       Text="暂无已保存规则"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Style="{StaticResource HintTextStyle}"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
