<Page x:Class="ZenForge.Views.ProcessBindingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ZenForge.Views"
      Title="进程"
      Focusable="False"
      FocusVisualStyle="{x:Null}">
    <!--
        ============================================================
        进程页版式规格（v12）
        ============================================================
        模块一「运行中进程」
          card-header-with-actions：左 16px 标题 / 右 [搜索框 180] [管理掩码] [应用规则]
          自绘表头：5 列 —— 进程名 / 路径 / 占用 / 核心掩码 / 优先级
          数据行：同一套列宽，hover 铺 6% 白、选中铺 12% 强调色
          优先级列只读（理由见 ProcessGroupRow.PriorityText 注释）

        模块二「已保存规则」
          表头：左「标题 + 弱化徽章」/ 右「清空所有规则」
          自绘三列 —— 进程名（吃满）/ 核心掩码（固定）/ 操作（固定）

        为什么不用 ListView + GridView：
          v12 的表头是「12px 次要色小字、无底无边、与数据行同列宽配比」，
          GridView 的列头模板做不到 1.5fr / 2fr 这类弹性配比，
          还得额外写列宽同步代码（上一版 ApplyColumnWidths 就是干这个的）。
          改用 ItemsControl + 共享 Grid 列定义之后，列宽天然一致，
          宽度自适应交给 WPF 布局引擎，那段去抖代码可以整体删掉。

        对齐约定：
          表头与数据行都用 Padding="12,0" / "12,10"，
          第一列左边缘永远对齐；列间靠列定义宽度自身的间隔，
          不再给单元格加左右 Margin（加了就会与表头错开）。
    -->

    <Page.Resources>
        <!-- 五列配比：进程名 1* / 路径 4* / 占用 80 / 掩码 120 / 优先级 110。
             进程名与路径的 1:4 是「20% / 80%」：
               进程名极少超过 20 个字符（图片里最长的 HRInstMonitor.exe 也就 20 个），
               给到 1.5* 会在名字后留下大片空白，而路径被挤到只剩一半可见 ——
               比例反过来才是对的，路径才是需要宽度的那个。
             表头与数据行各自复制一份 —— Grid.ColumnDefinitions 不能共享实例，
             但数值保持一致即可，这是 WPF 里对齐两套独立 Grid 的标准做法。 -->
        <Style x:Key="ProcRowGridStyle" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,24,32,24">

            <!-- ======= 页头 ======= -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="进程" Style="{StaticResource PageTitleStyle}"/>
            </StackPanel>

            <!-- ======= CPU Sets 拓扑不可用警告（默认隐藏，读取失败时显示） ======= -->
            <Border x:Name="TopologyWarningBanner"
                    Visibility="Collapsed"
                    Background="{DynamicResource DangerSoft}"
                    BorderBrush="{DynamicResource Danger}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="⚠️ 无法读取系统 CPU Sets 拓扑，无损调度不可用。该接口需要管理员权限。"
                               Foreground="{DynamicResource Danger}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="TopologyWarningDetail"
                               Foreground="{DynamicResource Danger}"
                               FontSize="11"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Opacity="0.85"/>
                </StackPanel>
            </Border>

            <!-- ===== 模块一：运行中进程 ===== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>

                    <!-- 表头行：底边一条分隔线，标题 16px（v12 的 card-header-with-actions 把
                         标题从 14 放大到 16，因为这里承担的是模块级标题而不是卡内小标题） -->
                    <Border Style="{StaticResource CardHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="运行中进程"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Text.Primary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <!-- 搜索框 + 两个按钮：间距统一 10 -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="16,0,0,0">

                                <!-- 搜索框：框内左侧内嵌放大镜。占位提示只由 SearchPlaceholder
                                     一个 TextBlock 负责，避免与内联提示叠出"重影"。 -->
                                <Grid Width="180" Margin="0,0,10,0">
                                    <TextBox x:Name="SearchBox"
                                             Height="32"
                                             Padding="26,0,10,0"
                                             TextAlignment="Left"
                                             HorizontalContentAlignment="Left"
                                             VerticalContentAlignment="Center"
                                             Style="{StaticResource AppTextBoxStyle}"
                                             TextChanged="SearchBox_TextChanged"
                                             GotFocus="SearchBox_GotFocus"
                                             LostFocus="SearchBox_LostFocus"
                                             KeyDown="SearchBox_KeyDown"/>
                                    <Path x:Name="SearchIcon"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Margin="8,0,0,0" IsHitTestVisible="False"
                                          Width="13" Height="13"
                                          Stroke="{DynamicResource Text.Secondary}"
                                          StrokeThickness="1.2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 5.5,1 A 4.5,4.5 0 1 1 5.49,1 M 9,9 L 12,12"/>
                                    <TextBlock x:Name="SearchPlaceholder" Text="搜索进程..."
                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                               Margin="26,0,0,0" IsHitTestVisible="False"
                                               Foreground="{DynamicResource Text.Disabled}"
                                               FontSize="12" Visibility="Collapsed"/>
                                </Grid>

                                <Button Content="管理掩码"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,10,0"
                                        Click="ManageMasks_Click"/>

                                <Button x:Name="ApplySavedButton" Content="应用规则"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0"
                                        Click="ApplySaved_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 自绘表头 -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.ColumnSpan="5" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="进程名" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="路径"   Style="{StaticResource TableHeaderTextStyle}"/>
                                <!-- 占用列头可点：切换排序方向（v12 里这是唯一的排序入口） -->
                                <TextBlock x:Name="CpuHeaderText"
                                           Grid.Column="2"
                                           Text="占用 ▼"
                                           Style="{StaticResource TableHeaderTextStyle}"
                                           Cursor="Hand"
                                           ToolTip="点击切换排序方向（当前：从高到低）"
                                           MouseLeftButtonUp="CpuHeader_MouseLeftButtonUp"/>
                                <TextBlock Grid.Column="3" Text="核心掩码" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="4" Text="优先级" Style="{StaticResource TableHeaderTextStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 数据行。MaxHeight 限高，超出滚动。
                         注意 ScrollViewer 外层已经有页面级滚动条，这里再套一个内层滚动条
                         是必要的：进程数量可能上百，不内滚会把整页撑成几千像素。 -->
                    <Grid Height="320">
                        <!-- 【虚拟化三件套】
                             ScrollViewer.CanContentScroll=True + VirtualizingStackPanel.IsVirtualizing
                             + VirtualizingPanel.VirtualizationMode=Recycling
                             缺一不可：CanContentScroll 为 False 时（默认物理滚动），
                             ItemsControl 会把每一项都实测一遍高度，虚拟化直接失效。
                             开启后 200+ 进程只创建可见的那十几行容器，滚动时复用，
                             切页与滚动不再每秒卡一下。
                             Recycling 而不是 Standard：Standard 每次滚动都新建容器
                             （下拉框 + 3 个 TextBlock），复用能把分配量降一个数量级。 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsControl x:Name="ProcessListView" Focusable="False"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" Style="{StaticResource ProcessRowStyle}"
                                                MouseLeftButtonDown="ProcessRow_MouseLeftButtonDown">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="4*"/>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="110"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DisplayName}"
                                                           Style="{StaticResource TableCellMainStyle}"
                                                           ToolTip="{Binding DisplayName}"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Path}"
                                                           Style="{StaticResource TableCellSubStyle}"
                                                           Margin="0,0,16,0"
                                                           ToolTip="{Binding Path}"/>

                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CpuText}"
                                                           Style="{StaticResource TableCellSubStyle}"/>

                                                <!-- 掩码下拉框：选择即热绑定该名称下所有 PID 并落盘 -->
                                                <ComboBox Grid.Column="3"
                                                          ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.TargetOptions}}"
                                                          SelectedItem="{Binding Selection, Mode=TwoWay}"
                                                          IsEnabled="{Binding CanBind}"
                                                          Height="28"
                                                          FontSize="12"
                                                          Padding="8,0"
                                                          MinWidth="0"
                                                          Margin="0,0,10,0"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          ToolTip="{Binding Selection}"
                                                          DropDownOpened="TargetCombo_DropDownOpened"
                                                          DropDownClosed="TargetCombo_DropDownClosed"/>

                                                <!-- 优先级：与掩码同款下拉。
                                                     【为什么以前只读、现在能改】
                                                     早期担心「把忙等型进程提到 High 会把桌面饿死」——
                                                     那是 RealTime 才有的问题。下拉里最高只到
                                                     High，且 Windows 自带的任务管理器本来就能改，
                                                     拦着不给改只是让用户去任务管理器绕一圈。
                                                     选项里刻意不给 RealTime：它高于系统输入线程，
                                                     一旦给了就会有人去试，然后发现鼠标卡住。

                                                     选中即生效（不需要再按「应用」）——
                                                     优先级只作用于进程当前实例，不落盘、不进规则，
                                                     进程退出后自然回到默认，没有「半套状态」的风险。 -->
                                                <ComboBox Grid.Column="4"
                                                          ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.PriorityOptions}}"
                                                          SelectedItem="{Binding PrioritySelection, Mode=TwoWay}"
                                                          Height="28"
                                                          FontSize="12"
                                                          Padding="8,0"
                                                          MinWidth="0"
                                                          Margin="0,0,10,0"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          ToolTip="{Binding PriorityHint}"
                                                          DropDownOpened="PriorityCombo_DropDownOpened"
                                                          DropDownClosed="PriorityCombo_DropDownClosed"/>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- 绑定指令下发后的瞬时反馈：整行短暂闪青 -->
                                            <DataTrigger Binding="{Binding Flash}" Value="True">
                                                <Setter TargetName="Row" Property="Background"
                                                        Value="{DynamicResource AccentSoftBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyHint"
                                   Text="暂无进程"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Style="{StaticResource HintTextStyle}"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ===== 模块二：已保存规则 ===== -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>

                    <!-- 表头行：左「标题 + 徽章」，右「清空所有规则」 -->
                    <Border Style="{StaticResource CardHeaderBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="已保存规则"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text.Primary}"
                                           VerticalAlignment="Center"/>
                                <Border Style="{StaticResource StatusBadgeStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="RuleCountText"
                                               Text="0 条规则"
                                               Style="{StaticResource StatusBadgeTextStyle}"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" Content="清空所有规则"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="ClearRules_Click"/>
                        </Grid>
                    </Border>

                    <!-- 表头：三列 -->
                    <Grid Margin="0,0,0,10">
                        <Border Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="176"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="264"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="进程名" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="1" Text="核心掩码" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="2" Text="优先级" Style="{StaticResource TableHeaderTextStyle}"/>
                                <TextBlock Grid.Column="3" Text="操作" Style="{StaticResource TableHeaderTextStyle}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Height="300">
                        <!-- 同上的虚拟化三件套。规则通常只有几条，
                             但用户可能导入几十条，成本一致，没理由不做。 -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsControl x:Name="SavedRulesList" Focusable="False"
                                          VirtualizingStackPanel.IsVirtualizing="True"
                                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ProcessRowStyle}" Margin="0,0,0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="176"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="264"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               Style="{StaticResource TableCellMainStyle}"
                                                               ToolTip="{Binding ToolTipText}"/>
                                                    <!-- 次要信息（路径 / 停用提示）压在进程名下方一行，
                                                         这样三列结构不被第四列挤占。 -->
                                                    <TextBlock Text="{Binding SubText}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Text.Disabled}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding SubTextVisibility}"/>
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.TargetOptions}}"
                                                          SelectedItem="{Binding Selection, Mode=TwoWay}"
                                                          Height="28"
                                                          FontSize="12"
                                                          Padding="8,0"
                                                          MinWidth="0"
                                                          Margin="0,0,10,0"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          ToolTip="切换后点右侧「应用」才会生效"/>

                                                <!-- 优先级：与运行中进程同款下拉，但这里是「保存的下次值」，
                                                     改完要点右侧「应用」才落盘并下发 —— 与掩码的行为一致。 -->
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding Source={x:Static local:ProcessBindingPage.PriorityOptions}}"
                                                          SelectedItem="{Binding PrioritySelection, Mode=TwoWay}"
                                                          Height="28"
                                                          FontSize="12"
                                                          Padding="8,0"
                                                          MinWidth="0"
                                                          Margin="0,0,10,0"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          ToolTip="切换后点右侧「应用」才会生效"/>

                                                <!-- 三个按钮等宽等高、间距均匀 -->
                                                <StackPanel Grid.Column="3"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            HorizontalAlignment="Left">
                                                    <Button Content="{Binding EnableLabel}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Width="72" Height="28" MinWidth="0"
                                                            Padding="0" Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Click="ToggleRuleEnabled_Click"
                                                            Tag="{Binding}"
                                                            ToolTip="{Binding EnableHint}"/>
                                                    <Button Content="应用"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Width="72" Height="28" MinWidth="0"
                                                            Padding="0" Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Click="ApplySingleRule_Click"
                                                            Tag="{Binding}"
                                                            ToolTip="把这条规则立即下发到正在运行的实例"/>
                                                    <Button Content="删除"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Width="72" Height="28" MinWidth="0"
                                                            Padding="0" Margin="0"
                                                            VerticalAlignment="Center"
                                                            Click="DeleteSingleRule_Click"
                                                            Tag="{Binding}"
                                                            ToolTip="只删除这一条规则"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="EmptyRulesHint"
                                   Text="暂无已保存规则"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Style="{StaticResource HintTextStyle}"/>
                    </Grid>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
