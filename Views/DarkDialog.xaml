<Window x:Class="ZenForge.Views.DarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZenForge"
        Width="420"
        SizeToContent="Height"
        MinHeight="180"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <!-- 外层留 16px 给投影，主体圆角 12px（与侧栏面板同一档） -->
    <Border Margin="16"
            Background="{DynamicResource Window.Background}"
            BorderBrush="{DynamicResource Card.Border}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.55" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖动） -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    CornerRadius="12,12,0,0"
                    Padding="18,14,10,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 图标：按类型着色（信息 / 警告 / 错误 / 询问） -->
                        <Border x:Name="IconBadge"
                                Width="22" Height="22"
                                CornerRadius="11"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="IconGlyph"
                                       Text="i"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="#101010"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="TitleTextBlock"
                                   Text="ZenForge"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Width="30" Height="26"
                            Content="&#x2715;"
                            FontSize="12"
                            Foreground="{DynamicResource Text.Secondary}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- 正文 -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="340"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="18,12,18,0">
                <TextBlock x:Name="MessageTextBlock"
                           Text=""
                           TextWrapping="Wrap"
                           LineHeight="21"
                           Foreground="{DynamicResource Text.Secondary}"/>
            </ScrollViewer>

            <!-- 分隔线 -->
            <Border Grid.Row="2" Height="1" Background="{DynamicResource Separator}" Margin="0,16,0,0"/>

            <!-- 按钮区 -->
            <!-- 用 Grid 等宽列而不是 StackPanel：两个按钮宽度完全一致，
                 不会因中文字形宽度差异出现「取消」比「确定」窄一截的观感。 -->
            <Grid Grid.Row="3" Margin="18,14,18,16" HorizontalAlignment="Right">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="CancelButton"
                        Grid.Column="0"
                        Content="取消"
                        Width="112"
                        Height="32"
                        Padding="0"
                        Margin="0,0,12,0"
                        Foreground="{DynamicResource Text.Primary}"
                        Background="{DynamicResource Card.Background}"
                        BorderBrush="{DynamicResource Input.Border}"
                        BorderThickness="1"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Visibility="Collapsed"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="OkButton"
                        Grid.Column="1"
                        Content="确定"
                        Width="112"
                        Height="32"
                        Padding="0"
                        Foreground="#101010"
                        Background="{DynamicResource AccentBrush}"
                        BorderThickness="0"
                        Cursor="Hand"
                        FontWeight="SemiBold"
                        FocusVisualStyle="{x:Null}"
                        IsDefault="True"
                        Click="Ok_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
