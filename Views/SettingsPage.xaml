<Page x:Class="ZenForge.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="设置"
      FontFamily="{StaticResource AppFontFamily}"
      FontSize="13"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <!--
        ============================================================
        设置页版式规格（v13）
        ============================================================
        四张卡片：外观 / 行为 / 安全 / 诊断。

        【每行只有一个结构】
        v12 里这一页同时存在三种行结构：
          · 两列 Grid + 内层 StackPanel（多数行）
          · 两列 Grid + 裸 TextBlock（无说明的行）
          · 三列 Grid 内再套一层两列 Grid（外观卡第一行）
        层数不同 → 垂直居中的参照不同 → 并排看文字基线是歪的。
        现在统一成：Grid(左* / 右Auto) + Stack.LabelBlock(标签 + 说明)。
        没有说明的行也走 LabelBlock，只是里面少一个子元素。

        【控件高度的唯一口径】
        下拉 / 输入框 32，按钮 28（SecondaryButtonStyle 自带），
        开关 22（ToggleSwitchStyle 自带）。行内一律 VerticalAlignment=Center，
        不再各写各的 36 / 38。

        【行距】
        全部走 CardRowStyle（下 20），最后一行用 CardRowLastStyle 归零。
        v12 是在每张卡最后一行手写 Margin="0"，漏一个就多出 20px 尾巴
        —— 改成专用键，漏了在 XAML 里一眼能看出来。
    -->

    <Page.Resources>
        <!-- 设置页的行样式别名。保留别名而不是删掉：
             这一页七十多处引用都写着 SettingRowStyle，改名收益抵不上风险；
             但必须是 BasedOn 全局键，不能把 Margin 抄一遍 ——
             否则下次全局改行距时这一页又会悄悄跟不上。 -->
        <Style x:Key="SettingRowStyle" TargetType="Grid" BasedOn="{StaticResource CardRowStyle}"/>

        <!-- 卡片内最后一行：去掉底部 20px，避免卡片底部 Padding 之上再叠一段空白 -->
        <Style x:Key="SettingRowLastStyle" TargetType="Grid" BasedOn="{StaticResource CardRowStyle}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- 行左侧「标签 + 说明」容器：定死垂直居中，与右侧控件对齐 -->
        <Style x:Key="SettingLabelBlockStyle" TargetType="StackPanel" BasedOn="{StaticResource Stack.LabelBlock}">
            <Setter Property="Margin" Value="0,0,24,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,6,28,24">

            <!-- ======= 页头 ======= -->
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>

            <!-- ===== 外观 =====
                 【主题模式与强调色并排】
                 两者是同一类事：让界面长什么样。上下叠放会白占一行高度。

                 【说明行】
                 外观卡原本唯独这两项没有说明，与「行为」「安全」每一行的
                 「标签 + 12px 弱化说明」两行结构不一致，行高节奏也就对不齐。
                 补上之后四张卡的行节奏才统一。 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource CardTitleStyle}"/>

                    <!-- 第一行：主题模式 | 强调色，两列等分。
                         左右两半各自是 Grid(左* / 右Auto)，与下面单列行同构。 -->
                    <Grid Style="{StaticResource SettingRowStyle}" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 主题模式。顺序：跟随系统 / 深色 / 浅色。
                             刻意不写 SelectedIndex / SelectionChanged：
                             初值由代码读 ui.json 后按 Tag 赋值，事件在赋值之后才挂载，
                             否则初始化阶段会反向触发 SelectionChanged 把主题重置回默认值。 -->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}" Margin="0,0,12,0">
                                <TextBlock Text="主题模式" Style="{StaticResource CardRowLabelStyle}"/>
                                <TextBlock Text="跟随系统时随 Windows 浅色/深色切换"
                                           Style="{StaticResource CardRowDescStyle}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="ThemeCombo"
                                      Width="136"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="跟随系统" Tag="system"/>
                                <ComboBoxItem Content="深色" Tag="dark"/>
                                <ComboBoxItem Content="浅色" Tag="light"/>
                            </ComboBox>
                        </Grid>

                        <!-- 强调色 -->
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}" Margin="0,0,12,0">
                                <TextBlock Text="强调色" Style="{StaticResource CardRowLabelStyle}"/>
                                <TextBlock Text="按钮、开关与选中态使用的颜色"
                                           Style="{StaticResource CardRowDescStyle}"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" x:Name="AccentModeCombo"
                                      Width="136"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="跟随系统" Tag="follow"/>
                                <ComboBoxItem Content="自定义" Tag="custom"/>
                            </ComboBox>
                        </Grid>
                    </Grid>

                    <!-- 第二行（仅在强调色 = 自定义时出现）：色相选择器。
                         用 Visibility.Collapsed 而不是 IsEnabled=False：
                         灰着的控件仍然占位，用户还得去读它、猜它为什么点不动。 -->
                    <Border x:Name="CustomAccentPanel" Style="{StaticResource ColorPickerGroupStyle}"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 当前色预览。加一层同色柔和外发光，让色块在深底上有「亮着」的质感。
                                 Effect 是 Freezable，不能在 XAML 里绑到资源字典画刷，
                                 发光色由代码按当前强调色赋值。 -->
                            <Border x:Name="ColorPreviewBorder"
                                    Grid.Column="0"
                                    Style="{StaticResource ColorPreviewStyle}"
                                    VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="ColorPreviewGlow"
                                                      BlurRadius="14" ShadowDepth="0" Opacity="0.55"
                                                      Color="#38BDF8"/>
                                </Border.Effect>
                            </Border>

                            <!-- 色相滑杆：0–360，值变化即实时改色 -->
                            <Slider x:Name="HueSlider"
                                    Grid.Column="1"
                                    Margin="18,0,18,0"
                                    Minimum="0" Maximum="360"
                                    SmallChange="1" LargeChange="15"
                                    Style="{StaticResource HueSliderStyle}"
                                    VerticalAlignment="Center"
                                    ValueChanged="HueSlider_ValueChanged"/>

                            <!-- 色值输入 + 应用。回车等同点「应用」。
                                 输入框去掉写死的 Height，改用全局 32；
                                 色值一定要等宽字体，否则 0 与 F 宽窄不一，边打边跳。 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="AccentHexBox" Width="104"
                                         FontFamily="{StaticResource MonoFontFamily}"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         ToolTip="支持 #RRGGBB 或 RRGGBB，回车直接应用"
                                         KeyDown="AccentHexBox_KeyDown"/>
                                <Button x:Name="ApplyAccentBtn" Content="应用"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="ApplyAccentBtn_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== 行为 =====
                 「开启后台服务」是总闸，关掉后其余相关项 Collapsed ——
                 一律用 Visibility.Collapsed，不用 IsEnabled=False 灰显：
                 灰显会留下「这一项存在、只是暂时不能用」的误导，而这里是真的不存在。 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="行为" Style="{StaticResource CardTitleStyle}"/>

                    <!-- 开机静默自启 -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="开机静默自启" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="通过计划任务启动，不弹 UAC" Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="AutoStartToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Click="AutoStartToggle_Click"/>
                    </Grid>

                    <!-- 自动应用调校 -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="自动应用调校" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="启动时把已保存的 CO / FMax 重新下发到硬件"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="ApplyTuningToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Click="ApplyTuningToggle_Click"/>
                    </Grid>

                    <!-- 开启后台服务（总闸） -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="开启后台服务" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="关闭后进程监听、轻量模式、托盘一并失效"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="BackendServiceToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Click="BackendServiceToggle_Click"/>
                    </Grid>

                    <!-- 后台常驻调度。文案与「进程」页对齐：这里管的是那个页面保存的规则
                         要不要常驻生效，不是另一个叫「绑核」的功能。 -->
                    <Grid x:Name="RowProcessWatch" Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="后台常驻调度" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="让进程页保存的绑核规则持续生效，新实例启动即自动绑定"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="ProcessWatchToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Click="ProcessWatchToggle_Click"/>
                    </Grid>

                    <!-- 后台轻量模式 -->
                    <Grid x:Name="RowLightMode" Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="后台轻量模式" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="闲置后释放界面内存，只留服务进程"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="LightModeToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Click="LightModeToggle_Click"/>
                    </Grid>

                    <!-- 显示托盘图标。原先是裸 TextBlock 没有说明行，
                         现在补一句说明：托盘图标与「后台服务」有依赖关系，
                         不写出来用户会以为关掉服务后图标还在。 -->
                    <Grid x:Name="RowShowTray" Style="{StaticResource SettingRowLastStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="显示托盘图标" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="关闭后台服务时不显示，右键菜单提供退出与打开面板"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="ShowTrayToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Click="ShowTrayToggle_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 安全 =====
                 「容错」改「安全」：这一卡三件事都不是「出错了怎么办」，
                 而是「别让机器坏掉 / 别在用户不知情时改动状态」。

                 前两项固定开启：它们是写 SMU 前的最后一道闸，不提供关闭入口。
                 显示为开启态且不可点，ToolTip 说清为什么不能关 —— 不假装成可切换的开关。 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="安全" Style="{StaticResource CardTitleStyle}"/>

                    <!-- 设备防砖保护 -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="设备防砖保护" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="异常蓝屏重启后，自动跳过危险调校"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="BrickGuardToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="True"
                                      IsHitTestVisible="False"
                                      Opacity="0.55"
                                      VerticalAlignment="Center"
                                      ToolTip="防砖保护是写 SMU 前的最后一道闸，不允许关闭"/>
                    </Grid>

                    <!-- 智能休眠感知 -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="智能休眠感知" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="系统唤醒后，自动重新下发硬件调校"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="SleepResumeToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="True"
                                      IsHitTestVisible="False"
                                      Opacity="0.55"
                                      VerticalAlignment="Center"
                                      ToolTip="唤醒后重新下发是保证调校不丢的必要动作，不提供关闭入口"/>
                    </Grid>

                    <!-- 出错时通知我 -->
                    <Grid Style="{StaticResource SettingRowLastStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="出错时通知我" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="使用系统气泡提示非阻塞错误"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="ErrorNotifyToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Click="ErrorNotifyToggle_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== 诊断 =====
                 原「维护」改名「诊断」。三件事的共同点是「我遇到问题了，需要查」。
                 出问题时人只想去一个地方，所以集中在这里。

                 「详细日志」从日志页挪过来：日志页是「看日志」的地方，
                 开关放那儿等于让用户在翻日志时才发现有个开关；
                 而开关的语义是「以后要不要记细一点」，属于设置。
                 它控制的是 Debug 级日志要不要写入（内存与磁盘都不写），
                 不是在显示时过滤 —— 关闭时 LogService.Debug() 直接不写，
                 对排查能力是真实影响，所以必须保留这个入口。 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="诊断" Style="{StaticResource CardTitleStyle}"/>

                    <!-- 详细日志 -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="详细日志" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="记录每次点击、焦点变化与列表刷新，用于排查问题（日志文件增长较快）"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1" x:Name="VerboseToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Click="VerboseToggle_Click"/>
                    </Grid>

                    <!-- SMU 自检 -->
                    <Grid Style="{StaticResource SettingRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="SMU 自检" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="导出驱动与 SMU 通信的诊断报告"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="SmuDiagButton"
                                Content="运行"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"
                                MinWidth="72"
                                VerticalAlignment="Center"
                                Click="SmuDiagButton_Click"/>
                    </Grid>

                    <!-- 全局重置。文案里的「出厂状态」必须真的说到做到：
                         配置文件删掉、SMU 索引写回基线、电源计划档位回默认，
                         见 GlobalResetButton_Click。
                         这是破坏性操作，保留阻塞式二次确认（Toast 承载不了「确认/取消」）。 -->
                    <Grid Style="{StaticResource SettingRowLastStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Style="{StaticResource SettingLabelBlockStyle}">
                            <TextBlock Text="全局重置" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock Text="清空全局配置，回到出厂状态"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>
                        <Button Grid.Column="1" x:Name="GlobalResetButton"
                                Content="重置"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"
                                MinWidth="72"
                                VerticalAlignment="Center"
                                Click="GlobalResetButton_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
