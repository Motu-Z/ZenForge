<Page x:Class="ZenForge.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="配置"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <!--
        ============================================================
        配置页（v1.0.2）：场景自动切换 / 总体配置方案 / 规则库双列
        ============================================================
        【本页的骨架先落地，功能留到 v1.1.x】
        方案模型（方案 = 一份 CO/FMax 快照 + 一组绑核规则 + 一组优先级）
        牵连三个 store，profiles.json 的字段还没定；场景自动切换要挂在
        ProcessWatcher 上，而那个类现在只处理「绑核」，要扩成「监听 + 触发动作」。

        所以这里只交付**结构与空状态**，不填任何假数据：
          · 列表位置放一条 L6 的空状态行（「暂无方案」），不写「示例方案 A」；
          · 所有按钮与开关一律 IsEnabled=False。

        为什么按钮不做成「点了弹一句还没实现」：
        一个点了没反应的控件，和一个明确灰着的控件，后者才是对的 ——
        前者让人以为软件坏了，后者让人知道这项还没到。
        v1.1.x 接入时只需要把 IsEnabled 与列表数据源接上，版式一行不用动。

        【规则库为什么双列等高】
        两列的内容性质相同（都是规则列表），并排时高度必须一致，
        否则左右两张卡的底边错开，看起来像其中一张是后来贴上去的。
        Grid 的 * / * 两列 + 两张 Border 直接撑满，高度天然相等。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,6,28,24">
            <TextBlock Text="配置"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,16"/>

            <!-- ===== 场景自动切换 =====
                 标题右侧直接放开关（参考图的版式）：开关是这一卡唯一的动作，
                 放在右下角会让卡片右半边空一大块。 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="场景自动切换"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center"/>
                        <ToggleButton HorizontalAlignment="Right"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      IsEnabled="False"/>
                    </Grid>

                    <!-- 空状态：一行 L6 元数据，不画表头也不画行 -->
                    <TextBlock Text="暂无场景规则"
                               Style="{StaticResource Text.Meta}"/>
                </StackPanel>
            </Border>

            <!-- ===== 总体配置方案 ===== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="总体配置方案"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Content="保存当前方案"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                IsEnabled="False"/>
                    </Grid>

                    <TextBlock Text="暂无方案"
                               Style="{StaticResource Text.Meta}"/>
                </StackPanel>
            </Border>

            <!-- ===== 规则库双列 =====
                 两列等宽、等高：外层的 Grid 用 * / *，两张卡各自
                 填满自己那一格，底边自然对齐。 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="调校规则库"
                                       Style="{StaticResource CardTitleStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Content="新建"
                                    Style="{StaticResource HeaderActionButtonStyle}"
                                    IsEnabled="False"/>
                        </Grid>

                        <TextBlock Text="暂无规则"
                                   Style="{StaticResource Text.Meta}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="调度规则库"
                                       Style="{StaticResource CardTitleStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Content="新建"
                                    Style="{StaticResource HeaderActionButtonStyle}"
                                    IsEnabled="False"/>
                        </Grid>

                        <TextBlock Text="暂无规则"
                                   Style="{StaticResource Text.Meta}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
