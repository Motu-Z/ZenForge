<Page x:Class="ZenForge.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="配置"
      FontFamily="{StaticResource AppFontFamily}"
      FontSize="13"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <!--
        ============================================================
        配置页（1.0.0-can7 起改为「开发中」占位）
        ============================================================
        【为什么整页文案被删掉了】
        上一版把三张卡都画了出来：场景自动切换、总体配置方案、双列规则库，
        里面填着「启动 cs2.exe → 方案 B：极限游戏」「CO -20 · FMax 4.5G」
        「QQ.exe、msedge.exe → CCD1」这类看起来很具体的内容。

        它们全是写死的假数据，没有一个字来自真实配置。问题不在「假」，
        而在这些假数据长得太真：用户会以为规则已经生效、方案已经存在，
        于是去找「为什么改了没反应」。一屏解释「这里有什么功能」的文字，
        配上一排点不动的控件，比一个诚实的空状态更糟。

        现在的做法：只保留一句「还没做好」，说清楚它将来做什么、
        为什么现在没有。不画控件、不写示例。
        等方案模型落地了再把真内容填进来。

        【为什么功能还没做】
        · 方案模型（方案 = 一份 CO/FMax 快照 + 一组绑核规则 + 一组优先级）
          牵连三个 store，profiles.json 的字段还没定；
        · 场景自动切换要挂在 ProcessWatcher 上，而那个类现在只处理「绑核」，
          要扩成「监听 + 触发动作」，属于结构性改动。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,6,28,24">

            <!-- ======= 页头 ======= -->
            <TextBlock Text="配置" Style="{StaticResource PageTitleStyle}"/>

            <!-- 空状态卡：一张卡、两段字，不做任何假的控件 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>

                    <!-- 标题行：图标 + 标题，垂直居中同一基线 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Path Width="16" Height="16"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Text.Secondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Data="M 2,13 L 2,4 L 6,4 L 6,13 M 6,13 L 6,7 L 10,7 L 10,13 M 10,13 L 10,2 L 14,2 L 14,13"/>
                        <TextBlock Text="配置方案"
                                   Style="{StaticResource CardTitleStyle}"
                                   VerticalAlignment="Center"
                                   Margin="0"/>
                    </StackPanel>

                    <!-- 一句话说清它将来做什么 -->
                    <TextBlock Text="把一套调校与调度设置存成方案，按场景一键切换。"
                               Style="{StaticResource CardRowDescStyle}"
                               Margin="0"/>

                    <!-- 第二段：现状与原因。用 L6 元数据，比上一行再弱一级 ——
                         它是「解释为什么现在没有」，不是正文。 -->
                    <TextBlock Text="这项功能还没做完，当前版本不提供。等方案模型与进程监听改造完成后会补上。"
                               Style="{StaticResource Text.Meta}"
                               Margin="0,10,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
