<UserControl x:Class="Zenwik.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <!--
        ============================================================
        配置页（v1.1.x 骨架接通）：场景自动切换 / 总体配置方案 / 规则库双列
        ============================================================
        【v1.0.2 只交付版式，v1.1.x 接上数据源】
        版式一行没动，只做了三件事：
          · 场景卡的总闸开关接 ScenarioService.Enabled；
          · 方案卡接 ProfileService.Items，保存 / 应用 / 删除三个动作全部可用；
          · 两张卡各有一条空状态行，列表有内容时自动隐藏。

        【仍然禁用的一块：规则库双列】
        左右两列（调校规则 / 调度规则）需要各自的编辑器 —— 具体是「一条规则 =
        一组 CO + FMax 的调校值」还是「一个可独立开关的调校片段」还没定。
        现在摆两个能点但没反应的「新建」，等于骗用户功能已就绪，所以继续灰着。

        【列表为什么也要开虚拟化】
        方案与场景规则的条目数确实只有个位数，但列表控件的规矩是统一的：
        开了虚拟化，将来条数涨到几百也不会突然变成内存问题。
        内外两层 ScrollViewer 的写法与进程页一致（缺一即失效）。
    -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,6,28,24">
            <TextBlock Text="配置"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,16"/>

            <!-- ===== 场景自动切换 =====
                 标题右侧直接放开关（参考图的版式）：开关是这一卡唯一的动作，
                 放在右下角会让卡片右半边空一大块。 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="场景自动切换"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center"/>
                        <ToggleButton x:Name="ScenarioToggle"
                                      HorizontalAlignment="Right"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      VerticalAlignment="Center"
                                      Checked="ScenarioToggle_Checked"
                                      Unchecked="ScenarioToggle_Unchecked"/>
                    </Grid>

                    <ItemsControl x:Name="ScenarioList" Focusable="False">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True"
                                              MaxHeight="200"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ProcessRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource TableCellMainStyle}"
                                                   Text="{Binding TriggerText}"/>
                                        <TextBlock Grid.Column="1"
                                                   Style="{StaticResource Text.Meta}"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding ProfileName}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空状态：一行 L6 元数据，不画表头也不画行 -->
                    <TextBlock x:Name="ScenarioEmpty"
                               Text="暂无场景规则"
                               Style="{StaticResource Text.Meta}"/>
                </StackPanel>
            </Border>

            <!-- ===== 总体配置方案 ===== -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="总体配置方案"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0"
                                   VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right"
                                Content="保存当前方案"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Click="SaveCurrent_Click"/>
                    </Grid>

                    <ItemsControl x:Name="ProfileList" Focusable="False">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True"
                                              MaxHeight="260"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Focusable="False">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 行底色与悬停走现成的 ProcessRowStyle（与进程页同档）。
                                     「生效中」用左侧圆点表示，圆点的显隐由 DataTrigger
                                     绑 IsActive 驱动 —— 不用代码改背景：容器会被虚拟化复用，
                                     硬改过的底色会跟着滚动条跑到别的行上。 -->
                                <Border Style="{StaticResource ProcessRowStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 默认隐藏必须写在 Style 的 Setter 里，不能写成
                                             Visibility="Collapsed" 属性：属性是局部值，
                                             优先级高于样式里的 Trigger，写成属性就等于
                                             这个圆点永远不会显示。 -->
                                        <Ellipse Grid.Column="0"
                                                 Width="6"
                                                 Height="6"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Fill="{DynamicResource AccentBrush}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource TableCellMainStyle}"
                                                       Text="{Binding Name}"/>
                                            <TextBlock Style="{StaticResource Text.Meta}"
                                                       Margin="0,2,0,0"
                                                       Text="{Binding Note}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center"
                                                    Margin="12,0,0,0">
                                            <Button Content="应用"
                                                    Style="{StaticResource HeaderActionButtonStyle}"
                                                    Tag="{Binding Id}"
                                                    Click="ApplyProfile_Click"/>
                                            <Button Content="删除"
                                                    Style="{StaticResource HeaderActionButtonStyle}"
                                                    Margin="8,0,0,0"
                                                    Tag="{Binding Id}"
                                                    Click="DeleteProfile_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock x:Name="ProfileEmpty"
                               Text="暂无方案"
                               Style="{StaticResource Text.Meta}"/>
                </StackPanel>
            </Border>

            <!-- ===== 规则库双列 =====
                 两列等宽、等高：外层的 Grid 用 * / *，两张卡各自
                 填满自己那一格，底边自然对齐。
                 v1.1.x 待办：两列各自的规则编辑器（见页首注释）。 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="调校规则库"
                                       Style="{StaticResource CardTitleStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Content="新建"
                                    Style="{StaticResource HeaderActionButtonStyle}"
                                    IsEnabled="False"/>
                        </Grid>

                        <TextBlock Text="暂无规则"
                                   Style="{StaticResource Text.Meta}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="调度规则库"
                                       Style="{StaticResource CardTitleStyle}"
                                       Margin="0"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Content="新建"
                                    Style="{StaticResource HeaderActionButtonStyle}"
                                    IsEnabled="False"/>
                        </Grid>

                        <TextBlock Text="暂无规则"
                                   Style="{StaticResource Text.Meta}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
