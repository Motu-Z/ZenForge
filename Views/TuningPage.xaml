<Page x:Class="ZenForge.Views.TuningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="调校"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <Page.Resources>
        <!-- 调校页数字输入框：与全局 TextBox 同高同圆角（32 / 6），
             只多两件事 —— 内容居中、内缩归零。
             居中是因为这些框里只有 1–4 个字符，左对齐会让一列数字看起来
             全都「挤在左边」，而它们其实是每个核心的独立读数。
             Padding=0：内缩交给 TextAlignment 的居中，再叠加 Padding
             会让居中位置整体偏右 10px。 -->
        <Style x:Key="TuningBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- 与输入框等高的次要按钮。
             基类 MinWidth 是 156，四个按钮并排就要 650px 以上，窄窗口会把 CPU 名挤没，
             这里放宽到 96 —— 按钮内容本来只有两个字，不需要那么宽。 -->
        <Style x:Key="TuningButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- CCD 行标签 -->
        <Style x:Key="CcdTagStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Page.Resources>

    <!-- ======= 页头 =======
         PageTitleStyle 自带下 20 的边距，这里不再叠一层 StackPanel Margin。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,6,28,24">

            <TextBlock Text="调校" Style="{StaticResource PageTitleStyle}"/>

            <!-- ======= CPU 信息卡（v2：两列 Grid，左文字垂直居中 / 右四控件横排） =======
                 布局要点：
                   · 左列 1fr 吃掉剩余宽度，右列 Auto 紧贴内容。窗口拉窄时先压缩
                     CPU 名（TextTrimming 兜底），四个按钮永远完整可见 —— 反过来
                     让按钮先压缩的话，「应用全部」会被压成「应用全」再被截断。
                   · 两行文字用垂直居中而非顶部对齐：卡片有上下 Padding，
                     顶部对齐会在下方留一条空带，卡片看起来「上重下轻」。
                   · 右列按「配置 / 辅助 / 主操作」分三组，组内 8px、组间 16px，
                     详见下方注释。 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 设备身份：左列。
                         初值不用任何具体型号：探测失败时写着「AMD Ryzen 9 9955HX」会误导用户
                         以为识别成功。「/」由探测结果覆盖为真实 CPU 名。

                         【两行层级】
                         主行 18 / SemiBold / 纯白 —— 这是全页最大的非标题文字，
                         它承担「我在调哪颗 CPU」这个身份信息；
                         副行 11 / 46% 白 —— 规格与 SMU 版本是元数据，
                         只用来核对，不该和型号争视线。
                         旧版副行 13 / 60%，与主行只差 5px、只差一档色，
                         读起来像「型号被折成了两行」。 -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock x:Name="CpuNameText"
                                   Text="/"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Text.Primary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="CpuSubText"
                                   Text="正在探测处理器…"
                                   Style="{StaticResource Text.Meta}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- ===== 右列：三组控件，组内紧、组间松 =====
                         分组依据是「一次操作的最小闭环」，不是按钮个数：
                           ① 配置组  加载 / 保存 —— 只和 tuning.json 打交道，两个动作为一对；
                           ② 辅助组  刷新（图标）—— 从 SMU 重读，独立动作，跟配置文件无关；
                           ③ 主操作  应用全部   —— 唯一的写入口，必须视觉最重。

                         间距规则（对齐用户给的 CSS 规范）：
                           组内 8px（.btn 之间）
                           组间 8px 额外 → 合计 16px（.btn-group + .btn-group 的 margin-left）
                         之所以组间要 16 而不是 12：三个按钮各 8px 的间隔，
                         和「组与组」的 16px，肉眼能立刻分出两个层级 ——
                         12px 只比 8 大 4，边框线又在视野里，读不出分组。

                         尺寸统一 32 高：普通按钮由 SecondaryButtonStyle 的 Height=32
                         提供，图标按钮由 SquareIconButtonStyle 的 32×32 提供，
                         三者基线天然对齐，不需要 VerticalAlignment 微调。 -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- ① 配置组 -->
                        <Button x:Name="LoadConfigButton" Content="加载"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"
                                MinWidth="64"
                                Click="LoadConfigButton_Click"/>
                        <Button x:Name="SaveConfigButton" Content="保存"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0"
                                MinWidth="64"
                                Click="SaveConfigButton_Click"/>

                        <!-- ② 辅助组：SMU 重读。
                             Margin 左 16 = 组间距；透明底 + 无边框 = 辅助动作，
                             不与两个文字按钮争视觉重量，只在 hover 时浮出浅底。
                             图标是「圆圈箭头」，24×24 viewBox 内的 2.2px 描边路径：
                               弧线 M21 12a9 9 0 1 1-9-9c2.52 0 4.85.83 6.72 2.24L21 8
                               箭头 M21 3v5h-5
                             用 Viewbox 缩放到 15×15 —— 直接改 Path 的 Width/Height
                             不会缩放笔画，只会裁切。 -->
                        <Button x:Name="RefreshButton"
                                Style="{StaticResource SquareIconButtonStyle}"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="16,0,0,0"
                                IsEnabled="False"
                                ToolTip="从 SMU 重新读取当前值（不写入、不保存）"
                                Click="RefreshButton_Click">
                            <Viewbox Width="15" Height="15">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M21 12a9 9 0 1 1-9-9c2.52 0 4.85.83 6.72 2.24L21 8"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Fill="Transparent"/>
                                    <Path Data="M21 3v5h-5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Fill="Transparent"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <!-- ③ 主操作：应用全部。Margin 左 16 = 组间距。
                             15% 淡底 + 1px 实色强调色边 + 强调色字（PrimaryButtonStyle 已实现），
                             hover 反转成实底深字 —— 它是这一页唯一的「真正生效」入口，
                             视觉必须压过前面所有按钮。 -->
                        <Button x:Name="ApplyAllButton" Content="应用全部"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="16,0,0,0"
                                MinWidth="88"
                                IsEnabled="False"
                                Click="ApplyAllButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======= Curve Optimizer (逐核负压) =======
                 v12 是「8 列等宽网格、无 CCD 标签」。这里用 UniformGrid Columns=8，
                 每格一个输入框，由 BuildCoreGrid 在代码里按核数填充。
                 行间距靠每个格子的 Margin 制造，UniformGrid 没有 RowSpacing。
                 注意：输入框的填充顺序必须严格等于核心号（0..n-1），
                 ApplySnapshot / CollectMargins 都按 CoreBoxes 的索引对位。 -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Curve Optimizer (逐核负压)"
                               Style="{StaticResource CardTitleStyle}"/>

                    <UniformGrid x:Name="CoreGrid" Columns="8"/>

                    <TextBlock x:Name="CoreGridHint"
                               Text="正在读取处理器拓扑…"
                               Style="{StaticResource HintTextStyle}"
                               Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- ======= FMax ======= -->
            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Style="{StaticResource Stack.LabelBlock}"
                                Margin="0,0,24,0">
                        <TextBlock Text="最高加速频率 (FMax)" Style="{StaticResource CardRowLabelStyle}"/>
                        <TextBlock Text="单位 MHz，留空沿用固件默认" Style="{StaticResource CardRowDescStyle}"/>
                    </StackPanel>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 初值留空：4750 是 9955HX 的典型值，换机器后是个错误暗示。
                             探测成功后由 ApplySnapshot 回填真实 FMax。
                             96 宽 + 等宽 16px：四位数（5650）居中后两侧各留约 20px，
                             不会顶到边框，也不会因为比例字体的字宽差而左右跳。 -->
                        <TextBox x:Name="FMaxBox" Text="" Width="96"
                                 Style="{StaticResource TuningBoxStyle}"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 IsEnabled="False"/>
                        <TextBlock Grid.Column="1"
                                   Text="MHz" Margin="8,0,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource Text.Secondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>


            <!-- ======= 电源计划策略（原 PBO 策略，放在 FMax 下方） =======                 【为什么改名】
                 「PBO」在 AMD 语境里特指 SMU 固件层的 Precision Boost Overdrive
                 （功耗墙 / 曲线优化 / Boost 上限）。那一层没有公开 API，只有 BIOS
                 与 AMD 驱动能写 —— 这个下拉框从来就不是它。继续叫 PBO，是在承诺
                 一件做不到的事。改叫「电源计划策略」，名字与它实际控制的
                 Windows 电源方案一一对应，用户去「控制面板 → 电源选项」也能对得上。

                 【这一档到底动了什么】
                 四个 powrprof 索引，全部有返回码、可读可写、可一键换档：
                   · 处理器性能提升模式（PERFBOOSTMODE）
                   · 最大处理器状态（PROCTHROTTLEMAX，百分比上限）
                   · 能效偏好（PERFEPP，0=性能 100=能效）
                   · 处理器空闲禁用（IDLEDISABLE）
                 具体每档的取值见 Services/ProcessorPowerPolicy.cs。 -->
            <Border x:Name="PowerPlanCard" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Style="{StaticResource Stack.LabelBlock}"
                                Margin="0,0,24,0">
                        <TextBlock Text="电源计划策略"
                                   Style="{StaticResource CardRowLabelStyle}"/>
                        <TextBlock x:Name="PlanHint"
                                   Text="正在读取当前电源方案…"
                                   Style="{StaticResource CardRowDescStyle}"/>
                    </StackPanel>

                    <!-- 初值 IsEnabled=False：档位是读出来才知道的，
                         读完前不能按（否则用户点了一个「我以为能改」的控件）。
                         宽度 148 是为容纳「解除限制」四个字 + 下拉箭头。 -->
                    <ComboBox Grid.Column="1" x:Name="PlanCombo"
                              Width="148"
                              VerticalAlignment="Center"
                              IsEnabled="False"
                              SelectionChanged="PlanCombo_SelectionChanged">
                        <ComboBoxItem Content="解除限制"/>
                        <ComboBoxItem Content="温和"/>
                        <ComboBoxItem Content="均衡"/>
                        <ComboBoxItem Content="静音"/>
                    </ComboBox>
                </Grid>
            </Border>


            <!-- ======= 升频模式 =======
                 Windows 电源管理里「处理器性能提升模式」那一项，值即位掩码
                 （0 停用 / 1 启用 / 2 积极 / 3 高效 / 4 积极且高效）。
                 与上面那张卡的档位相互独立：换档位不会改这一项，改这一项也不会换档位 ——
                 两个旋钮管的是不同的事（档位是整套策略，这项只是升频行为）。
                 读写实现在 Services/ProcessorPowerTuning.cs。 -->
            <Border x:Name="BoostCard" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Style="{StaticResource Stack.LabelBlock}"
                                Margin="0,0,24,0">
                        <TextBlock Text="升频模式" Style="{StaticResource CardRowLabelStyle}"/>
                        <TextBlock x:Name="BoostHint"
                                   Text="正在读取当前升频模式…"
                                   Style="{StaticResource CardRowDescStyle}"/>
                    </StackPanel>

                    <!-- 初值禁用：读到系统值之前不提供选择，避免「点了却不知道原本是什么」 -->
                    <ComboBox Grid.Column="1" x:Name="BoostCombo"
                              Width="148"
                              VerticalAlignment="Center"
                              IsEnabled="False"
                              SelectionChanged="BoostCombo_SelectionChanged">
                        <ComboBoxItem Content="积极且高效"/>
                        <ComboBoxItem Content="积极"/>
                        <ComboBoxItem Content="已启用"/>
                        <ComboBoxItem Content="高效"/>
                        <ComboBoxItem Content="已停用"/>
                    </ComboBox>
                </Grid>
            </Border>


            <!-- ======= 核心停放 =======
                 powrprof 的范围型索引 CPMINMAX（0cc5b647-…），滑杆同时写 Min 与 Max。
                 为什么不做两条滑杆：Min > Max 会被 Windows 判为非法并静默钳制，
                 用户拖完看到数值跳回去，比只有一个旋钮更困惑。

                 【三种状态，绝不出现「能拖但拖了没用」】
                 A. 可读可写 —— 滑块 + 输入框 + 一句话说明。正常态。
                 B. 读不到   —— 整张卡折叠成一条提示：标题 + 一行原因，控件全部隐藏。
                                 旧版把滑块灰着留在那儿，用户拖了没反应又不知道为什么，
                                 这是「像 Bug 的界面」；控件既然用不上，就不该占位。
                 C. 写入失败 —— 只有 toast + 日志，控件保持可用（可重试），
                                 不在这里做额外的置灰状态。

                 【对齐】
                 左文字块与右控件组同在垂直中线上：
                   · 两侧都写 VerticalAlignment="Center"；
                   · 输入框与滑杆同为 32 高（滑杆本身 32 高、轨道居中绘制），
                     所以「滑杆中线 = 输入框中线 = 百分比中线」天然重合，
                     不需要任何 Petting 微调。
                 旧版的 % 号单独垂直居中，但输入框带 1px 边框、内部
                 Padding 又与滑杆不同，三者各偏 0.5–1px，看着就是「没对齐」。 -->
            <Border x:Name="ParkingCard" Style="{StaticResource CardBorderStyle}">
                <StackPanel>

                    <!-- ============================================================
                         【两态互斥，不是并排】
                         以前 ParkingScaleHint 写在两个面板之外，于是「读不到」时
                         它照样显示，并且因为它位于折叠面板之上，屏幕上呈现出
                         「0% 允许全部核心停放 · 100% 禁止停放」压在
                         「⚠ 核心停放」标题上面的倒序 —— 说明跑到了标题前面。
                         现在提示归入状态 A 内部，状态 B 换成单行「标题 + 原因」，
                         两块严格二选一：没有功能就不出现任何解释功能怎么用的文字。
                         ============================================================ -->

                    <!-- ===== 状态 A：正常（可读写） =====
                         【必须是 Grid 而不是 StackPanel】
                         这一块是「左文字 / 右控件」两栏，靠 ColumnDefinitions 分栏。
                         改成 StackPanel 会直接抛 InvalidCastException
                         （StackPanel 没有 ColumnDefinitions 这个属性），
                         整页 XAML 加载失败。行 0 = 两栏主体，行 1 = 跨两列的端点说明。 -->
                    <Grid x:Name="ParkingEditablePanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0"
                                    Style="{StaticResource Stack.LabelBlock}"
                                    Margin="0,0,24,0">
                            <TextBlock Text="核心停放" Style="{StaticResource CardRowLabelStyle}"/>
                            <TextBlock x:Name="ParkingHint"
                                       Text="正在读取当前核心停放设置…"
                                       Style="{StaticResource CardRowDescStyle}"/>
                        </StackPanel>

                        <!-- 数值区：滑杆 / 输入框 / 单位，三者同高同中线 -->
                        <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="ParkingSlider"
                                    Grid.Column="0"
                                    Width="200" Height="32"
                                    Minimum="0" Maximum="100"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    SmallChange="5" LargeChange="20"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"
                                    PreviewMouseUp="ParkingSlider_PreviewMouseUp"
                                    ValueChanged="ParkingSlider_ValueChanged"/>

                            <!-- 输入框 56 宽：32 只够放两位数字 + 内缩，
                                 三位数（100）会被截掉末位的描边。 -->
                            <TextBox x:Name="ParkingBox"
                                     Grid.Column="1"
                                     Width="56" Height="32"
                                     Margin="14,0,0,0"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Center"
                                     Style="{StaticResource TuningBoxStyle}"
                                     IsEnabled="False"
                                     KeyDown="ParkingBox_KeyDown"
                                     LostFocus="ParkingBox_LostFocus"/>

                            <!-- % 号与数字之间 6px，且 12px 字号 —— 单位不该和数值一样重 -->
                            <TextBlock Grid.Column="2"
                                       Text="%"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"/>
                        </Grid>

                        <!-- 端点语义：0% / 100% 是什么意思。
                             只在状态 A 内出现 —— 读不到值时解释「怎么用」没有意义。
                             与上方说明行隔 8px、字号降一级（L6 元数据）。
                             左内缩 24 与文字块对齐（Grid 第 0 列起点）。 -->
                        <TextBlock x:Name="ParkingScaleHint"
                                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="0% 允许全部核心停放 · 100% 禁止停放"
                                   Style="{StaticResource Text.Meta}"
                                   Margin="0,10,0,0"/>
                    </Grid>

                    <!-- ===== 状态 B：读不到（整块折叠成提示） =====
                         【为什么只有一句 12 字的话】
                         这一格的职责是「告诉你它现在用不了」，不是解释电源方案的索引结构。
                         旧版把 powrprof 的原始错误串直接拼进正文，屏幕上出现了
                         「当前系统无法读取核心停放设置（当前电源方案不提供核心停放设置。），
                         此项已停用。」—— 一句话里说了两遍同一件事，还带着嵌套括号和句号。
                         原始错误现在只进日志。 -->
                    <StackPanel x:Name="ParkingUnavailablePanel" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="13" Height="13"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Stretch="Uniform"
                                  Stroke="{DynamicResource State.Warning}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="Transparent"
                                  Data="M 8,1 L 15,14 L 1,14 Z M 8,6 L 8,10 M 8,12 L 8,12.1"/>
                            <TextBlock Text="核心停放"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CardRowLabelStyle}"/>
                        </StackPanel>
                        <TextBlock x:Name="ParkingUnavailableText"
                                   Text="当前电源方案不支持核心停放，此项已停用"
                                   Style="{StaticResource CardRowDescStyle}"
                                   Margin="21,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
