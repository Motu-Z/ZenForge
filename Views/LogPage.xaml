<Page x:Class="ZenForge.Views.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:services="clr-namespace:ZenForge.Services"
      Title="日志"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <!-- 单卡结构（与 NvForge 对齐）：标题行 → 内容面板 → 工具行。
         原独立页头卡已移除，标题与「打开日志目录」移入本卡标题行。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,24,32,24">

    <!-- ======= 页头 ======= -->
    <StackPanel Margin="0,0,0,20">
        <TextBlock Text="日志" Style="{StaticResource PageTitleStyle}"/>
    </StackPanel>

    <Border Style="{StaticResource CardBorderStyle}" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ======= 标题行：左「运行日志」，右「打开日志目录」 ======= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="运行日志"
                           Style="{StaticResource CardTitleStyle}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="打开日志目录"
                        Style="{StaticResource HeaderActionButtonStyle}"
                        VerticalAlignment="Center"
                        Click="OpenLogFolderButton_Click"/>
            </Grid>

            <!-- ======= 日志列表（深色圆角面板，按级别着色） ======= -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Log.Background}"
                    BorderBrush="{DynamicResource Log.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Margin="0,12,0,0"
                    MinHeight="320">
                <!-- CanContentScroll=True 是虚拟化的开关。
                     ListBox 默认不开（只有 ListView 默认开），不写这一条，
                     日志上限 2000 条就会被全部实例化成真实容器：
                     列表越滚越卡，点「清空」时要一次性销毁两千个带模板的项，
                     表现就是界面直接卡死。 -->
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding Source={x:Static services:LogService.Entries}}"
                         HorizontalContentAlignment="Stretch"
                         Background="Transparent"
                         Foreground="{DynamicResource Log.Info}"
                         BorderThickness="0"
                         Padding="6,4"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Top"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource List.Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss'}"
                                           Foreground="{DynamicResource Text.Disabled}"
                                           FontFamily="Consolas, Cascadia Mono"
                                           FontSize="12"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding LevelText}"
                                           Margin="8,0,8,0"
                                           FontFamily="Consolas, Cascadia Mono"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Log.Info}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource Log.Warn}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource Log.Error}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Log.Info}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                    <Setter Property="Foreground" Value="{DynamicResource Log.Warn}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter Property="Foreground" Value="{DynamicResource Log.Error}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- ======= 底部工具行 ======= -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="FollowToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  IsChecked="True"
                                  VerticalAlignment="Center"/>
                    <TextBlock Text="跟随最新" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"/>

                    <!-- 详细日志开关：
                         过去 Debug 级只在启动参数 / 环境变量里开，用户遇到问题时
                         得知道去哪儿加参数才有日志，等于没有。这里给一个当场可切
                         的开关，复现前打开即可。 -->
                    <ToggleButton x:Name="VerboseToggle"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Margin="20,0,0,0"
                                  VerticalAlignment="Center"
                                  Click="VerboseToggle_Click"/>
                    <TextBlock Text="详细日志" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}"
                               ToolTip="记录每次点击、焦点变化、改名开始/提交/取消、列表刷新等细节。&#10;只在排查问题时临时打开，日志文件增长较快。"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           x:Name="LogCountText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Text.Secondary}"
                           FontSize="12"/>
                <Button Grid.Column="2" Content="清空日志"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Right"
                        Padding="18,0" Margin="0"
                        Click="ClearLogButton_Click"/>
            </Grid>
        </Grid>
    </Border>
    </StackPanel>
    </ScrollViewer>
</Page>
