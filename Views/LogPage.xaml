<Page x:Class="ZenForge.Views.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ZenForge.Views"
      Title="日志"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <!--
        ============================================================
        日志页版式规格（v12）
        ============================================================
        页头：左「日志 + 本次会话共 N 条」/ 右 [暂停] [目录] [清空]
        pill 组：调试 / 信息 / 警告 / 错误 四枚圆角胶囊，各带一个 6px 圆点与计数
        搜索框：通栏 38 高，按文本 / 字段 / 来源筛选
        日志卡片：左侧 3px 级别色竖条 + 等宽时间 + 级别徽章 + 正文

        与旧版的差别：
          · 旧版把所有日志塞进一个深色面板，正文按级别整段染色（INFO 是青色文字），
            一眼看过去全是彩色，反而不容易定位问题。v12 改成「正文主色 + 只染竖条和徽章」。
          · 级别不再用文字 "INFO"/"WARN" 直接换色，而是套一个 20% 级别色底的圆角小徽章。
          · 统计从底部一行 "共 N 条" 拆成顶部四枚 pill，能看到级别分布。
    -->

    <Page.Resources>
        <!-- 日志行容器：灰底 + 1px 边 + 左侧 3px 级别色条。v12 的 .log-item -->
        <Style x:Key="LogItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,10,16,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 时间列：等宽字体、次要色、固定 84 宽保证各行对齐 -->
        <Style x:Key="LogTimeTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- 级别徽章：2,6 内边距 + 圆角 4 + 12% 级别色底。底色由触发器按级别切换 -->
        <Style x:Key="LogBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="LogBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Log.Info}"/>
        </Style>
    </Page.Resources>

    <!-- ==================================================================
         【顶部必须四行，不能挤在同一个格子】

         历史问题：页头 Grid、PillHost、搜索 Grid 三个元素**全都写了
         Grid.Row="0"**，而且后两者还带了 VerticalAlignment="Bottom"。
         外层 Grid 当时只有两行（Auto / *），这三个东西就被叠在同一格里，
         底边对齐 → 标题、副标题、搜索占位符、四枚 pill 全部压在一起。

         WPF 的 Grid 不会因为「子元素太多」而自动换行或报错，它只会安静地
         把后来的元素盖在先来的元素上。这类重叠编译器查不出来，只能靠
         布局结构本身保证「一格一件事」。

         现在一行一个区块，各占各的行：
           Row 0  页头：左标题 + 右操作按钮
           Row 1  级别 pill
           Row 2  搜索框
           Row 3  日志列表（占满剩余高度）
         ================================================================== -->
    <Grid Margin="24,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 页头 -->
            <RowDefinition Height="Auto"/>   <!-- 级别 pill -->
            <RowDefinition Height="Auto"/>   <!-- 搜索 -->
            <RowDefinition Height="*"/>      <!-- 日志列表 -->
        </Grid.RowDefinitions>

        <!-- ======= Row 0：页头（左标题 + 右操作） ======= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- 左列 * 吃掉剩余宽度：窗口拉窄时先压缩标题区（标题有
                     TextTrimming 兜底），三个操作按钮永远完整可见。 -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Text="日志" Style="{StaticResource PageTitleStyle}"/>
                <!-- PageSubStyle 自带 Margin="0,6,0,0"，这里不再叠加 -->
                <TextBlock x:Name="LogSubText"
                           Text="本次会话暂无记录"
                           Style="{StaticResource PageSubStyle}"/>
            </StackPanel>

            <!-- 操作按钮与副标题底边对齐：视觉上贴着标题块的下沿，
                 而不是浮在标题右侧的垂直中央。 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="PauseButton" Content="暂停"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="PauseButton_Click"
                        ToolTip="暂停只冻结界面刷新，日志仍照常写入文件"/>
                <Button Content="目录"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="OpenLogFolderButton_Click"
                        ToolTip="在资源管理器中打开日志目录"/>
                <Button Content="清空"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0"
                        Click="ClearLogButton_Click"
                        ToolTip="清空内存中的日志（文件保留，便于事后追溯）"/>
            </StackPanel>
        </Grid>

        <!-- ======= Row 1：级别 pill =======
             列为独立一行，去掉原来的 VerticalAlignment="Bottom" ——
             在 Auto 行里再写 Bottom 没有意义，反而会在 pill 为空时
             把 WrapPanel 拉到该行底边，和下面的搜索框贴到一起。 -->
        <WrapPanel x:Name="PillHost"
                   Grid.Row="1"
                   Orientation="Horizontal"
                   Margin="0,0,0,12"/>

        <!-- ======= Row 2：搜索 =======
             同样去掉 VerticalAlignment="Bottom"。 -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource SearchBoxStyle}"
                     TextChanged="SearchBox_TextChanged"
                     GotFocus="SearchBox_GotFocus"
                     LostFocus="SearchBox_LostFocus"
                     KeyDown="SearchBox_KeyDown"/>
            <TextBlock x:Name="SearchPlaceholder"
                       Text="按文本、字段或来源筛选"
                       Margin="34,0,0,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       FontSize="12"
                       Foreground="{DynamicResource Text.Disabled}"/>
        </Grid>

        <!-- ======= Row 3：日志列表（占满剩余高度） ======= -->
        <Grid Grid.Row="3">
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding Source={x:Static local:LogPage.VisibleEntries}}"
                     HorizontalContentAlignment="Stretch"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <!-- 容器不画任何东西：底色、边框、左边色条全由行模板里的 Border 负责，
                         容器只保留 hit-test 与选中态的半透明高亮。 -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Sel" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Sel" Property="Background"
                                                    Value="{DynamicResource Nav.Button.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Card" Style="{StaticResource LogItemBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Time, StringFormat='HH:mm:ss.fff'}"
                                           Width="84"
                                           Style="{StaticResource LogTimeTextStyle}"/>

                                <Border x:Name="Badge" Grid.Column="1"
                                        Style="{StaticResource LogBadgeBorderStyle}"
                                        Margin="0,0,12,0">
                                    <TextBlock x:Name="BadgeText"
                                               Text="{Binding LevelText}"
                                               Style="{StaticResource LogBadgeTextStyle}"/>
                                </Border>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Message}"
                                           TextWrapping="Wrap"
                                           FontSize="13"
                                           LineHeight="21"
                                           Foreground="{DynamicResource Text.Primary}"/>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- 级别配色：只染左边竖条 + 徽章底色 + 徽章文字。
                                 全部走 Palette 里的语义色键，不在模板里写死十六进制：
                                 写死的话深浅两册无法各自取值，换主题后徽章底色会变成
                                 「深色册的 18% 透明度压在浅色卡片上」的脏色。 -->
                            <DataTrigger Binding="{Binding Level}" Value="Debug">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource Text.Disabled}"/>
                                <Setter TargetName="Badge" Property="Background"
                                        Value="{DynamicResource Input.Background}"/>
                                <Setter TargetName="BadgeText" Property="Foreground"
                                        Value="{DynamicResource Text.Disabled}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource Log.Warn}"/>
                                <Setter TargetName="Badge" Property="Background"
                                        Value="{DynamicResource Log.WarnTint}"/>
                                <Setter TargetName="BadgeText" Property="Foreground"
                                        Value="{DynamicResource Log.Warn}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource Log.Error}"/>
                                <Setter TargetName="Badge" Property="Background"
                                        Value="{DynamicResource Log.ErrorTint}"/>
                                <Setter TargetName="BadgeText" Property="Foreground"
                                        Value="{DynamicResource Log.Error}"/>
                            </DataTrigger>

                            <!-- 致命：深红竖条 + 深红徽章字。
                                 放在 Error 之后声明，同优先级下后声明者生效，
                                 确保 Critical 拿到的是 #C42B1C 而不是 Error 的 #FF453A。 -->
                            <DataTrigger Binding="{Binding Level}" Value="Critical">
                                <Setter TargetName="Card" Property="BorderBrush"
                                        Value="{DynamicResource Log.Critical}"/>
                                <Setter TargetName="Badge" Property="Background"
                                        Value="{DynamicResource Log.CriticalTint}"/>
                                <Setter TargetName="BadgeText" Property="Foreground"
                                        Value="{DynamicResource Log.Critical}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint"
                       Text="暂无日志"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Style="{StaticResource HintTextStyle}"/>
        </Grid>
    </Grid>
</Page>
