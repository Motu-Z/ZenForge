<Page x:Class="ZenForge.Views.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ZenForge.Views"
      xmlns:ctl="clr-namespace:ZenForge.Controls"
      Title="日志"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <!--
        ============================================================
        日志页版式规格（v12）
        ============================================================
        页头：左「日志 + 本次会话共 N 条」/ 右 [暂停] [目录] [清空]
        pill 组：调试 / 信息 / 警告 / 错误 四枚圆角胶囊，各带一个 6px 圆点与计数
        搜索框：通栏 38 高，按文本 / 字段 / 来源筛选
        日志卡片：左侧 3px 级别色竖条 + 等宽时间 + 级别徽章 + 正文

        与旧版的差别：
          · 旧版把所有日志塞进一个深色面板，正文按级别整段染色（INFO 是青色文字），
            一眼看过去全是彩色，反而不容易定位问题。v12 改成「正文主色 + 只染竖条和徽章」。
          · 级别不再用文字 "INFO"/"WARN" 直接换色，而是套一个 20% 级别色底的圆角小徽章。
          · 统计从底部一行 "共 N 条" 拆成顶部四枚 pill，能看到级别分布。
    -->

    <Page.Resources>
        <!-- 日志行：无边框，靠 1px 底色分层与左侧 2px 级别色条区分。
             旧版每行都是一张带边框的小卡片，一屏十条就是十个方框，
             读完「级别」还要再读一遍「边框」——边框没有任何信息量。
             改成无边框 + 极淡底色后，只有级别色条和徽章在着色，
             眼睛可以顺着色条从上往下扫。 -->
        <Style x:Key="LogItemBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- 时间戳：L6 元数据 + 等宽。等宽是为了让每一行的毫秒位对齐，
             一行 12:00:01.233、下一行 12:00:01.9 时列不会左右错开。 -->
        <Style x:Key="LogTimeTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.MetaBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- 级别徽章：12% 级别色底 + 圆角 4。底色由 DataTrigger 按级别切换。 -->
        <Style x:Key="LogBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="LogBadgeTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource Log.Info}"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- 日志页工具按钮：28 高，与 pill 严格等高。
             由 SecondaryButtonStyle 派生，只压高度与内缩 ——
             底色、圆角、hover 规则全部继承，不另起一套视觉。 -->
        <Style x:Key="LogToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Page.Resources>

    <!-- ==================================================================
         【顶部必须四行，不能挤在同一个格子】

         历史问题：页头 Grid、PillHost、搜索 Grid 三个元素**全都写了
         Grid.Row="0"**，而且后两者还带了 VerticalAlignment="Bottom"。
         外层 Grid 当时只有两行（Auto / *），这三个东西就被叠在同一格里，
         底边对齐 → 标题、副标题、搜索占位符、四枚 pill 全部压在一起。

         WPF 的 Grid 不会因为「子元素太多」而自动换行或报错，它只会安静地
         把后来的元素盖在先来的元素上。这类重叠编译器查不出来，只能靠
         布局结构本身保证「一格一件事」。

         现在一行一个区块，各占各的行：
           Row 0  页头：左标题 + 右操作按钮
           Row 1  级别 pill
           Row 2  搜索框
           Row 3  日志列表（占满剩余高度）
         ================================================================== -->
    <Grid Margin="28,6,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 页头 -->
            <RowDefinition Height="Auto"/>   <!-- 级别 pill -->
            <RowDefinition Height="Auto"/>   <!-- 搜索 -->
            <RowDefinition Height="*"/>      <!-- 日志列表 -->
        </Grid.RowDefinitions>

        <!-- ======= Row 0：页头（左标题 + 右操作） ======= -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- 左列 * 吃掉剩余宽度：窗口拉窄时先压缩标题区（标题有
                     TextTrimming 兜底），三个操作按钮永远完整可见。 -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- VerticalAlignment="Bottom"：标题 26 + 副行 11 组成的块，
                 与右侧 32 高的按钮组底边对齐 —— 顶部对齐会让按钮看起来
                 「挂在标题上方」。 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                <TextBlock Text="日志" Style="{StaticResource PageTitleStyle}" Margin="0"/>
                <TextBlock x:Name="LogSubText"
                           Text="本次会话暂无记录"
                           Style="{StaticResource PageSubStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ======= Row 1：级别 pill + 工具按钮 =======
             【一行五件事，全部 28 高】
             左：信息 / 警告 / 错误 / 致命 四枚 pill（WrapPanel，窄窗口时整体
             换行但仍是同一组）；右：暂停 / 目录 / 清空 三个按钮。

             三等高的实现：pill 与按钮都写死 28，且都 VerticalAlignment="Center"。
             旧版 pill 26 / 按钮 32，行高取 32，pill 上下各悬空 3px —— 肉眼看是
             「四个胶囊飘在一条更粗的带子里」。统一到 28 之后它们的上下边缘
             严格重合，读起来才是一整行工具栏。

             按钮降到 28 而不是把 pill 抬到 32：pill 是筛选器（轻），按钮是动作（重），
             让胶囊更高会喧宾夺主；28 也正好是 TitleBarButton 与徽章的高度，
             全工程的「小控件」从此只有这一个尺寸。 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <WrapPanel x:Name="PillHost"
                       Grid.Column="0"
                       Orientation="Horizontal"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">
                <Button x:Name="PauseButton" Content="暂停日志记录"
                        Style="{StaticResource LogToolButtonStyle}"
                        Click="PauseButton_Click"
                        ToolTip="暂停后会丢弃新产生的日志：既不进界面，也不写文件"/>
                <Button Content="目录"
                        Style="{StaticResource LogToolButtonStyle}"
                        Click="OpenLogFolderButton_Click"
                        ToolTip="在资源管理器中打开日志目录"/>
                <Button Content="清空文件和内存"
                        Style="{StaticResource LogToolButtonStyle}"
                        Margin="0"
                        Click="ClearLogButton_Click"
                        ToolTip="删除全部日志文件，并清空当前界面上的记录"/>
            </StackPanel>
        </Grid>

        <!-- ======= Row 2：搜索 =======
             统一用 zenforge:SearchBox：图标、文本、占位符的几何全在控件模板里，
             页面只给高度与事件。
             上一版在这一格叠了三个元素（Path / TextBox / TextBlock），
             三者各写一次 Margin，其中占位符还在 TextBox 的内部坐标上再加 32，
             于是文字整体右移、看起来像「搜索框从中间开始」。
             现在这个位置只有一个控件，没有可以写错的第二个坐标。 -->
        <ctl:SearchBox Grid.Row="2"
                       x:Name="SearchBox"
                       Margin="0,0,0,14"
                       Placeholder="按文本、字段或来源筛选"
                       TextChanged="SearchBox_TextChanged"
                       InputKeyDown="SearchBox_KeyDown"/>

        <!-- ======= Row 3：日志列表（占满剩余高度） ======= -->
        <Grid Grid.Row="3">
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding Source={x:Static local:LogPage.VisibleEntries}}"
                     HorizontalContentAlignment="Stretch"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <!-- 容器不画任何东西：底色、边框、左边色条全由行模板里的 Border 负责，
                         容器只保留 hit-test 与选中态的半透明高亮。 -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Sel" Background="Transparent" CornerRadius="6">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Sel" Property="Background"
                                                    Value="{DynamicResource Nav.Button.Hover}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 【行结构：2px 级别色条 + 徽章 + 时间 + 正文】
                             色条用 Grid 第 0 列而不是叠在 Border 边上 ——
                             叠上去会被 Border 的圆角切掉首尾，看起来像断成了三截。
                             放在列里则随内容高度自然拉伸，永远是一条完整的竖线。 -->
                        <Border x:Name="Card" Style="{StaticResource LogItemBorderStyle}" Padding="0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Bar"
                                        Grid.Column="0"
                                        Background="{DynamicResource Log.Info}"
                                        CornerRadius="2,0,0,2"
                                        VerticalAlignment="Stretch"/>

                                <Grid Grid.Column="1" Margin="12,9,12,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="Badge" Grid.Column="0"
                                            Style="{StaticResource LogBadgeBorderStyle}"
                                            Margin="0,2,10,0"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="BadgeText"
                                                   Text="{Binding LevelText}"
                                                   Style="{StaticResource LogBadgeTextStyle}"/>
                                    </Border>

                                    <!-- 时间 11px 等宽：HH:mm:ss.fff 实测 62px，给 66 留 4px 余量 -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Time, StringFormat='HH:mm:ss.fff'}"
                                               Width="66"
                                               Style="{StaticResource LogTimeTextStyle}"
                                               VerticalAlignment="Top"
                                               Margin="0,5,10,0"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               TextWrapping="Wrap"
                                               FontSize="13"
                                               LineHeight="20"
                                               Foreground="{DynamicResource Text.Primary}"
                                               TextOptions.TextFormattingMode="Display"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- 级别配色：只染左边色条 + 徽章底色 + 徽章文字。
                                 全部走 Palette 里的语义色键，不在模板里写死十六进制：
                                 写死的话深浅两册无法各自取值，换主题后徽章底色会变成
                                 「深色册的 18% 透明度压在浅色卡片上」的脏色。 -->
                            <DataTrigger Binding="{Binding Level}" Value="Debug">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource Text.Disabled}"/>
                                <Setter TargetName="Badge" Property="Background"
                                        Value="{DynamicResource Input.Background}"/>
                                <Setter TargetName="BadgeText" Property="Foreground"
                                        Value="{DynamicResource Text.MetaBrush}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource Log.Warn}"/>
                                <Setter TargetName="Badge" Property="Background"
                                        Value="{DynamicResource Log.WarnTint}"/>
                                <Setter TargetName="BadgeText" Property="Foreground"
                                        Value="{DynamicResource Log.Warn}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource Log.Error}"/>
                                <Setter TargetName="Badge" Property="Background"
                                        Value="{DynamicResource Log.ErrorTint}"/>
                                <Setter TargetName="BadgeText" Property="Foreground"
                                        Value="{DynamicResource Log.Error}"/>
                            </DataTrigger>

                            <!-- 致命：深红竖条 + 深红徽章字。
                                 放在 Error 之后声明，同优先级下后声明者生效，
                                 确保 Critical 拿到的是 #C42B1C 而不是 Error 的 #FF453A。 -->
                            <DataTrigger Binding="{Binding Level}" Value="Critical">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource Log.Critical}"/>
                                <Setter TargetName="Badge" Property="Background"
                                        Value="{DynamicResource Log.CriticalTint}"/>
                                <Setter TargetName="BadgeText" Property="Foreground"
                                        Value="{DynamicResource Log.Critical}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="EmptyHint"
                       Text="暂无日志"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False"
                       Style="{StaticResource HintTextStyle}"/>
        </Grid>
    </Grid>
</Page>
