<UserControl x:Class="ZenForge.Views.LogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:ZenForge.Views"
      xmlns:ctl="clr-namespace:ZenForge.Controls"
      Focusable="False"
      FocusVisualStyle="{x:Null}">

    <!--
        ============================================================
        日志页版式规格（v1.0.2）
        ============================================================
        页头：日志（L1），无副行 —— 条数已经在 pill 上，副行是重复信息
        工具卡：行1 [三枚级别 pill] …… [详细日志 开关]
                行2 [搜索框 300]    …… [暂停][清空][目录]
        列表卡：左侧 3px 语义色竖条 + 等宽时间 + 级别 + 正文，虚拟化回收

        【为什么这一页没有外层 ScrollViewer】
        外层 ScrollViewer 会用「无限高度」测量子内容，列表拿不到确定高度，
        VirtualizingStackPanel 会退化成全量建树。所以整页只有三行骨架，
        列表钉在 * 行里，滚动由列表自己负责 —— 见 MainWindow 的同一条注释。

        【为什么只有三枚 pill】
        参考图是三枚（信息 / 警告 / 错误）。致命级（Critical）归并到「错误」：
        另开一枚常驻 0 的胶囊既占位置又没人点，而把 Critical 漏在筛选之外
        会导致「点错误 → 致命日志消失」。筛选条件对 Error 与 Critical
        同时生效，列表里两者仍用各自的竖条颜色区分。
    -->

    <UserControl.Resources>
        <!-- 时间戳：L6 元数据 + 等宽。等宽是为了让每一行的毫秒位对齐，
             一行 12:00:01.233、下一行 12:00:01.9 时列不会左右错开。
             固定 80 宽（参考图 .log-time 的 min-width:80px），
             比最长串 62px 多留 18px，右侧留白与级别列对齐。 -->
        <Style x:Key="LogTimeTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.MetaBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- 级别：固定 50 宽（参考图 .log-level 的 width:50px）。
             宽度锁死是为了让三行正文的起点严格对齐 —— 让「级别」这一列
             自己决定宽度的话，INFO / WARN 差 1 个字，正文就会左右错开。 -->
        <Style x:Key="LogLevelTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Log.Info}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="LogMessageTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,6,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 页头 -->
            <RowDefinition Height="Auto"/>   <!-- 工具卡 -->
            <RowDefinition Height="*"/>      <!-- 列表卡（占满剩余高度） -->
        </Grid.RowDefinitions>

        <!-- ======= Row 0：页头 ======= -->
        <TextBlock Grid.Row="0"
                   Text="日志"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,0,0,16"/>

        <!-- ======= Row 1：工具卡 ======= -->
        <Border Grid.Row="1"
                Style="{StaticResource CardBorderStyle}"
                Margin="0,0,0,16">
            <StackPanel>
                <!-- 行 1：左 pill 组 / 右 详细日志 开关。
                     pill 28 高、开关 20 高，两者都 VerticalAlignment=Center，
                     落在同一条水平线上；整行高 28。 -->
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <ToggleButton x:Name="PillInfo"
                                      Style="{StaticResource LogPillStyle}"
                                      Content="信息 0"
                                      Checked="Pill_Checked"
                                      Unchecked="Pill_Unchecked"/>
                        <ToggleButton x:Name="PillWarn"
                                      Style="{StaticResource LogPillWarnStyle}"
                                      Content="警告 0"
                                      Checked="Pill_Checked"
                                      Unchecked="Pill_Unchecked"/>
                        <ToggleButton x:Name="PillError"
                                      Style="{StaticResource LogPillErrorStyle}"
                                      Content="错误 0"
                                      Margin="0"
                                      Checked="Pill_Checked"
                                      Unchecked="Pill_Unchecked"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <TextBlock Text="详细日志"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Label}"
                                   Foreground="{DynamicResource Text.Secondary}"/>
                        <ToggleButton x:Name="VerboseToggle"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      Checked="VerboseToggle_Checked"
                                      Unchecked="VerboseToggle_Unchecked"/>
                    </StackPanel>
                </Grid>

                <!-- 行 2：左搜索框 / 右三个按钮。
                     上距 20 与卡内行距同一档；本行是卡内最后一行，
                     下距 0 —— 卡片的 22px Padding 就是它的下边距，
                     再写 20 会让卡片底部多出一条空白。 -->
                <Grid Margin="0,20,0,0">
                    <ctl:SearchBox x:Name="SearchBox"
                                   Width="300"
                                   HorizontalAlignment="Left"
                                   Placeholder="按文本或来源筛选"
                                   TextChanged="SearchBox_TextChanged"
                                   InputKeyDown="SearchBox_KeyDown"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="PauseButton"
                                Content="暂停"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="PauseButton_Click"/>
                        <Button Content="清空"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ClearLogButton_Click"/>
                        <Button Content="目录"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0"
                                Click="OpenLogFolderButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ======= Row 2：列表卡 =======
             卡内只有列表一项，Padding 收到 16：列表自己带着 8px 行距，
             再垫 22 会让首行贴不到卡片顶部、末行离底边太远。 -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Padding="16">
            <ListBox x:Name="LogListBox"
                     ItemsSource="{Binding Source={x:Static local:LogPage.VisibleEntries}}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     FocusVisualStyle="{x:Null}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- 必须显式指定：默认的 VirtualizingStackPanel 只有在
                             CanContentScroll=True 时才生效，两者缺一，
                             两千行日志会一次性全部实例化。 -->
                        <VirtualizingStackPanel IsVirtualizing="True"
                                                VirtualizationMode="Recycling"
                                                CanHorizontallyScroll="False"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <!-- 容器只保留 hit-test 与 6px 圆角，不画任何东西：
                         底色、边框、左边色条全由行模板里的 Border 负责。
                         容器自己再画一层的话，选中时会出现两层底色叠加。 -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 行结构：3px 级别色条 + 时间 + 级别 + 正文。
                             色条用第 0 列而不是叠在 Border 边上：
                             叠上去会被圆角切掉首尾，看起来像断成三截；
                             放在列里则随内容高度自然拉伸，永远是一条完整的竖线。 -->
                        <Border x:Name="Row" Style="{StaticResource LogRowBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="Bar"
                                        Grid.Column="0"
                                        Background="{DynamicResource Log.Info}"
                                        CornerRadius="2,0,0,2"/>

                                <Grid Grid.Column="1" Margin="13,12,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Time, StringFormat='HH:mm:ss.ff'}"
                                               Style="{StaticResource LogTimeTextStyle}"/>

                                    <TextBlock x:Name="LevelText"
                                               Grid.Column="1"
                                               Text="{Binding LevelText}"
                                               Style="{StaticResource LogLevelTextStyle}"/>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               Style="{StaticResource LogMessageTextStyle}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <!-- ★ 行状态数据驱动（1.0.2 硬约束的落地示例）★
                                 选中底色不再由代码写 Border.Background，而是
                                 绑定到【容器】的 IsSelected 上。

                                 为什么这样就不会「选中色跟着滚动条跑」：
                                 容器被 Recycling 复用时，这个 RelativeSource
                                 绑定会重新求值并在下一帧把底色改回来；
                                 而命令式写法里的 Brush 是**曾经被赋值过的值**，
                                 复用时没人再写一次，于是留在旧容器身上的
                                 选中底色就跟着滚动条一路飘下去。 -->
                            <DataTrigger Binding="{Binding IsSelected,
                                         RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                         Value="True">
                                <Setter TargetName="Row" Property="Background"
                                        Value="{DynamicResource Nav.Button.Hover}"/>
                            </DataTrigger>

                            <!-- 级别配色：只染竖条与级别文字，正文恒为主色。
                                 全部走 Palette 里的语义色键，不在模板里写死十六进制：
                                 写死的话深浅两册无法各自取值。 -->
                            <DataTrigger Binding="{Binding Level}" Value="Warn">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource Log.Warn}"/>
                                <Setter TargetName="LevelText" Property="Foreground"
                                        Value="{DynamicResource Log.Warn}"/>
                            </DataTrigger>

                            <DataTrigger Binding="{Binding Level}" Value="Error">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource Log.Error}"/>
                                <Setter TargetName="LevelText" Property="Foreground"
                                        Value="{DynamicResource Log.Error}"/>
                            </DataTrigger>

                            <!-- 致命：声明在 Error 之后，同优先级下后声明者生效，
                                 确保 Critical 拿到的是 #C42B1C 而不是 Error 的 #FF453A。 -->
                            <DataTrigger Binding="{Binding Level}" Value="Critical">
                                <Setter TargetName="Bar" Property="Background"
                                        Value="{DynamicResource Log.Critical}"/>
                                <Setter TargetName="LevelText" Property="Foreground"
                                        Value="{DynamicResource Log.Critical}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="2"
                   Text="暂无日志"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Style="{StaticResource HintTextStyle}"/>
    </Grid>
</UserControl>
