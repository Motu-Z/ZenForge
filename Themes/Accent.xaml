<!-- 强调色资源：ThemeService 在运行时会动态改写这里面的画刷 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AccentBrush" Color="#00B4D8"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#33C4E2"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0090AF"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E00B4D8"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#FFFFFF"/>

</ResourceDictionary>
