<!-- 强调色资源：ThemeService 在运行时会动态改写这里面的画刷 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="AccentBrush" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#72D4FF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#53A3CC"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F60CDFF"/>
    <SolidColorBrush x:Key="AccentTextBrush" Color="#000000"/>

</ResourceDictionary>
