<!-- 深色调色板 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Window.Background" Color="#121214"/>
    <!-- 侧栏比窗口亮一档，两者之间再压一条 1px 分割线：
         纯靠色差（#121214 vs #18181A 只差 6/255）分不出边界，会糊成一整块。 -->
    <SolidColorBrush x:Key="SideBar.Background" Color="#18181A"/>
    <SolidColorBrush x:Key="SideBar.Border" Color="#14FFFFFF"/>
    <!-- 标题栏过去是 Transparent，主窗口整块客户区一旦硬件渲染失效，
         这里就是最先"破洞"的一块 —— 进程活着但窗口像缺了一角。
         改成不透明实色，作为整个窗口的底板。 -->
    <SolidColorBrush x:Key="TitleBar.Background" Color="#121214"/>
    <SolidColorBrush x:Key="Nav.Background" Color="#18181A"/>

    <SolidColorBrush x:Key="Card.Background" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="Card.Border" Color="#14FFFFFF"/>

    <SolidColorBrush x:Key="Text.Primary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#9AFFFFFF"/>
    <SolidColorBrush x:Key="Text.Disabled" Color="#4DFFFFFF"/>

    <!-- ==================================================================
         【第三级文字：L6 元数据专用】

         Text.Disabled（30% 白）原本身兼两职：既表示「这个控件不可用」，
         又拿来写路径、时间戳、版本号这类元数据。两者语义完全不同，
         混用导致元数据永远偏灰、在 1080p 上几乎读不出来（对比度约 2.6:1）。

         这里拆出 Text.Meta（46% 白）：足够弱，但仍在 WCAG 小字可读区间；
         不可用状态继续走 Text.Disabled，元数据一律走 Text.Meta。
         ================================================================== -->
    <SolidColorBrush x:Key="Text.MetaBrush" Color="#75FFFFFF"/>

    <!-- 输入框的静态底色。
         Input.Background（20% 黑）叠在窗口底 #121214 上，等效 #0E0E10 ——
         比卡片还暗，所以输入框看起来像在卡片上挖了个洞，
         和亮蓝色的滑杆凑在一起就是「一半是控件、一半是空洞」的割裂感。
         控件底应当比卡片**亮**一档（可交互 = 浮起），这里给 6% 白。 -->
    <SolidColorBrush x:Key="Control.Background" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Control.BackgroundHover" Color="#17FFFFFF"/>

    <SolidColorBrush x:Key="Input.Background" Color="#33000000"/>
    <SolidColorBrush x:Key="Input.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Input.Border" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="Input.BorderHover" Color="#40FFFFFF"/>

    <SolidColorBrush x:Key="Nav.Button.Hover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="Nav.Button.Active" Color="#14FFFFFF"/>

    <SolidColorBrush x:Key="Toggle.Off" Color="#1AFFFFFF"/>

    <!-- 弹出菜单的实心底色。
         不能复用 Card.Background（#08FFFFFF，8/255 白）—— 那是给"叠在窗口上"的卡片用的，
         菜单浮在桌面，没有窗口垫底，alpha 会直接透出壁纸。
         #1F1F21 比 Card 的等效观感略亮一档，边框用 0.16 alpha 的白。 -->
    <SolidColorBrush x:Key="Menu.Background" Color="#1F1F21"/>
    <SolidColorBrush x:Key="Menu.Border" Color="#29FFFFFF"/>

    <SolidColorBrush x:Key="List.Background" Color="#252526"/>
    <SolidColorBrush x:Key="List.Header" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="List.Hover" Color="#0FFFFFFF"/>

    <!-- 掩码列表行内删除按钮的衬底：左透明 → 右为 List.Background (#252526)。
         左侧留 10px 过渡，长名称被省略号截断时不会出现一刀切的硬边。
         两个调色板必须各定义一份，否则切主题后要么漏色、要么变白块。 -->
    <LinearGradientBrush x:Key="Row.FadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00252526"/>
        <GradientStop Offset="0.55" Color="#FF252526"/>
        <GradientStop Offset="1" Color="#FF252526"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="List.SelectedText" Color="#101010"/>

    <SolidColorBrush x:Key="Disabled.Background" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="Disabled.Foreground" Color="#6C6C70"/>

    <SolidColorBrush x:Key="Log.Background" Color="#33000000"/>
    <SolidColorBrush x:Key="Log.Border" Color="#14FFFFFF"/>

    <!-- ==================================================================
         【语义色区：禁止与强调色产生任何关联】

         这四组颜色表达的是「状态含义」，不是「品牌/交互」。用户把强调色
         换成紫色、橙色、绿色，日志里的警告必须还是黄的、错误必须还是红的
         —— 否则「红色」不再意味着错误，界面语言就失效了。

         施加强制约束：
           · 本区色值一律硬编码，不得引用 AccentBrush / AccentSoftBrush。
           · ThemeService.SetAccentBrushes 只允许写 Accent.xaml 里的 5 个键，
             绝不触碰下面任何一个 Log.* 键（见该方法内的白名单校验）。
           · 换主题时整册替换（SwapPalette），深浅两册各自定义同名键，
             因此无需在运行时动态改写 —— 也就没有「被覆盖」的机会。

         Log.Info 用中性灰蓝 #8B9BB4 而非任何强调色系：
         默认强调色是 #38BDF8（亮青蓝），若日志信息级也用同色系，
         用户会分不清「这是可点的东西」还是「这是一条普通日志」。
         灰蓝的饱和度足够低，既保留「信息级偏冷」的语义习惯，
         又不会在任何强调色主题下与之混淆。
         ================================================================== -->
    <SolidColorBrush x:Key="Log.Info" Color="#8B9BB4"/>
    <SolidColorBrush x:Key="Log.Warn" Color="#F5D90A"/>
    <SolidColorBrush x:Key="Log.Error" Color="#FF453A"/>
    <SolidColorBrush x:Key="Log.Critical" Color="#C42B1C"/>

    <!-- 日志级别 pill / 徽章的底色：对应级别色的 12% 透明度版本（0x1F = 31/255）。
         必须与上面的色值同源，改一个就要改另一个。 -->
    <SolidColorBrush x:Key="Log.InfoTint" Color="#1F8B9BB4"/>
    <SolidColorBrush x:Key="Log.WarnTint" Color="#1FF5D90A"/>
    <SolidColorBrush x:Key="Log.ErrorTint" Color="#1FFF453A"/>
    <SolidColorBrush x:Key="Log.CriticalTint" Color="#1FC42B1C"/>

    <SolidColorBrush x:Key="Scrollbar.Thumb" Color="#26FFFFFF"/>
    <SolidColorBrush x:Key="Scrollbar.ThumbHover" Color="#4DFFFFFF"/>

    <SolidColorBrush x:Key="Separator" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>

    <!-- 警告横幅 / 危险操作的淡底（Danger 的低透明度版本，深浅两册各自取值） -->
    <SolidColorBrush x:Key="DangerSoft" Color="#26E5534B"/>

    <!-- 中性单色按钮（不跟随主题强调色，低调深灰）。
         底色从 #4E4E54 收到 #2A2A2D：原来的灰比卡片亮太多，
         一排四个按钮就是四个发亮的方块，把 CPU 名压下去了。
         次要按钮的定位是「看得见、点得到、但不抢视线」，
         靠 1px 边框和 hover 时的提亮来表达可交互，而不是靠底色。 -->
    <SolidColorBrush x:Key="Button.Neutral.Background" Color="#2A2A2D"/>
    <SolidColorBrush x:Key="Button.Neutral.Hover" Color="#38383D"/>
    <SolidColorBrush x:Key="Button.Neutral.Pressed" Color="#212124"/>
    <SolidColorBrush x:Key="Button.Neutral.Foreground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Button.Neutral.Border" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="Button.Quiet.Background" Color="#1C1C1F"/>

    <!-- ToolTip 全局配色：深色深底白字 -->
    <SolidColorBrush x:Key="ToolTip.Background" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ToolTip.Foreground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ToolTip.Border" Color="#3F3F46"/>

    <!-- ==================================================================
         以下为消除「样式里写死颜色」而补齐的资源键。
         原则：只新增，不改动上面任何一个既有色值，保持原有视觉语言不变。
         ================================================================== -->

    <!-- 开关滑块：深色主题下轨道(Toggle.Off #4A4A4E)够深，白色滑块无需描边 -->
    <SolidColorBrush x:Key="Toggle.Thumb" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Toggle.ThumbBorder" Color="Transparent"/>

    <!-- 关闭按钮：原先在 Controls.xaml 里写死 #FFFFFF / #A32218，
         导致这两色游离于主题之外，也无法参与后续主题扩展 -->
    <SolidColorBrush x:Key="CloseButton.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CloseButton.Pressed" Color="#A32218"/>

    <!-- Toast 卡片：比窗口(#121214)亮、比卡片浮层更沉一点，配 1px 亮边
         + 投影，保证压在任意页面背景上都能"浮"起来。 -->
    <SolidColorBrush x:Key="Toast.Background" Color="#1E1E20"/>
    <SolidColorBrush x:Key="Toast.Border" Color="#1FFFFFFF"/>

    <!-- 状态徽章底色：必须比所在卡片(Card.Background #252526)明亮一档。
         原先沿用 List.Header(#1E1E1E)，比卡片还暗，徽章看起来像在卡片上挖了个洞。 -->
    <SolidColorBrush x:Key="Badge.Background" Color="#14FFFFFF"/>

    <!-- 语义状态色：与日志三色同源，避免同一含义在界面上出现第二种灰/黄 -->
    <SolidColorBrush x:Key="State.Info" Color="#B8B8BC"/>
    <SolidColorBrush x:Key="State.Success" Color="#2FB344"/>
    <SolidColorBrush x:Key="State.Warning" Color="#E8A33D"/>
    <SolidColorBrush x:Key="State.Danger" Color="#E86A6A"/>

</ResourceDictionary>
