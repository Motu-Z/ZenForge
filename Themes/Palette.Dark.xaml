<!-- 深色调色板 -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Window.Background" Color="#1E1E1E"/>
    <!-- 标题栏过去是 Transparent，主窗口整块客户区一旦硬件渲染失效，
         这里就是最先"破洞"的一块 —— 进程活着但窗口像缺了一角。
         改成不透明实色，作为整个窗口的底板。 -->
    <SolidColorBrush x:Key="TitleBar.Background" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Nav.Background" Color="#212122"/>

    <SolidColorBrush x:Key="Card.Background" Color="#252526"/>
    <SolidColorBrush x:Key="Card.Border" Color="#3A3A3C"/>

    <SolidColorBrush x:Key="Text.Primary" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#9D9DA0"/>
    <SolidColorBrush x:Key="Text.Disabled" Color="#6C6C70"/>

    <SolidColorBrush x:Key="Input.Background" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Input.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Input.Border" Color="#3F3F46"/>
    <SolidColorBrush x:Key="Input.BorderHover" Color="#5A5A62"/>

    <SolidColorBrush x:Key="Nav.Button.Hover" Color="#2D2D30"/>
    <SolidColorBrush x:Key="Nav.Button.Active" Color="#333336"/>

    <SolidColorBrush x:Key="Toggle.Off" Color="#4A4A4E"/>

    <SolidColorBrush x:Key="List.Background" Color="#252526"/>
    <SolidColorBrush x:Key="List.Header" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="List.Hover" Color="#333333"/>

    <!-- 掩码列表行内删除按钮的衬底：左透明 → 右为 List.Background (#252526)。
         左侧留 10px 过渡，长名称被省略号截断时不会出现一刀切的硬边。
         两个调色板必须各定义一份，否则切主题后要么漏色、要么变白块。 -->
    <LinearGradientBrush x:Key="Row.FadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00252526"/>
        <GradientStop Offset="0.55" Color="#FF252526"/>
        <GradientStop Offset="1" Color="#FF252526"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="List.SelectedText" Color="#101010"/>

    <SolidColorBrush x:Key="Disabled.Background" Color="#2A2A2C"/>
    <SolidColorBrush x:Key="Disabled.Foreground" Color="#6C6C70"/>

    <SolidColorBrush x:Key="Log.Background" Color="#171718"/>
    <SolidColorBrush x:Key="Log.Border" Color="#333336"/>
    <SolidColorBrush x:Key="Log.Info" Color="#B8B8BC"/>
    <SolidColorBrush x:Key="Log.Warn" Color="#E8A33D"/>
    <SolidColorBrush x:Key="Log.Error" Color="#E86A6A"/>

    <SolidColorBrush x:Key="Scrollbar.Thumb" Color="#4A4A4E"/>
    <SolidColorBrush x:Key="Scrollbar.ThumbHover" Color="#6E6E76"/>

    <SolidColorBrush x:Key="Separator" Color="#333336"/>
    <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>

    <!-- 中性单色按钮（不跟随主题强调色，低调深灰） -->
    <SolidColorBrush x:Key="Button.Neutral.Background" Color="#4E4E54"/>
    <SolidColorBrush x:Key="Button.Neutral.Hover" Color="#5C5C63"/>
    <SolidColorBrush x:Key="Button.Neutral.Pressed" Color="#3C3C41"/>
    <SolidColorBrush x:Key="Button.Neutral.Foreground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Button.Neutral.Border" Color="#5A5A62"/>
    <SolidColorBrush x:Key="Button.Quiet.Background" Color="#2F2F32"/>

    <!-- ToolTip 全局配色：深色深底白字 -->
    <SolidColorBrush x:Key="ToolTip.Background" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ToolTip.Foreground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="ToolTip.Border" Color="#3F3F46"/>

    <!-- ==================================================================
         以下为消除「样式里写死颜色」而补齐的资源键。
         原则：只新增，不改动上面任何一个既有色值，保持原有视觉语言不变。
         ================================================================== -->

    <!-- 开关滑块：深色主题下轨道(Toggle.Off #4A4A4E)够深，白色滑块无需描边 -->
    <SolidColorBrush x:Key="Toggle.Thumb" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Toggle.ThumbBorder" Color="Transparent"/>

    <!-- 关闭按钮：原先在 Controls.xaml 里写死 #FFFFFF / #A32218，
         导致这两色游离于主题之外，也无法参与后续主题扩展 -->
    <SolidColorBrush x:Key="CloseButton.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CloseButton.Pressed" Color="#A32218"/>

    <!-- 状态徽章底色：必须比所在卡片(Card.Background #252526)明亮一档。
         原先沿用 List.Header(#1E1E1E)，比卡片还暗，徽章看起来像在卡片上挖了个洞。 -->
    <SolidColorBrush x:Key="Badge.Background" Color="#2F2F33"/>

    <!-- 语义状态色：与日志三色同源，避免同一含义在界面上出现第二种灰/黄 -->
    <SolidColorBrush x:Key="State.Info" Color="#B8B8BC"/>
    <SolidColorBrush x:Key="State.Success" Color="#2FB344"/>
    <SolidColorBrush x:Key="State.Warning" Color="#E8A33D"/>
    <SolidColorBrush x:Key="State.Danger" Color="#E86A6A"/>

</ResourceDictionary>
