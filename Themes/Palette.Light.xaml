<!-- 浅色调色板（键名与深色版完全一致，ThemeService 整册替换） -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Window.Background" Color="#F2F2F4"/>
    <!-- 深色版同位置是不透明实色，这里保持一致，避免亮色主题下出现同样的空洞。 -->
    <SolidColorBrush x:Key="TitleBar.Background" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="Nav.Background" Color="#F2F2F4"/>

    <SolidColorBrush x:Key="Card.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Card.Border" Color="#E2E2E6"/>

    <SolidColorBrush x:Key="Text.Primary" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Text.Secondary" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Text.Disabled" Color="#A0A0A5"/>

    <SolidColorBrush x:Key="Input.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Input.Foreground" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Input.Border" Color="#CFCFD4"/>
    <SolidColorBrush x:Key="Input.BorderHover" Color="#9A9AA0"/>

    <SolidColorBrush x:Key="Nav.Button.Hover" Color="#E7E7EB"/>
    <SolidColorBrush x:Key="Nav.Button.Active" Color="#DCDCE0"/>

    <SolidColorBrush x:Key="Toggle.Off" Color="#C8C8CC"/>

    <SolidColorBrush x:Key="List.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="List.Header" Color="#F2F2F4"/>
    <SolidColorBrush x:Key="List.Hover" Color="#E7E7EB"/>

    <!-- 深色版的同款刷子，颜色对齐 List.Background (#FFFFFF)。 -->
    <LinearGradientBrush x:Key="Row.FadeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#00FFFFFF"/>
        <GradientStop Offset="0.55" Color="#FFFFFFFF"/>
        <GradientStop Offset="1" Color="#FFFFFFFF"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="List.SelectedText" Color="#101010"/>

    <SolidColorBrush x:Key="Disabled.Background" Color="#F0F0F2"/>
    <SolidColorBrush x:Key="Disabled.Foreground" Color="#A0A0A5"/>

    <SolidColorBrush x:Key="Log.Background" Color="#FAFAFB"/>
    <SolidColorBrush x:Key="Log.Border" Color="#E2E2E6"/>
    <SolidColorBrush x:Key="Log.Info" Color="#5A5A5E"/>
    <SolidColorBrush x:Key="Log.Warn" Color="#B26A00"/>
    <SolidColorBrush x:Key="Log.Error" Color="#C42B1C"/>

    <SolidColorBrush x:Key="Scrollbar.Thumb" Color="#C0C0C5"/>
    <SolidColorBrush x:Key="Scrollbar.ThumbHover" Color="#9A9AA0"/>

    <SolidColorBrush x:Key="Separator" Color="#E2E2E6"/>
    <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>

    <!-- 中性单色按钮（不跟随主题强调色，低调浅灰） -->
    <SolidColorBrush x:Key="Button.Neutral.Background" Color="#F7F7F9"/>
    <SolidColorBrush x:Key="Button.Neutral.Hover" Color="#EDEDF0"/>
    <SolidColorBrush x:Key="Button.Neutral.Pressed" Color="#E2E2E7"/>
    <SolidColorBrush x:Key="Button.Neutral.Foreground" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="Button.Neutral.Border" Color="#C9C9D0"/>
    <SolidColorBrush x:Key="Button.Quiet.Background" Color="#F7F7F9"/>

    <!-- ToolTip 全局配色：浅色白底黑字 -->
    <SolidColorBrush x:Key="ToolTip.Background" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolTip.Foreground" Color="#1C1C1E"/>
    <SolidColorBrush x:Key="ToolTip.Border" Color="#CFCFD4"/>

    <!-- ==================================================================
         与深色版同名等位的资源键，ThemeService 整册替换时必须两边齐全。
         ================================================================== -->

    <!-- 开关滑块：浅色主题下轨道(Toggle.Off #C8C8CC)很浅，
         白色滑块必须带描边才能看清轮廓，否则开关像是空的 -->
    <SolidColorBrush x:Key="Toggle.Thumb" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Toggle.ThumbBorder" Color="#8A8A90"/>

    <SolidColorBrush x:Key="CloseButton.Foreground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CloseButton.Pressed" Color="#C42B1C"/>

    <!-- 浅色下卡片为纯白，徽章取一档浅灰以区分 -->
    <SolidColorBrush x:Key="Badge.Background" Color="#ECECF0"/>

    <SolidColorBrush x:Key="State.Info" Color="#5A5A5E"/>
    <SolidColorBrush x:Key="State.Success" Color="#1F8A34"/>
    <SolidColorBrush x:Key="State.Warning" Color="#B26A00"/>
    <SolidColorBrush x:Key="State.Danger" Color="#C42B1C"/>

</ResourceDictionary>
