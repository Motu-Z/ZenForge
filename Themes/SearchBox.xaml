<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctl="clr-namespace:ZenForge.Controls">

    <!--
        ============================================================
        搜索框（zenforge:SearchBox）
        ============================================================
        几何只有一个来源，全部写在这里，页面不许再改：

            第 0 列 10  ← 图标左边距
            第 1 列 14  ← 图标宽度
            第 2 列 *   ← 输入框，Padding.Left = 32 = 10 + 14 + 8

        占位符与 TextBox 同处第 2 列、同用这个 32 的左内缩，
        所以「占位文字起点」与「光标起点」是同一个像素。

        【上一版为什么错位】
        占位符单独放在外层 Grid 里，Margin 用了 Thickness(32,0,0,0)。
        那个 32 描述的是「TextBox 内边距」，而外层 Grid 的左缘比 TextBox
        还靠左 24px（10 留白 + 14 图标），于是占位文字整体左移 32，
        直接压到放大镜上面。日志页则是反过来多加一次 32，文字右移。
        同一个数字被用在了两个不同的坐标系里 —— 这是错位的全部原因。

        【尺寸】
        高 32、圆角 6、底色 Control.Background，与 AppTextBoxStyle 完全一致：
        搜索框就是一个 TextBox，不该长得像另一种控件。
    -->
    <Style TargetType="{x:Type ctl:SearchBox}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctl:SearchBox}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 放大镜：Stretch=Uniform + 14×14，笔画粗细不随帧缩放失真。
                             Data 用绝对坐标写死，不再依赖 sys:Double 资源
                             （试过，ColumnDefinition.Width 要 GridLength，
                              Double 资源运行期会抛「不是有效值」）。 -->
                        <Path Grid.Column="1"
                              x:Name="PART_Icon"
                              Width="14" Height="14"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              IsHitTestVisible="False"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Text.MetaBrush}"
                              StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 5.5,1 A 4.5,4.5 0 1 1 5.49,1 M 9,9 L 12,12"/>

                        <!-- 输入框与占位符共用第 2 列。
                             占位符 Margin 只给左 32（= TextBox 的内部左内缩），
                             垂直方向靠 VerticalAlignment=Center 与文字行盒对齐，
                             不再各自补 1~2px 的「微调」—— 那些微调正是上一版
                             占位符与光标基线差 1px 的来源。 -->
                        <Grid Grid.Column="2">
                            <TextBox x:Name="PART_Input"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     Height="32"
                                     Padding="32,0,10,0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     TextAlignment="Left"
                                     BorderThickness="1"/>
                            <TextBlock x:Name="PART_Placeholder"
                                       Margin="32,0,10,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       IsHitTestVisible="False"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.MetaBrush}"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
