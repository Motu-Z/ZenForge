<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== 通用文本样式 =====================
         全部基于 Themes/Typography.xaml 里的六级层级（Text.*），
         这里只保留「旧键名 → 新层级」的别名。
         别名存在的唯一理由：页面 XAML 里有上百处引用旧键名，
         逐个改名只会制造改动量与回归风险；保留别名后
         改一次层级表，全工程同时生效。 -->

    <!-- 卡片标题 → L2（15 / SemiBold / 下 14） -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}"/>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- 行标签 → L4 -->
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}"/>

    <!-- ===================== 设置页行式布局 =====================
         设置页的行结构高度重复（左标签、右控件），以前每行手抄一遍
         ColumnDefinitions。
         注意 Grid.ColumnDefinitions 是**只读集合属性**（没有 setter），
         不能写成 <Setter Property="ColumnDefinitions"> —— 那样 BAML 装载时
         Setter.Property 解析出来是 null，会抛 ArgumentNullException，
         而且整个 ResourceDictionary 一旦触及这个 key 就整册失效。
         所以列定义只能由各行在 XAML 里写，这里只抽 Margin。 -->

    <!-- 行距 20。
         为什么不是 24：每行实际内容是「13px 标签 + 4 + 12px 说明」≈ 34px 高，
         行距 24 时相邻两行的间隔比行本身还高，一屏只能放四行，
         设置页变成一张散点图。20 让「组内」读起来是同一列的连续条目，
         而组与组之间另有分隔线（见 SettingsGroupSeparatorStyle）承担大间隔。 -->
    <Style x:Key="SettingsRowStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,20,0,0"/>
    </Style>


    <!-- 从属行：轻缩进 + 次要文字色，表达「这一项隶属于上面那一项」 -->
    <Style x:Key="SettingsSubRowStyle" TargetType="Grid" BasedOn="{StaticResource SettingsRowStyle}">
        <Setter Property="Margin" Value="16,10,0,0"/>
    </Style>

    <Style x:Key="SettingsSubLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 设置项分组分隔线：1px 实线，比行间距更「重」，用来切分语义段落 -->
    <Style x:Key="SettingsGroupSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,14,0,2"/>
        <Setter Property="Background" Value="{DynamicResource Separator}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== 卡片 =====================
         内边距 20,22 —— 全工程统一，四边只有上下与左右的差别。
         以前是 "20,24"，看起来上下更松，但卡片内第一行是标题（自带下 14），
         实际观感是「上紧下松」；改成 22 之后，标题上沿到下沿的呼吸与
         最后一行到卡片下沿基本相等。 -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="20,22"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== 统一页头（四个页面共用） ===================== -->
    <Style x:Key="PageHeaderCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Height" Value="76"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="20,0"/>
    </Style>

    <!-- 页头主标题：页面标题或设备名 -->
    <Style x:Key="PageHeaderTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.CardTitle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>


    <!-- ===================== 状态徽章（页头右侧唯一元素） =====================
         替代原来 26px 的「就绪」大字。所有页面的状态都用这一个规格。
         高度 28px 与页头按钮（HeaderActionButtonStyle）严格一致，
         保证「有按钮的页」和「有徽章的页」右侧视觉重量相同。 -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource Badge.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 中性徽章：用于非强调状态（如规则数量 0） -->
    <Style x:Key="NeutralBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource Badge.Background}"/>
    </Style>

    <Style x:Key="NeutralBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
    </Style>

    <!-- 卡片内标题下方的说明文字：统一 12px + 距标题 4px -->
    <Style x:Key="CardHintStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- ===================== 侧栏导航 =====================
         【左侧留白，选中块不能贴到窗口边缘】
         侧栏原先 Padding=0，导航项选中背景的右圆角在 12px 处结束，
         左缘却直接压到窗口 x=0 —— 一块带圆角的底色只在右边有圆角、
         左边被窗口边界切断，看起来像「被裁坏了一半」。

         现在侧栏统一左右各留 10px 内边距，导航项自身 Margin=0，
         选中块四角都是 8px 圆角，四周留白相等。
         代价是选中竖条不再贴 x=0 —— 但它本来就不该贴：那条竖条的作用是
         「标记这一项被选中」，不是「装饰侧栏边界」。贴边之后它反而
         和窗口边缘糊成一条，读不出是选中标记。

         导航项高度 34 → 36、圆角 6 → 8：与全工程的控件圆角（6）
         和卡片圆角（10）取中间值，看起来属于同一套几何语言。 -->

    <!-- ===================== 导航按钮（药丸形，横向） ===================== -->
    <!-- 0.10.0 起主导航改为竖排侧栏项（SideNavItemStyle），这个横排胶囊
         只剩极少数场景可能复用；保留定义以免外部引用断链。 -->
    <Style x:Key="NavButtonStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 干掉点击后那圈丑陋的虚线焦点框（截图中的“设置”按钮） -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="17"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <!-- 按压反馈。放在 IsChecked 之后：已选中项按下时短暂显示偏暗的强调色，
                             抬手自动恢复 AccentBrush，不会破坏选中态。 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 侧栏导航项（竖排） =====================
         0.10.0 新的主导航形态：左侧 3×14 强调色竖条 + 淡底 + 600 字重，
         不再整块填充强调色（那会让侧栏变成一条彩色条，抢走内容区的注意力）。

         竖条与文字都用 Grid 列定位，不靠 Padding 位移：
         用 Padding 改内缩会在选中/取消瞬间产生 1px 抖动。 -->
    <Style x:Key="SideNavItemStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <!-- MouseLeftButtonUp 不能在 ResourceDictionary 里挂实例处理器
             （没有 x:Class，MC6024）。真正拦截在 MainWindow 的类处理器里，
             见 MainWindow.xaml.cs 的 NavItem_MouseLeftButtonUp / AddHandler。
             这里只负责视觉。 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- 竖条画在项外（第 0 列），底色块从第 1 列起：
                         选中标记落在外侧，底色块就不会被竖条啃掉一块，
                         圆角也保持完整。侧栏导航区左右各留 12，加上这里
                         的 12 内缩，图标与文字起点严格落在 x=24。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Rectangle x:Name="Bar"
                                   Grid.Column="0"
                                   Width="3"
                                   Height="16"
                                   RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource AccentBrush}"
                                   Visibility="Collapsed"/>

                        <Border x:Name="Bd"
                                Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="Txt"
                                              Margin="12,0,12,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <!-- 按压微缩 0.98：与全工程按钮的 Active 反馈同一档，
                                 比位移或改底色便宜，也不会影响文字基线。 -->
                            <Setter Property="LayoutTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Active}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <!-- 不改 Txt 的 Margin：选中时文字位移会让整行看起来被「推」了一下，
                                 而且让竖条看起来是文字的一部分。 -->
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧栏导航图标：16×16 描边矢量，颜色跟随所在按钮的 Foreground。
         图标必须是「文字的附属」，选中/悬停时随着文字一起提亮，
         写死颜色会出现「图标灰、文字白」的割裂感。

         【必须取 AncestorType=ToggleButton，不能用 Self】
         Path 是 Shape，它身上**没有 Foreground 属性**（那是 Control 的）。
         RelativeSource=Self 的绑定找不到这个属性，绑定静默失败 → Stroke 为 null
         → 图标整片不显示，而 XAML 编译期一句警告都没有。
         1.0.2 第一版就是这么把七个图标全弄丢的。 -->
    <Style x:Key="NavIconPath" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Opacity" Value="0.85"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 侧栏分组分割线。上下 20 / 左右 8：
         上下留够 20 才能让「组」读成组，而不是「挨得比较近的几个项」；
         左右内缩 8 是为了不让线顶到侧栏边，顶到边就会和窗口边框糊成一条。 -->
    <Style x:Key="NavGroupSeparatorStyle" TargetType="Rectangle">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Fill" Value="{DynamicResource Separator}"/>
        <Setter Property="Margin" Value="8,20,8,20"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== 页面标题（指向 Typography 的 L1） =====================
         具体数值与理由见 Themes/Typography.xaml，那里是全工程唯一口径。
         这里保留 PageTitleStyle / PageSubStyle 两个旧键名，
         页面 XAML 不必改；将来调层级只动 Typography.xaml 一处。 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.PageTitle}"/>

    <Style x:Key="PageSubStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.PageSub}"/>


    <!-- ===================== 按钮 =====================
         【全局尺寸基准，勿在页面里覆盖】
         此前各页各写一套：Height 有 30 / 32 / 34 / 36 四种，MinWidth 有 64 / 72 / 104 / 120 四种，
         同一屏里并排就显得高低宽窄不齐。现在统一：

           · 高度    32px（与 TextBox / ComboBox 严格同高，任何一行并排都齐平）
           · 圆角    6px（与输入框、下拉框同一套几何）
           · 间距    8px（页面里用 Margin="0,0,8,0"）

         例外：弹窗里的按钮由容器 Grid 均分宽度，写 HorizontalAlignment="Stretch"
         即可，不要写死 Height。
    -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Button.Quiet.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Button.Neutral.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>

        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- 全局禁用焦点虚线框 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：背景必须变化。原先只改 1px 边框色（#3F3F46→#5C5C63），
                             在深色背景上肉眼几乎无法分辨，按钮看起来“没有反应”。
                             这里改为背景跳到 Button.Neutral.Hover，边框同步提亮。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.Neutral.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.BorderHover}"/>
                        </Trigger>
                        <!-- 按压：原先完全没有该状态，按下与悬停长得一模一样。
                             用 Button.Neutral.Pressed 给出明确的“压下去”反馈。 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.Neutral.Pressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 危险按钮 =====================
         只用于「清除全部数据」「停用全部功能」这类不可逆操作。
         与 SecondaryButtonStyle 完全同尺寸（32 / 圆角 6 / 13px），
         差别只有红色文字 + 红边框 —— 尺寸必须一致，否则重置卡上
         两个按钮会一高一低，看起来像两个不同性质的控件。

         不复用次要按钮模板的原因：那个模板把 hover 底写死成中性灰，
         危险按钮悬停时红字配灰底会互相抵消。 -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="MinWidth" Value="72"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Danger.Foreground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Danger.Edge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger.Pressed}"/>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页头右侧按钮：高 28px，与 24px 徽章保持相近的视觉重量。
         日志页的「打开日志目录」用它——原来 32px 比徽章高出一截，页头看起来不齐。 -->
    <Style x:Key="HeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== 窗口控制按钮（旧尺寸，保留兼容） =====================
         28×28 圆角 4，与侧栏导航项同一套圆角语言。
         0.10.0 起窗口按钮已挪到内容区右上角的拖拽栏，实际使用的是下面那套
         TitleBarButtonStyle（40×30）。这一对（含 WindowCloseButtonStyle）
         保留定义，避免外部引用断链，也方便将来做「紧凑标题栏」时复用。 -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="1,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Active}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ===================== 标题栏窗口按钮（右上角） =====================
         与上面的 WindowButtonStyle 同尺寸逻辑，但视觉语言不同：
         它挂在主内容区顶部的拖拽栏上，底色与内容区一致，所以必须
         「默认完全透明、只在 hover 时浮起」，否则三颗按钮会像贴了三块膏药。

         尺寸 40×30 而不是 28×28：Windows 原生标题栏按钮的命中区约为
         46×32，用户肌肉记忆就落在那一片。40 宽在 8px 圆角窗口里空间够用，
         hover 底色还能留出左右各 4px 的呼吸，不至于糊成一整条灰带。 -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Active}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭键：hover 走语义错误红。与 WindowCloseButtonStyle 同一套语义，
         只换了尺寸与圆角，不改配色 —— 红色关闭键是全平台共识。 -->
    <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button"
           BasedOn="{StaticResource TitleBarButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CloseButton.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButton.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CloseButton.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButton.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 行内图标按钮 =====================
         列表行里的编辑 / 删除操作用。整套界面此前没有这个形态：
         窗口控制按钮是 46×32 太大，普通按钮 MinWidth 156 更放不进列表行。
         这里取 28×28 并清掉 MinWidth，让它能塞进 Grid 的 Auto 列。
         内容是 Segoe MDL2 字形（与 MainWindow 的窗口按钮同一套字体），
         不引位图资源。 -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Active}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 删除专用：悬停时转红，与窗口关闭按钮同一套危险色语言。 -->
    <Style x:Key="IconDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButton.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文本框 / 下拉框的深色样式已统一上移到 App.xaml（Application.Resources 优先级更高，
         可避免同一类型在两个字典里各有一份隐式样式而互相覆盖导致白底）。 -->

    <!-- ===================== 开关（Win11 风格） ===================== -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <!-- v12：轨道 36×20、滑块 16、内缩 2、圆角 10（= 高度除二） -->
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track"
                            Background="{DynamicResource Toggle.Off}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <!-- 原先 Fill="White" 写死：浅色主题下轨道为 #C8C8CC，
                             白色滑块几乎不可见，整个开关看起来是空的。
                             改为资源色 + 描边（深色版描边为 Transparent，视觉不变）。 -->
                        <Ellipse x:Name="Thumb"
                                 Width="16" Height="16"
                                 Fill="{DynamicResource Toggle.Thumb}"
                                 Stroke="{DynamicResource Toggle.ThumbBorder}"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Left"
                                 Margin="2,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 滑块 ===================== -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Toggle.Off}"/>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Opacity="0" Focusable="False" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Opacity="0" Focusable="False" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 色相滑杆（设置页强调色） =====================
         v12 的色相条是一条 6px 高的彩虹渐变，亮度固定 70%，
         渐变停靠点就是 HSL 色环的六个基准色相（0/60/120/180/240/300/360）。
         轨道用 Border.Background = LinearGradientBrush 画，
         滑块是 18px 白圆 + 一圈半透明黑边（深色底上才看得见边界）。

         注意：这是「色相」专用滑杆，不要让其他地方的 Slider 继承它 ——
         所以给了 x:Key，不走隐式样式。 -->
    <Style x:Key="HueSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FF6B6B" Offset="0.000"/>
                                    <GradientStop Color="#FFE066" Offset="0.166"/>
                                    <GradientStop Color="#8BE68B" Offset="0.333"/>
                                    <GradientStop Color="#6BE6E6" Offset="0.500"/>
                                    <GradientStop Color="#6B8BFF" Offset="0.666"/>
                                    <GradientStop Color="#E66BE6" Offset="0.833"/>
                                    <GradientStop Color="#FF6B6B" Offset="1.000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="18" Height="18" Fill="White"
                                                     Stroke="#80000000" StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Opacity="0" Focusable="False" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Opacity="0" Focusable="False" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 色值输入框旁的色块预览：36×36 圆角 6，底色由代码按当前色赋值 -->
    <Style x:Key="ColorPreviewStyle" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 色相选择器的外框：灰底 + 1px 边 + 24 内边距。v12 的 .color-picker-group -->
    <Style x:Key="ColorPickerGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 滚动条的深色样式已统一上移到 App.xaml 的 AppScrollBarStyle，
         此处不再重复定义，避免同类型两份隐式样式互相顶掉。 -->

    <!-- ===================== 列表框 / 列表视图 ===================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 列表视图（深色；具名 + 隐式双份） =====================
         背景 #252526 / 边框 #3F3F46 / 表头 #1E1E1E / hover #333333 /
         选中 AccentBrush（默认 #38BDF8，跟随系统强调色）+ 深色字。
         注意：ListView 默认模板不渲染 Background 属性，必须重写 Template 铺底色。 -->
    <Style x:Key="DarkListViewStyle" TargetType="ListView">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource List.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True"
                                      Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListView" BasedOn="{StaticResource DarkListViewStyle}"/>

    <Style x:Key="DarkListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd"
                            Background="{DynamicResource List.Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource List.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource List.SelectedText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource DarkListViewItemStyle}"/>

    <Style x:Key="DarkGridViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource List.Header}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DarkGridViewColumnHeaderStyle}"/>

    <!-- ===================== DataGrid（深色；具名 + 隐式双份） =====================
         注意：DataGridRow 模板必须包含 PART_CellsHost（Panel）与
         PART_RowFocusRoot（FrameworkElement）两个必需部件，缺失会导致运行时异常。 -->
    <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource List.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource List.Background}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource List.Background}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource DarkDataGridStyle}"/>

    <Style x:Key="DarkDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource List.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid x:Name="PART_RowFocusRoot">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Input.Border}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter x:Name="PART_CellsHost"
                                                    VerticalAlignment="Center"
                                                    SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource List.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource List.SelectedText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkDataGridRowStyle}"/>

    <Style x:Key="DarkDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource DarkDataGridCellStyle}"/>

    <Style x:Key="DarkDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource List.Header}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkDataGridColumnHeaderStyle}"/>

    <!-- ===== 托盘右键菜单 =====
         托盘菜单是凭空弹出的，背后没有卡片，配色必须由样式自己带齐：
         底色、描边一律沿用 Card 那一套，深色 / 浅色主题自动跟上。
         MenuItem 的默认模板把颜色写死在模板里，只改 Foreground / Background
         不生效，必须整份模板重写。 -->

    <!-- 托盘右键菜单。
         【必须用不透明底色】
         Card.Background 是 #08FFFFFF —— 8/255 的白色，它是给"叠在窗口底色上的卡片"
         设计的。菜单浮在桌面上，没有窗口底色垫着，这个值会让桌面壁纸直接透上来：
         浅色壁纸上菜单看不见，杂色壁纸上文字糊成一片。截图里那个"背景透明"
         就是这么来的。
         这里改用 Menu.Background（两个主题册里都是实色），边框用 Menu.Border。 -->
    <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Menu.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Menu.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <!-- 【为什么这个 Border 不能省】
                         ContextMenu 的 Popup 是 AllowsTransparency=True，
                         系统不会在它后面画任何东西。也就是说：这个 Border 不画底，
                         后面就是桌面。模板里必须有且只有一个不透明的填充层，
                         一旦这里写成 Transparent 或缺省，菜单就变成浮在壁纸上的字。
                         底色来自 Menu.Background（两个主题册都是 6 位实色）。 -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <!-- 【为什么外面还要套一层 Margin=4,1】
                         高亮块自己带 4px 圆角，如果直接铺满菜单宽度，
                         圆角会在左右两端被弹出层的直边裁成一个「缺角」，
                         看起来像渲染错误。左右各留 4px、
                         上下各留 1px，高亮块四周都被圆角包住，
                         整个菜单的圆角（6）也才不会被方块顶破。 -->
                    <Border Margin="4,1"
                            x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource List.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 0.10.0：v12 版式所需的组合样式 ===================== -->

    <!-- 主按钮：v2 方案 —— 15% 淡底 + 强调色字 + 强调色 1px 边，悬停反转为实底。
         与旧方案（实底强调色 + 深色字）的取舍：
           · 实底强调色在页面上是最重的一块色，v12 的卡片风格里一眼就把视线
             从 CPU 名称拽到「应用全部」按钮上，喧宾夺主。
           · 淡底方案让主按钮「看得出是主按钮，但不抢戏」；悬停反转成实底，
             交互反馈反而比原来更明显（原来实底悬停只是亮度微调）。 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 基类的模板里 Border 没有绑 BorderBrush / BorderThickness，
                         v2 方案需要那条 1px 强调色边，所以这里必须补上 TemplateBinding，
                         否则边框永远不显示（BorderBrush 设了也白设）。 -->
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：反转为实底强调色 + 深色字。
                             Foreground 必须用 TargetName=Cp 改，控件级 Setter 在
                             模板触发器里改不动 ContentPresenter 已经继承到的值。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground"
                                    Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground"
                                    Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片头部：标题 + 右侧动作区，底部一条分隔线。v12 的 .card-header-with-actions -->
    <Style x:Key="CardHeaderBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,16"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 卡片内的一行：左文字块、右控件。
         【行距 20】
         以前是 22，而设置页又在自己页面里定义了 22，两个数并存 ——
         调校页与设置页并排看就是不一样。现在全工程只有 20 这一个数。
         20 的依据：行内容是「13px 标签 + 4 + 12px 说明」合计约 34px，
         行距 20 时上下留白约为内容的一半，两行之间能分清却不散。 -->
    <!-- 卡内最后一行：把行距的 20px 收掉。
         不收的话卡片底部会在 Padding 之上再叠一段空白，
         卡片看起来「下沿比上沿厚一圈」。
         全工程统一用这个键，别在页面里手写 Margin="0"：
         手写的那一行在以后调行距时会被漏掉。 -->
    <Style x:Key="CardRowStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="CardRowLastStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- 行主标签 → L4（13 / Medium / 纯白） -->
    <Style x:Key="CardRowLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}"/>

    <!-- 行说明 → L5（12 / Normal / 60% 白 / 上距 4）
         颜色保持 Text.Secondary 而不降到 Text.Meta：
         Meta 是给「路径、时间戳」这种只用来核对的字用的，
         说明文字是用户需要读的（比如「留空沿用固件默认」），
         压到 46% 白在深色底上对比度不足 4.5:1，小字会读得吃力。 -->
    <Style x:Key="CardRowDescStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Desc}"/>


    <!-- 配置项：灰底圆角行，选中态套强调色描边。v12 的 .config-item / .config-item.active -->
    <Style x:Key="ConfigItemBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== 自绘表格（v12 进程页） =====================
         不再用 ListView + GridView：v12 的表头是「次要色小字 + 无底无边 + 行内间距」，
         GridView 的列头模板只能改外观、无法做到与数据行同样的 1.5fr/2fr 弹性配比，
         还要额外处理列宽同步。直接用 Grid + ItemsControl 更可控，
         三处（表头 / 数据行 / 空态提示）共享同一套 ColumnDefinitions。 -->

    <!-- 数据行容器：透明底，hover 铺 6% 白，选中铺 12% 强调色 + 强调色左边框 -->
    <Style x:Key="ProcessRowStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 表头单元格文字 → L7 微标签（10 / SemiBold / 46% 白）。
         表头不是内容，是一组「列名的标签」，字号必须明显小于数据行，
         否则每一行都会多出一个「标题」，表格读起来像双行列表。 -->
    <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Micro}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 行内次要文字 → L6 元数据（11 / 46% 白）。路径、占用都走这一级。 -->
    <Style x:Key="TableCellSubStyle" TargetType="TextBlock" BasedOn="{StaticResource Text.Meta}"/>

    <!-- 行内主文字 → L4（13 / SemiBold / 纯白）。
         进程名比普通标签重一档（600 而非 Medium）：表格里每行只有一个
         「主键」，字重是它唯一能压过路径的手段 —— 路径有 80% 的宽度，
         只靠颜色区分，视线还是会先落在长的那个上。 -->
    <Style x:Key="TableCellMainStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- 日志级别 pill：圆角 20，10% 级别色底 + 30% 级别色边 -->
    <!-- ===================== 日志级别 pill（筛选器） =====================
         做成 ToggleButton 而不是 Border + 代码改色：
         筛选器有两种状态（选中 / 未选），状态必须由控件自己持有，
         而不是靠代码在每次刷新时把 Brush 写回去 —— 后者在虚拟化回收
         与主题切换时都会漏改一处，出现「半旧半新」的胶囊。

         描边 30% + 底 10%：两档透明度拉开，底色属于背景层、描边属于前景层。
         只有 10% 底时胶囊在卡片上几乎看不见边界，只有 30% 描边时三枚
         并排会连成三条硬线。

         选中态直接把底色翻成实心级别色、文字与圆点翻成窗口底色：
         尺寸一个像素都不动（加粗边框会让文字左右各抖 1px），
         但视觉重量足以表达「正在按这一级筛选」。 -->
    <Style x:Key="LogPillStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Log.Info}"/>
        <Setter Property="Background" Value="{DynamicResource Log.InfoTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Log.InfoEdge}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 6px 实心圆点（参考图 .pill-dot）：
                                 圆点比文字更能表达「这是什么颜色」，
                                 在 12px 字号下加粗文字反而不如一个色点好认。 -->
                            <Ellipse x:Name="Dot"
                                     Width="6" Height="6"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{TemplateBinding Foreground}"
                                     SnapsToDevicePixels="True"/>
                            <!-- 文字颜色单独挂一层 TextBlock.Foreground，不直接用 Foreground：
                                 选中态要把「底」翻成级别色、「字」翻成窗口底色，
                                 两者必须分开控制（见下方 IsChecked 的注释）。 -->
                            <ContentPresenter x:Name="Txt"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- 描边提到实心：不动位移，避免 1px 抖动把三枚胶囊推歪 -->
                            <Setter TargetName="Bd" Property="BorderBrush"
                                    Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="LayoutTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- 选中：底翻成实心级别色，字与圆点翻成窗口底色。
                             【不能改 Foreground 本身】
                             Bd.Background 是从 Foreground 取的，一旦在这里把 Foreground
                             改成窗口底色，底色会跟着变成窗口色 —— 深底深字，整枚胶囊消失。
                             所以只改「文字层」与「圆点」，Foreground 始终是级别色。 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="Dot" Property="Fill"
                                    Value="{DynamicResource Window.Background}"/>
                            <Setter TargetName="Txt" Property="TextBlock.Foreground"
                                    Value="{DynamicResource Window.Background}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 三个级别只换三支笔，其余全部继承：
         加一个级别 = 加一个 4 行的派生样式，不用复制整套模板。 -->
    <Style x:Key="LogPillWarnStyle" TargetType="ToggleButton" BasedOn="{StaticResource LogPillStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Log.Warn}"/>
        <Setter Property="Background" Value="{DynamicResource Log.WarnTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Log.WarnEdge}"/>
    </Style>

    <Style x:Key="LogPillErrorStyle" TargetType="ToggleButton" BasedOn="{StaticResource LogPillStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Log.Error}"/>
        <Setter Property="Background" Value="{DynamicResource Log.ErrorTint}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Log.ErrorEdge}"/>
    </Style>

    <!-- 日志行容器：选中态用「相对于 ListBoxItem 的 IsSelected」这条
         数据绑定来驱动，而不是在代码里改 Background。

         为什么必须是 DataTrigger（而不是在模板里写 Trigger Property=IsSelected）：
         行模板挂在 ListBoxItem 的内容上，它自己没有 IsSelected 属性，
         Trigger 无处可挂；而相对于容器的 RelativeSource 绑定是**数据绑定**，
         容器被回收复用时会重新求值 —— 这正是虚拟化回收模式下
         「选中色跟着滚动条跑」的对症解法（1.0.1 的事故）。 -->
    <Style x:Key="LogRowBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Log.Background}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>



    <!-- 方形工具按钮（32×32，带边框，与 SecondaryButtonStyle 同高同圆角）。
         用于 CPU 卡片的「从 SMU 重读」—— 它要和旁边的「保存 / 加载 / 应用全部」
         并排对齐，所以必须与它们同高 32、同圆角 6、同边框色，只是收成正方形。

         【为什么不复用 IconButtonStyle】
         那个是列表行内的 28×28 透明底图标按钮（Segoe MDL2 字形），
         用来塞进 Grid 的 Auto 列。两者尺寸、底色、用途都不同，
         合并成一个会把行内按钮一起放大并加上边框。

         内边距必须为 0：内容由 Viewbox 自己居中，多余 Padding 会让图标偏下。 -->
    <!-- 方形图标按钮（32×32）。三种用法，靠 Background / BorderThickness 区分：
         · 有底有边（默认）：与普通按钮同一视觉重量，用于「这是一个动作」；
         · 透明底无边（局部覆盖 Background=Transparent / BorderThickness=0）：
           只有图标，hover 时才浮出一块浅底 —— 用于辅助动作（刷新、重读）。
         局部覆盖是安全的：模板用的是 TemplateBinding，局部值会直接被模板读到。 -->
    <Style x:Key="SquareIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Button.Neutral.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Button.Neutral.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.Neutral.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.BorderHover}"/>
                            <!-- 悬停时图标亮成强调色，给出「这个能按」的暗示 -->
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.Neutral.Pressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Txt"
                               Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               TextDecorations="Underline"
                               VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Txt" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页面级搜索框已经整体改成 zenforge:SearchBox 控件，
         模板在 Themes/SearchBox.xaml（由 App.xaml 合并）。
         这里不需要、也不应该再放搜索框的样式：
         一旦页面能覆盖它，几何又会变成两处来源。 -->

    <!-- 分隔线颜色也写死在默认模板里，同样要重写，否则会拖出一条亮灰线 -->
    <Style x:Key="DarkMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="10,0" Fill="{DynamicResource Separator}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
