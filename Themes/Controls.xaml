<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== 通用文本样式 ===================== -->
    <!-- 全局唯一标题样式：所有页面/卡片标题统一 16px，不再区分大标题与小标题 -->
    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
    </Style>

    <Style x:Key="HintTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== 设置页行式布局 =====================
         设置页的行结构高度重复（左标签、右控件），以前每行手抄一遍
         ColumnDefinitions。
         注意 Grid.ColumnDefinitions 是**只读集合属性**（没有 setter），
         不能写成 <Setter Property="ColumnDefinitions"> —— 那样 BAML 装载时
         Setter.Property 解析出来是 null，会抛 ArgumentNullException，
         而且整个 ResourceDictionary 一旦触及这个 key 就整册失效。
         所以列定义只能由各行在 XAML 里写，这里只抽 Margin。 -->

    <Style x:Key="SettingsRowStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <!-- 从属行：轻缩进 + 次要文字色，表达「这一项隶属于上面那一项」 -->
    <Style x:Key="SettingsSubRowStyle" TargetType="Grid" BasedOn="{StaticResource SettingsRowStyle}">
        <Setter Property="Margin" Value="16,10,0,0"/>
    </Style>

    <Style x:Key="SettingsSubLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource FieldLabelStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- 设置项分组分隔线：1px 实线，比行间距更「重」，用来切分语义段落 -->
    <Style x:Key="SettingsGroupSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,14,0,2"/>
        <Setter Property="Background" Value="{DynamicResource Separator}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== 卡片 ===================== -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Card.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="20,24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== 统一页头（四个页面共用） =====================
         规格：固定高度 76px，左侧「标题 + 副标题」，右侧「状态徽章」。
         固定高度是关键——之前各页头部高度不一（110 / 78 / 74），
         滚动时视觉跳动明显。这里用 Height 锁死，内容垂直居中。 -->
    <Style x:Key="PageHeaderCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
        <Setter Property="Height" Value="76"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="20,0"/>
    </Style>

    <!-- 页头主标题：页面标题或设备名 -->
    <!-- 与 CardTitleStyle 完全同规格（统一标题字号） -->
    <Style x:Key="PageHeaderTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource CardTitleStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== 状态徽章（页头右侧唯一元素） =====================
         替代原来 26px 的「就绪」大字。所有页面的状态都用这一个规格。
         高度 28px 与页头按钮（HeaderActionButtonStyle）严格一致，
         保证「有按钮的页」和「有徽章的页」右侧视觉重量相同。 -->
    <Style x:Key="StatusBadgeStyle" TargetType="Border">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{DynamicResource Badge.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="StatusBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 中性徽章：用于非强调状态（如规则数量 0） -->
    <Style x:Key="NeutralBadgeStyle" TargetType="Border" BasedOn="{StaticResource StatusBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource Badge.Background}"/>
    </Style>

    <Style x:Key="NeutralBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextStyle}">
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
    </Style>

    <!-- 卡片内标题下方的说明文字：统一 12px + 距标题 4px -->
    <Style x:Key="CardHintStyle" TargetType="TextBlock" BasedOn="{StaticResource HintTextStyle}">
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <!-- ===================== 导航按钮（药丸形，横向） ===================== -->
    <!-- 0.10.0 起主导航改为竖排侧栏项（SideNavItemStyle），这个横排胶囊
         只剩极少数场景可能复用；保留定义以免外部引用断链。 -->
    <Style x:Key="NavButtonStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 干掉点击后那圈丑陋的虚线焦点框（截图中的“设置”按钮） -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="17"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <!-- 按压反馈。放在 IsChecked 之后：已选中项按下时短暂显示偏暗的强调色，
                             抬手自动恢复 AccentBrush，不会破坏选中态。 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 侧栏导航项（竖排） =====================
         0.10.0 新的主导航形态：左侧 3×14 强调色竖条 + 淡底 + 600 字重，
         不再整块填充强调色（那会让侧栏变成一条彩色条，抢走内容区的注意力）。

         竖条与文字都用 Grid 列定位，不靠 Padding 位移：
         用 Padding 改内缩会在选中/取消瞬间产生 1px 抖动。 -->
    <Style x:Key="SideNavItemStyle" TargetType="ToggleButton">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <!-- MouseLeftButtonUp 不能在 ResourceDictionary 里挂实例处理器
             （没有 x:Class，MC6024）。真正拦截在 MainWindow 的类处理器里，
             见 MainWindow.xaml.cs 的 NavItem_MouseLeftButtonUp / AddHandler。
             这里只负责视觉。 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- 圆角只留右侧（0,6,6,0）：NavPanel 左边距已归零，
                         选中背景块的左缘紧贴侧栏边界。若仍用四角 6px 圆角，
                         左侧会出现两个「被边界切掉的圆角缺口」，看起来像
                         一块被裁坏的矩形。右侧圆角保留，与内容区方向呼应。 -->
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="0,6,6,0"
                            SnapsToDevicePixels="True">
                        <!-- 【指示条贴边】
                             竖条必须落在侧栏的最左边缘（x = 0），不能有任何左边距。
                             历史问题有两层内缩叠加：NavPanel 的 Margin 左 12px
                             ＋ 模板里 Bar 的 Margin 左 6px = 距边 18px，看起来像
                             「一条浮在文字左边的装饰线」，而不是「贴着边界的选中标记」。

                             现在：
                               · 0 列宽 3、Bar 零边距 → 竖条左缘正好压在外框内侧；
                               · 文字的起始位置由 Txt 的 Margin 单独控制（15px），
                                 选中与否都不变 —— 原来是选中时文字右移 8px 给竖条让位，
                                 那才是「挤占左边距」的观感来源。
                               · Bar 用 VerticalAlignment=Stretch 并留纵向 Margin，
                                 得到一条比文字稍短的圆头竖条，而不是顶满整行。 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 选中竖条：始终占位（避免选中/取消时文字横向抖动），
                                 只切可见性 -->
                            <Rectangle x:Name="Bar"
                                       Grid.Column="0"
                                       Width="3" Height="14"
                                       RadiusX="1.5" RadiusY="1.5"
                                       Margin="0"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"
                                       Fill="{DynamicResource AccentBrush}"
                                       Visibility="Collapsed"/>

                            <ContentPresenter x:Name="Txt"
                                              Grid.Column="1"
                                              Margin="15,0,10,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Active}"/>
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                            <!-- 不再改 Txt 的 Margin。原来选中时文字右移 8px，
                                 视觉上像整行被「推」了一下，而且让竖条看起来是
                                 文字的一部分。现在文字位置恒定，竖条独立贴在左边缘。 -->
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 侧栏分组标题：「系统」这类不可点的语义分隔 -->
    <Style x:Key="NavGroupTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
        <Setter Property="Margin" Value="16,16,4,6"/>
    </Style>

    <!-- ===================== 页面标题 =====================
         每页唯一的大字。层级靠字号 + 字重，颜色一律纯白。 -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PageSubStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <!-- ===================== 按钮 ===================== -->
    <!-- 通用按钮样式：全站唯一的按钮外观（中性单色，不分主次） -->
    <!-- ===================== 按钮 =====================
         【全局尺寸基准，勿在页面里覆盖】
         此前各页各写一套：Height 有 32 / 34 / 36 三种，MinWidth 有 104 / 116 / 120 / 140 四种，
         同一屏里并排就显得高低宽窄不齐。现在统一到下面三个数字，
         页面里 **不要再写 Height / MinWidth / Padding**，只由样式决定。

           · 高度    36px（与输入框、下拉框同高，并排时严格对齐）
           · 最小宽  156px（能装下「管理自定义掩码」这类七字文案）
           · 间距    10px（页面里用 Margin="0,0,10,0"）

         例外：弹窗 / 对话框里的按钮由容器 Grid 均分宽度，写 Width="Auto" +
         HorizontalAlignment="Stretch" 即可，不要写死 Height。
    -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <!-- 0.10.0 按 v12：高 32 / 水平内缩 16 / 不再强制 156 最小宽。
             156 是为「管理自定义掩码」这种七字文案定的，代价是所有短按钮
             （保存/加载/刷新/应用）都跟着变宽，并排时把 CPU 名挤出视野。 -->
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Button.Neutral.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Button.Neutral.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <!-- 全局禁用焦点虚线框 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：背景必须变化。原先只改 1px 边框色（#3F3F46→#5C5C63），
                             在深色背景上肉眼几乎无法分辨，按钮看起来“没有反应”。
                             这里改为背景跳到 Button.Neutral.Hover，边框同步提亮。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.Neutral.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.BorderHover}"/>
                        </Trigger>
                        <!-- 按压：原先完全没有该状态，按下与悬停长得一模一样。
                             用 Button.Neutral.Pressed 给出明确的“压下去”反馈。 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.Neutral.Pressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页头右侧按钮：高 28px，与 24px 徽章保持相近的视觉重量。
         日志页的「打开日志目录」用它——原来 32px 比徽章高出一截，页头看起来不齐。 -->
    <Style x:Key="HeaderActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===================== 窗口控制按钮 =====================
         0.10.0 起窗口按钮挪进侧栏底部，尺寸从 46×32 收成 28×28 圆角 4，
         与侧栏导航项同一套圆角语言。 -->
    <Style x:Key="WindowButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="1,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Active}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter Property="Foreground" Value="{DynamicResource CloseButton.Foreground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButton.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 行内图标按钮 =====================
         列表行里的编辑 / 删除操作用。整套界面此前没有这个形态：
         窗口控制按钮是 46×32 太大，普通按钮 MinWidth 156 更放不进列表行。
         这里取 28×28 并清掉 MinWidth，让它能塞进 Grid 的 Auto 列。
         内容是 Segoe MDL2 字形（与 MainWindow 的窗口按钮同一套字体），
         不引位图资源。 -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Active}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 删除专用：悬停时转红，与窗口关闭按钮同一套危险色语言。 -->
    <Style x:Key="IconDeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButton.Pressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 文本框 / 下拉框的深色样式已统一上移到 App.xaml（Application.Resources 优先级更高，
         可避免同一类型在两个字典里各有一份隐式样式而互相覆盖导致白底）。 -->

    <!-- ===================== 开关（Win11 风格） ===================== -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <!-- v12：轨道 36×20、滑块 16、内缩 2、圆角 10（= 高度除二） -->
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track"
                            Background="{DynamicResource Toggle.Off}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                        <!-- 原先 Fill="White" 写死：浅色主题下轨道为 #C8C8CC，
                             白色滑块几乎不可见，整个开关看起来是空的。
                             改为资源色 + 描边（深色版描边为 Transparent，视觉不变）。 -->
                        <Ellipse x:Name="Thumb"
                                 Width="16" Height="16"
                                 Fill="{DynamicResource Toggle.Thumb}"
                                 Stroke="{DynamicResource Toggle.ThumbBorder}"
                                 StrokeThickness="1"
                                 HorizontalAlignment="Left"
                                 Margin="2,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 滑块 ===================== -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Toggle.Off}"/>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="{DynamicResource AccentBrush}"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Opacity="0" Focusable="False" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Opacity="0" Focusable="False" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 色相滑杆（设置页强调色） =====================
         v12 的色相条是一条 6px 高的彩虹渐变，亮度固定 70%，
         渐变停靠点就是 HSL 色环的六个基准色相（0/60/120/180/240/300/360）。
         轨道用 Border.Background = LinearGradientBrush 画，
         滑块是 18px 白圆 + 一圈半透明黑边（深色底上才看得见边界）。

         注意：这是「色相」专用滑杆，不要让其他地方的 Slider 继承它 ——
         所以给了 x:Key，不走隐式样式。 -->
    <Style x:Key="HueSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="24"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FF6B6B" Offset="0.000"/>
                                    <GradientStop Color="#FFE066" Offset="0.166"/>
                                    <GradientStop Color="#8BE68B" Offset="0.333"/>
                                    <GradientStop Color="#6BE6E6" Offset="0.500"/>
                                    <GradientStop Color="#6B8BFF" Offset="0.666"/>
                                    <GradientStop Color="#E66BE6" Offset="0.833"/>
                                    <GradientStop Color="#FF6B6B" Offset="1.000"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="18" Height="18" Fill="White"
                                                     Stroke="#80000000" StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Opacity="0" Focusable="False" Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Opacity="0" Focusable="False" Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 色值输入框旁的色块预览：36×36 圆角 6，底色由代码按当前色赋值 -->
    <Style x:Key="ColorPreviewStyle" TargetType="Border">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 色相选择器的外框：灰底 + 1px 边 + 24 内边距。v12 的 .color-picker-group -->
    <Style x:Key="ColorPickerGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 滚动条的深色样式已统一上移到 App.xaml 的 AppScrollBarStyle，
         此处不再重复定义，避免同类型两份隐式样式互相顶掉。 -->

    <!-- ===================== 列表框 / 列表视图 ===================== -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter/>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 列表视图（深色；具名 + 隐式双份） =====================
         背景 #252526 / 边框 #3F3F46 / 表头 #1E1E1E / hover #333333 /
         选中 AccentBrush（默认 #38BDF8，跟随系统强调色）+ 深色字。
         注意：ListView 默认模板不渲染 Background 属性，必须重写 Template 铺底色。 -->
    <Style x:Key="DarkListViewStyle" TargetType="ListView">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background" Value="{DynamicResource List.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListView">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ScrollViewer HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="True"
                                      Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListView" BasedOn="{StaticResource DarkListViewStyle}"/>

    <Style x:Key="DarkListViewItemStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Bd"
                            Background="{DynamicResource List.Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource List.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource List.SelectedText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource DarkListViewItemStyle}"/>

    <Style x:Key="DarkGridViewColumnHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{DynamicResource List.Header}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource DarkGridViewColumnHeaderStyle}"/>

    <!-- ===================== DataGrid（深色；具名 + 隐式双份） =====================
         注意：DataGridRow 模板必须包含 PART_CellsHost（Panel）与
         PART_RowFocusRoot（FrameworkElement）两个必需部件，缺失会导致运行时异常。 -->
    <Style x:Key="DarkDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource List.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="{DynamicResource List.Background}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource List.Background}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="RowHeight" Value="32"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource DarkDataGridStyle}"/>

    <Style x:Key="DarkDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="{DynamicResource List.Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Grid x:Name="PART_RowFocusRoot">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Input.Border}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <DataGridCellsPresenter x:Name="PART_CellsHost"
                                                    VerticalAlignment="Center"
                                                    SnapsToDevicePixels="True"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource List.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource List.SelectedText}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkDataGridRowStyle}"/>

    <Style x:Key="DarkDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridCell" BasedOn="{StaticResource DarkDataGridCellStyle}"/>

    <Style x:Key="DarkDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource List.Header}"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DarkDataGridColumnHeaderStyle}"/>

    <!-- ===== 托盘右键菜单 =====
         托盘菜单是凭空弹出的，背后没有卡片，配色必须由样式自己带齐：
         底色、描边一律沿用 Card 那一套，深色 / 浅色主题自动跟上。
         MenuItem 的默认模板把颜色写死在模板里，只改 Foreground / Background
         不生效，必须整份模板重写。 -->

    <Style x:Key="DarkContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Card.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0,4"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBorder"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{DynamicResource List.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Text.Disabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 0.10.0：v12 版式所需的组合样式 ===================== -->

    <!-- 主按钮：v2 方案 —— 15% 淡底 + 强调色字 + 强调色 1px 边，悬停反转为实底。
         与旧方案（实底强调色 + 深色字）的取舍：
           · 实底强调色在页面上是最重的一块色，v12 的卡片风格里一眼就把视线
             从 CPU 名称拽到「应用全部」按钮上，喧宾夺主。
           · 淡底方案让主按钮「看得出是主按钮，但不抢戏」；悬停反转成实底，
             交互反馈反而比原来更明显（原来实底悬停只是亮度微调）。 -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- 基类的模板里 Border 没有绑 BorderBrush / BorderThickness，
                         v2 方案需要那条 1px 强调色边，所以这里必须补上 TemplateBinding，
                         否则边框永远不显示（BorderBrush 设了也白设）。 -->
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="Cp"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：反转为实底强调色 + 深色字。
                             Foreground 必须用 TargetName=Cp 改，控件级 Setter 在
                             模板触发器里改不动 ContentPresenter 已经继承到的值。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground"
                                    Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}"/>
                            <Setter TargetName="Cp" Property="TextElement.Foreground"
                                    Value="{DynamicResource AccentTextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 卡片头部：标题 + 右侧动作区，底部一条分隔线。v12 的 .card-header-with-actions -->
    <Style x:Key="CardHeaderBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Card.Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="0,0,0,16"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 卡片内的一行：左文字块、右控件，行间 24。v12 的 .row -->
    <Style x:Key="CardRowStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>

    <Style x:Key="CardRowLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style x:Key="CardRowDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 配置项：灰底圆角行，选中态套强调色描边。v12 的 .config-item / .config-item.active -->
    <Style x:Key="ConfigItemBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===================== 自绘表格（v12 进程页） =====================
         不再用 ListView + GridView：v12 的表头是「次要色小字 + 无底无边 + 行内间距」，
         GridView 的列头模板只能改外观、无法做到与数据行同样的 1.5fr/2fr 弹性配比，
         还要额外处理列宽同步。直接用 Grid + ItemsControl 更可控，
         三处（表头 / 数据行 / 空态提示）共享同一套 ColumnDefinitions。 -->

    <!-- 数据行容器：透明底，hover 铺 6% 白，选中铺 12% 强调色 + 强调色左边框 -->
    <Style x:Key="ProcessRowStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Nav.Button.Hover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 表头单元格文字：12px 次要色，左对齐 -->
    <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 行内次要文字：12px 次要色（路径 / 占用） -->
    <Style x:Key="TableCellSubStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 行内主文字：13px 主色、600 字重（进程名） -->
    <Style x:Key="TableCellMainStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- 日志级别 pill：圆角 20，10% 级别色底 + 30% 级别色边 -->
    <Style x:Key="LogPillStyle" TargetType="Border">        <Setter Property="Height" Value="26"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="CornerRadius" Value="13"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource Input.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- 文字链按钮：无底无边，hover 变强调色。用于「从 SMU 重新读取」这类次要入口 -->
    <!-- 图标按钮：32×32 方形，无文字，内容是一个 Path / Viewbox。
         用于「从 SMU 重读」这类动作 —— 原先做成页脚文字链（LinkButtonStyle），
         功能在但位置不对：用户的注意力在 CPU 卡片上，读不到页脚那条小字。
         视觉规格与 SecondaryButtonStyle 对齐（同高 32、同圆角 6、同边框色），
         只是宽度收窄到正方形，这样四个控件并排时基线完全齐平。
         内边距为 0：Path 由 Viewbox 自己居中，多余 Padding 会让图标偏下。 -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
        <Setter Property="Background" Value="{DynamicResource Button.Neutral.Background}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Button.Neutral.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.Neutral.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.BorderHover}"/>
                            <!-- 悬停时图标跟着亮成强调色，给出「这个能按」的暗示 -->
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.Neutral.Pressed}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Input.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            <Setter Property="Foreground" Value="{DynamicResource Disabled.Foreground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="Txt"
                               Text="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               FontSize="{TemplateBinding FontSize}"
                               TextDecorations="Underline"
                               VerticalAlignment="Center"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Txt" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页面级搜索框（SearchBoxStyle）已挪到 App.xaml。
         原因：它需要 BasedOn="{StaticResource AppTextBoxStyle}"，而 StaticResource
         只查「本字典 → 本字典合并的字典」，不向上查父字典。本文件是被 App.xaml
         Merge 进来的兄弟字典，看不到 App.xaml 本地资源里的键，运行期会拿到 null
         并抛 XamlParseException（编译期无警告，点日志页即闪退）。
         以后凡是 BasedOn App.xaml 里样式的样式，一律定义在 App.xaml。 -->

    <!-- 分隔线颜色也写死在默认模板里，同样要重写，否则会拖出一条亮灰线 -->
    <Style x:Key="DarkMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="10,0" Fill="{DynamicResource Separator}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
